    <https://spdx.org/rdf/3.1/terms/Software/SoftwarePurpose/other> a owl:NamedIndividual,
            ns2:SoftwarePurpose ;
        rdfs:label "other"@en ;
        rdfs:comment "The Element doesn't fit into any of the other categories."@en ;
        rdfs:isDefinedBy spdx-software: ;
