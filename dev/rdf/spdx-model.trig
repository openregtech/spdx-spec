    ns9:licenseXml a owl:DatatypeProperty ;
        rdfs:label "licenseXml"@en ;
        rdfs:comment """Identifies all the text and metadata associated with a license in the license
XML format."""@en ;
        rdfs:isDefinedBy spdx-expandedlicensing: ;
