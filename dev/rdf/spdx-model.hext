["https://spdx.org/rdf/3/terms/Core/rootElement", "http://www.w3.org/2000/01/rdf-schema#comment", "This property is used to denote the root Element(s) of a tree of elements contained in a BOM.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/RelationshipType/evaluatedOn", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "https://spdx.org/rdf/3/terms/Core/RelationshipType", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Core/RelationshipType/hasDistributionArtifact", "http://www.w3.org/2004/02/skos/core#definition", "The from Element is distributed as an artifact in each to Element (e.g. an RPM or archive file).", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Operations/exportControlSpecification", "http://www.w3.org/2000/01/rdf-schema#range", "https://spdx.org/rdf/3/terms/Core/Specification", "globalId", "", ""]
