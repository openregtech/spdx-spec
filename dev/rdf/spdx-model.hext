["https://spdx.org/rdf/3/terms/Security/VexVulnAssessmentRelationship", "http://www.w3.org/2000/01/rdf-schema#comment", "Abstract ancestor class for all VEX relationships.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/FunctionalSafety/evidenceUID", "http://www.w3.org/2000/01/rdf-schema#comment", "A evidenceUID is a unique identifier assigned to an entity, item,\nor requirement.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
