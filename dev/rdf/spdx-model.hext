["https://spdx.org/rdf/3/terms/SupplyChain/ResponsibilityType/ownership", "http://www.w3.org/2004/02/skos/core#definition", "Ownership refers to the legal right to control, manage, and benefit from an asset, resource, or responsibility. It establishes authority, accountability, and entitlements over something, whether it's property, a business, intellectual property, or responsibilities.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Software/SoftwarePurpose/filesystemImage", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "http://www.w3.org/2002/07/owl#NamedIndividual", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Core/SupportType/development", "http://www.w3.org/2004/02/skos/core#definition", "The artifact is in active development and is not considered ready for formal support from the supplier.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/FunctionalSafety/verificationPostcondition", "http://www.w3.org/2004/02/skos/core#definition", "Verification postcondition that are true immediately after a verification method has been performed", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
