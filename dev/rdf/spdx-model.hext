["https://spdx.org/rdf/3/terms/Core/RelationshipType/patchedBy", "http://www.w3.org/2000/01/rdf-schema#comment", "Every to Element is a patch for the from Element (from patchedBy to).", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Service/serverAuthenticationProtocol", "http://www.w3.org/2000/01/rdf-schema#comment", "Authentication protocol used by a server.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Software/SbomType/build", "http://www.w3.org/2000/01/rdf-schema#comment", "SBOM generated as part of the process of building the software to create a releasable artifact (e.g., executable or package) from data such as source files, dependencies, built components, build process ephemeral data, and other SBOMs.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/FunctionalSafety/Assumption", "http://www.w3.org/2000/01/rdf-schema#comment", "A distinct unit representing a constraint associated with an item's use in a system.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
