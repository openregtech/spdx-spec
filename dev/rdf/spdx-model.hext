["https://spdx.org/rdf/3/terms/Software/ContentIdentifier", "http://www.w3.org/2000/01/rdf-schema#comment", "A canonical, unique, immutable identifier.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Dataset/dataCollectionProcess", "http://www.w3.org/2004/02/skos/core#note", "A free-form text that describes how a dataset was collected.\n\nExamples include the sources from which a dataset was scrapped and\nthe interview protocol that was used for data collection.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:N2c133bca42704119bc4bc47a66358f9d", "http://www.w3.org/ns/shacl#in", "_:Nc6d5426da33e4813b2f78b430d9efcfd", "localId", "", ""]
["https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/isci", "http://www.w3.org/2000/01/rdf-schema#comment", "International Standard Collection Identifier (ISCI) is a variable-length identifier standardized by ISO 27730 <https://www.iso.org/standard/44293.html> for identifying collections held by libraries, archives, museums, and other memory institutions. It consists of two parts: the identifier for the assigning organization (an ISIL) enclosed in square brackets, followed by a local collection identifier string (e.g., [FR-751041001]Casadesus1).", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/Organization", "http://www.w3.org/2004/02/skos/core#note", "An Organization is a group of people who work together in an organized way for a shared purpose.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/ProfileIdentifierType/core", "http://www.w3.org/2000/01/rdf-schema#isDefinedBy", "https://spdx.org/rdf/3/terms/Core", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Core/ExternalRefType/nuget", "http://www.w3.org/2004/02/skos/core#definition", "A reference to a NuGet package. The package locator format is defined in the NuGet documentation <https://docs.nuget.org> and looks like package/version.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
