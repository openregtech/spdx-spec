["_:N3b3b0d646bcf4ed98032e3e4fd3eba18", "http://www.w3.org/1999/02/22-rdf-syntax-ns#first", "https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/securityOther", "globalId", "", ""]
