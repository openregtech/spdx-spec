["https://spdx.org/rdf/3/terms/SupplyChain/ManufactureAction", "http://www.w3.org/2004/02/skos/core#note", "ManufactureAction refers to an event where goods are created using materials or ingredients, typically resulting in a product that cannot be easily disassembled.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Dataset/confidentialityLevel", "http://www.w3.org/2004/02/skos/core#definition", "Confidentiality level of the data points contained in the dataset.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
