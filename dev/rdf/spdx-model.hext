["https://spdx.org/rdf/3/terms/Security/CvssSeverityType/medium", "http://www.w3.org/2000/01/rdf-schema#comment", "When a CVSS score is between 4.0 - 6.9.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
