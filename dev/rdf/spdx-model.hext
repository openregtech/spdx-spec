["https://spdx.org/rdf/3/terms/Service/serviceHostingCountry", "http://www.w3.org/2004/02/skos/core#note", "Specifies a country or territory where a software service is located.\nThis includes indirect locations (e.g., where the data may be hosted).\n\nThe string shall be in the ISO 3166-1 alpha-3 <https://www.iso.org/obp/ui/#iso:std:iso:3166:-1> three-letter format.\nSee the ISO 3166-1 alpha-3 Wikipedia page <https://en.wikipedia.org/wiki/ISO_3166-1_alpha-3> for more information.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/FunctionalSafety/verificationMethod", "http://www.w3.org/2000/01/rdf-schema#comment", "verificationMethod refers to the specific approach used for a checking an element's conformance with its requirements.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Software/SoftwarePurpose/patch", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "https://spdx.org/rdf/3/terms/Software/SoftwarePurpose", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Core/namespaceMap", "http://www.w3.org/2000/01/rdf-schema#comment", "Provides a NamespaceMap of prefixes and associated namespace partial URIs applicable to an SpdxDocument and independent of any specific serialization format or instance.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/SupportType", "http://www.w3.org/2000/01/rdf-schema#isDefinedBy", "https://spdx.org/rdf/3/terms/Core", "globalId", "", ""]
