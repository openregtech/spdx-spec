["https://spdx.org/rdf/3/terms/FunctionalSafety/evidenceCategory", "http://www.w3.org/2004/02/skos/core#definition", "evidenceCategory refers to a category of documented or observable proof.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/RelationshipCompleteness", "http://www.w3.org/2004/02/skos/core#definition", "Indicates whether a relationship is known to be complete, incomplete, or if no assertion is made with respect to relationship completeness.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/SupplyChain/StorageProcess", "http://www.w3.org/2000/01/rdf-schema#label", "StorageProcess", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/ExpandedLicensing/deprecatedVersion", "http://www.w3.org/2004/02/skos/core#note", "A deprecatedVersion, for a ListedLicense on the\nSPDX License List <https://spdx.org/licenses/>\nor a ListedLicenseException on the\nSPDX License Exceptions <https://spdx.org/licenses/exceptions-index.html>,\nspecifies which version release of the License List was the first\none in which it was marked as deprecated.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
