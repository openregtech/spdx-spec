["https://spdx.org/rdf/3/terms/Build/configSourceUri", "http://www.w3.org/2000/01/rdf-schema#range", "http://www.w3.org/2001/XMLSchema#anyURI", "globalId", "", ""]
["_:N74e57e41b8b14f03a9faf0f7e6025b7b", "http://www.w3.org/1999/02/22-rdf-syntax-ns#first", "https://spdx.org/rdf/3/terms/Software/SbomType/analyzed", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Core/PresenceType/no", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "http://www.w3.org/2002/07/owl#NamedIndividual", "globalId", "", ""]
["_:N8c22bf66bcff454eaba904f666762fb7", "http://www.w3.org/ns/shacl#not", "_:N9cd46f85a3cc4276a41e77cef81b60b8", "localId", "", ""]
["_:Ncd88d26d2a90469793d471d871e9a28c", "http://www.w3.org/1999/02/22-rdf-syntax-ns#rest", "http://www.w3.org/1999/02/22-rdf-syntax-ns#nil", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Build/configSourceDigest", "http://www.w3.org/2004/02/skos/core#note", "configSourceDigest is the checksum of the build configuration file used by a\nbuilder to execute a build, according to the buildType.\n\nThis property uses the Core model's Hash class.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/HashAlgorithm/falcon", "http://www.w3.org/2000/01/rdf-schema#comment", "FALCON <https://falcon-sign.info/falcon.pdf>", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/MeasureOfLength", "http://www.w3.org/ns/shacl#nodeKind", "http://www.w3.org/ns/shacl#BlankNodeOrIRI", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Core/UnitOfMeasure", "http://www.w3.org/2000/01/rdf-schema#comment", "UnitofMeasure specify information structures through industry standards for Units of Measure, Quantity Kinds, Dimensions and Data Types.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/ExpandedLicensing/NoAssertionLicense", "http://www.w3.org/2000/01/rdf-schema#isDefinedBy", "https://spdx.org/rdf/3/terms/ExpandedLicensing", "globalId", "", ""]
["_:N4b96741380e849c2862cf68c136d3663", "http://www.w3.org/ns/shacl#maxCount", "1", "http://www.w3.org/2001/XMLSchema#integer", "", ""]
["https://spdx.org/rdf/3/terms/AI/informationAboutApplication", "http://www.w3.org/2004/02/skos/core#note", "A free-form text description of how the AI model is used within the software.\n\nIt should include any relevant information, such as pre-processing steps,\nthird-party APIs, and other pertinent details.\n\nIt can also include:\n\n- Functionality provided by the AI model within the software application,\n  including: any specific tasks or decisions it is designed to perform;\n  any pre-processing steps that are applied to the input data before it is\n  fed into the AI model for inference, such as data cleaning, normalization,\n  or feature extraction;\n  and any third-party APIs or services that are used in conjunction with\n  the AI model, such as data sources, cloud services, or other AI models.\n- Description of any dependencies or requirements needed to run the AI model\n  within the software application, including: specific hardware,\n  software libraries, and operating systems.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Software/snippetFromFile", "http://www.w3.org/2000/01/rdf-schema#comment", "Defines the original host file that the snippet information applies to.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/RelationshipCompleteness/noAssertion", "http://www.w3.org/2004/02/skos/core#definition", "No assertion can be made about the completeness of the relationship.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/FunctionalSafety/VerificationType/inspection", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "http://www.w3.org/2002/07/owl#NamedIndividual", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Core/postOfficeBoxNumber", "http://www.w3.org/2000/01/rdf-schema#comment", "The number that identifies a PO box. A PO box is a box in a post office or other postal service location assigned to an organization where postal items may be kept.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/SimpleLicensing/customIdToUri", "http://www.w3.org/2004/02/skos/core#definition", "**DEPRECATED in SPDX 3.1.**\nUse customIdToLicense instead.\n\nMaps a LicenseRef or AdditionRef string for a Custom License or a Custom\nLicense Addition to its URI ID.\n\n**NOTE:**\nThis property is deprecated and only included for backward compatibility.\nNew documents should use customIdToLicense instead.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/RelationshipType/hasExample", "http://www.w3.org/2000/01/rdf-schema#comment", "Every to Element is an example for the from Element (from hasExample to).", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Operations/assessedElement", "http://www.w3.org/2000/01/rdf-schema#isDefinedBy", "https://spdx.org/rdf/3/terms/Operations", "globalId", "", ""]
["_:Nca59b79e9b7348b4ab39c3c031a01857", "http://www.w3.org/1999/02/22-rdf-syntax-ns#rest", "_:Na25c97aeacef4ab180aaa12897052fba", "localId", "", ""]
["https://spdx.org/rdf/3/terms/ExpandedLicensing/ConjunctiveLicenseSet", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "http://www.w3.org/2002/07/owl#Class", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Core/RelationshipType/underInvestigationFor", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "http://www.w3.org/2002/07/owl#NamedIndividual", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Core/RelationshipType/hasMetadata", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "https://spdx.org/rdf/3/terms/Core/RelationshipType", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Software/SoftwarePurpose/test", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "http://www.w3.org/2002/07/owl#NamedIndividual", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Software/SoftwarePurpose/filesystemImage", "http://www.w3.org/2004/02/skos/core#definition", "The Element is a file system image that can be written to a disk (or virtual) partition.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/RelationshipType/finetunedOn", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "https://spdx.org/rdf/3/terms/Core/RelationshipType", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/SupplyChain/plannedCurrent", "http://www.w3.org/2004/02/skos/core#definition", "This is the planned individual, business, or organization who currently manages goods, services, or assets.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Software/SoftwarePurpose/filesystemImage", "http://www.w3.org/2000/01/rdf-schema#isDefinedBy", "https://spdx.org/rdf/3/terms/Software", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Core/subject", "http://www.w3.org/2004/02/skos/core#note", "A subject is an Element an annotator has made an assertion about.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/additionalInformation", "http://www.w3.org/2004/02/skos/core#definition", "Additional relevance information.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Security/justificationType", "http://www.w3.org/2004/02/skos/core#note", "When stating that an element is not affected by a vulnerability, the\nVexNotAffectedVulnAssessmentRelationship shall include a justification from the\nmachine-readable labels catalog informing the reason the element is not impacted.\n\nimpactStatement which is a string with English prose can be used instead or as\ncomplementary to the justification label, but one of both shall be defined.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Software/SoftwarePurpose/specification", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "https://spdx.org/rdf/3/terms/Software/SoftwarePurpose", "globalId", "", ""]
["_:N1b9d6f68b22f4448a4bb3f34018b3aa6", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "http://www.w3.org/2002/07/owl#AllDisjointClasses", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Core/ExternalMap", "http://www.w3.org/2004/02/skos/core#definition", "A map of Element identifiers that are used within an SpdxDocument but defined\nexternal to that SpdxDocument.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/SupplyChain/CreateProcess", "http://www.w3.org/2000/01/rdf-schema#comment", "The CreateProcess refers to the abstract process class that can be used to represent the process of creation of a product.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/DictionaryEntry", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "http://www.w3.org/ns/shacl#NodeShape", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Core/beginIntegerRange", "http://www.w3.org/2000/01/rdf-schema#comment", "Defines the beginning of a range.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/subject", "http://www.w3.org/2004/02/skos/core#definition", "An Element an annotator has made an assertion about.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/IntegrityMethod", "http://www.w3.org/2004/02/skos/core#definition", "Provides an independently reproducible mechanism that permits verification of a specific Element.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:N3089ad2521ab476a876ca93dcf320629", "http://www.w3.org/ns/shacl#path", "https://spdx.org/rdf/3/terms/Core/relationshipType", "globalId", "", ""]
