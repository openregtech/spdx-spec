["https://spdx.org/rdf/3/terms/Hardware/productAgent", "http://www.w3.org/2004/02/skos/core#note", "The Agent is responsible for defining the partNumber, batchNumber or serialNumber of the unit of hardware.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/ExpandedLicensing/licenseXml", "http://www.w3.org/2004/02/skos/core#note", "The license XML format is defined and used by the SPDX legal team.\n\nThe formal schema definition is available at\nSPDX License List XML Schema <https://github.com/spdx/license-list-XML/blob/v3.25.0/schema/ListedLicense.xsd>.\n\nFor a text description of the XML fields, see\nXML template fields <https://github.com/spdx/license-list-XML/blob/v3.25.0/DOCS/xml-fields.md>.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Hardware/ProductSpecification", "http://www.w3.org/2004/02/skos/core#note", "A product specification (product spec) is a detailed document that outlines the technical, functional, and design requirements of a product. It serves as a guide for engineers, designers, and manufacturers to ensure the final product meets expectations.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
