["https://spdx.org/rdf/3/terms/AI/informationAboutApplication", "http://www.w3.org/2004/02/skos/core#definition", "Information about the AI software, not including the model description.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Security/severity", "http://www.w3.org/2000/01/rdf-schema#comment", "Specifies the CVSS qualitative severity rating of a vulnerability in relation to a piece of software.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
