["https://spdx.org/rdf/3/terms/Dataset/DatasetType/timestamp", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "http://www.w3.org/2002/07/owl#NamedIndividual", "globalId", "", ""]
["_:N33f9e5bf38264e778fbded63995ffecb", "http://www.w3.org/1999/02/22-rdf-syntax-ns#first", "https://spdx.org/rdf/3/terms/Core/Role", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Core/RelationshipType/trainedOn", "http://www.w3.org/2000/01/rdf-schema#label", "trainedOn", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:N3426c4571127466c9043936d0bfa27bc", "http://www.w3.org/ns/shacl#path", "https://spdx.org/rdf/3/terms/Security/withdrawnTime", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Core/ExternalRefType/releaseNotes", "http://www.w3.org/2000/01/rdf-schema#isDefinedBy", "https://spdx.org/rdf/3/terms/Core", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/FunctionalSafety/VerificationType/inspection", "http://www.w3.org/2004/02/skos/core#definition", "A thorough examination or checking of documentation, records, processes, or systems to confirm compliance or adherence. An inspection needs to have a defined set of acceptance criteria (e.g. a checklist), a documentation of roles involved in the inspection (e.g. to document the inspector's independence) and a clear documentation of when and how it was performed.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/created", "http://www.w3.org/2000/01/rdf-schema#comment", "Identifies when the Element was originally created.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Hardware/productAgent", "http://www.w3.org/2004/02/skos/core#definition", "The Agent who is responsible for product branding such as an OEM.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Build/buildEndTime", "http://www.w3.org/2004/02/skos/core#note", "**NOTE:**\nThis property is deprecated and only included for backward compatibility.\nNew documents should use\n/Core/endTime\ninstead.\n\nbuildEndTime describes the time at which a build stops or finishes.\n\nThis value is typically recorded by the builder.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Security/Vulnerability", "http://www.w3.org/2004/02/skos/core#definition", "Specifies a vulnerability and its associated information.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:N5305d4db838b47bda2e12df7bb8a4fc8", "http://www.w3.org/1999/02/22-rdf-syntax-ns#first", "https://spdx.org/rdf/3/terms/Core/RelationshipCompleteness/incomplete", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/SupplyChain/ResolutionAction", "http://www.w3.org/2004/02/skos/core#note", "Products out of specification require a resolution action. This is the action of resolution.\n\nRelationship:\nFor each ResolutionAction there is at least one /Core/Relationship class or subclass with the relationshipType of 'resolved\u2019 on the from and an OutOfSpecAction class or subclass on the to.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Software/SoftwarePurpose/device", "http://www.w3.org/2004/02/skos/core#definition", "The Element refers to a chipset, processor, or electronic board.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Dataset/DatasetType/audio", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "http://www.w3.org/2002/07/owl#NamedIndividual", "globalId", "", ""]
["_:N5689742660aa426088289820bef8e017", "http://www.w3.org/ns/shacl#path", "https://spdx.org/rdf/3/terms/Core/createdUsing", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Software/packageUrl", "http://www.w3.org/2000/01/rdf-schema#label", "packageUrl", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
