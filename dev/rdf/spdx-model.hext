["https://spdx.org/rdf/3/terms/Dataset/DatasetType/timestamp", "http://www.w3.org/2004/02/skos/core#definition", "Data is recorded with a timestamp for each entry, but not necessarily ordered or at specific intervals, such as when a taxi ride starts and ends.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Software/SoftwarePurpose/documentation", "http://www.w3.org/2000/01/rdf-schema#label", "documentation", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
