["https://spdx.org/rdf/3/terms/Build/parameter", "http://www.w3.org/2000/01/rdf-schema#comment", "Property describing a parameter used in an instance of a build.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/SupplyChain/AssemblyAction", "http://www.w3.org/2000/01/rdf-schema#comment", "AssemblyAction represents the event of creating a product by assembling individual components.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
