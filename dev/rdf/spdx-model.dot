# https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/ismn node818
node818 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>ismn</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/ismn' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/ismn</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;International Standard Music Number (ISMN) &lt;https://ismn-international.org/ismn/the-ismn/&gt; is a unique numeric identifier for printed music (notated music) standardized by ISO 10957 &lt;https://www.iso.org/standard/83122.html&gt;. It consists of either 10 characters (starting with the letter &quot;M&quot; for assignments prior to January 1, 2008) or 13 digits. A 13-digit ISMN is composed of four parts: the GS1 prefix 979-0, a registrant element, an item element, and a check digit. While elements may be divided by spaces or hyphens for human readability, these separators shall be omitted when the identifier is stored electronically (e.g., 9790006538424).&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;International Standard Music Number (ISMN) &lt;https://ismn-international.org/ismn/the-ismn/&gt; is a unique numeric identifier for printed music (notated music) standardized by ISO 10957 &lt;https://www.iso.org/standard/83122.html&gt;. It consists of either 10 characters (starting with the letter &quot;M&quot; for assignments prior to January 1, 2008) or 13 digits. A 13-digit ISMN is composed of four parts: the GS1 prefix 979-0, a registrant element, an item element, and a check digit. While elements may be divided by spaces or hyphens for human readability, these separators shall be omitted when the identifier is stored electronically (e.g., 9790006538424).&quot;@en</td></tr></table> > ] 
# https://spdx.org/rdf/3/terms/Software/ContentIdentifierType/gitoid node819
node819 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>gitoid</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Software/ContentIdentifierType/gitoid' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Software/ContentIdentifierType/gitoid</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Gitoid &lt;https://www.iana.org/assignments/uri-schemes/prov/gitoid&gt;, stands for Git Object ID &lt;https://git-scm.com/book/en/v2/Git-Internals-Git-Objects&gt;. A gitoid of type blob is a unique hash of a binary artifact. A gitoid may represent either an Artifact Identifier &lt;https://github.com/omnibor/spec/blob/eb1ee5c961c16215eb8709b2975d193a2007a35d/spec/SPEC.md#artifact-identifier-types&gt; for the software artifact or an Input Manifest Identifier &lt;https://github.com/omnibor/spec/blob/eb1ee5c961c16215eb8709b2975d193a2007a35d/spec/SPEC.md#input-manifest-identifier&gt; for the software artifact&#x27;s associated Artifact Input Manifest &lt;https://github.com/omnibor/spec/blob/eb1ee5c961c16215eb8709b2975d193a2007a35d/spec/SPEC.md#artifact-input-manifest&gt;; this ambiguity exists because the Artifact Input Manifest is itself an artifact, and the gitoid of that artifact is its valid identifier. Gitoids calculated on software artifacts (Snippet, File, or Package Elements) should be recorded in the SPDX 3 SoftwareArtifact&#x27;s contentIdentifier property. Gitoids calculated on the Artifact Input Manifest (Input Manifest Identifier) should be recorded in the SPDX 3 Element&#x27;s externalIdentifier property. See OmniBOR Specification &lt;https://github.com/omnibor/spec/&gt;, a minimalistic specification for describing software Artifact Dependency Graphs &lt;https://github.com/omnibor/spec/blob/eb1ee5c961c16215eb8709b2975d193a2007a35d/spec/SPEC.md#artifact-dependency-graph-adg&gt;.&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;Gitoid &lt;https://www.iana.org/assignments/uri-schemes/prov/gitoid&gt;, stands for Git Object ID &lt;https://git-scm.com/book/en/v2/Git-Internals-Git-Objects&gt;. A gitoid of type blob is a unique hash of a binary artifact. A gitoid may represent either an Artifact Identifier &lt;https://github.com/omnibor/spec/blob/eb1ee5c961c16215eb8709b2975d193a2007a35d/spec/SPEC.md#artifact-identifier-types&gt; for the software artifact or an Input Manifest Identifier &lt;https://github.com/omnibor/spec/blob/eb1ee5c961c16215eb8709b2975d193a2007a35d/spec/SPEC.md#input-manifest-identifier&gt; for the software artifact&#x27;s associated Artifact Input Manifest &lt;https://github.com/omnibor/spec/blob/eb1ee5c961c16215eb8709b2975d193a2007a35d/spec/SPEC.md#artifact-input-manifest&gt;; this ambiguity exists because the Artifact Input Manifest is itself an artifact, and the gitoid of that artifact is its valid identifier. Gitoids calculated on software artifacts (Snippet, File, or Package Elements) should be recorded in the SPDX 3 SoftwareArtifact&#x27;s contentIdentifier property. Gitoids calculated on the Artifact Input Manifest (Input Manifest Identifier) should be recorded in the SPDX 3 Element&#x27;s externalIdentifier property. See OmniBOR Specification &lt;https://github.com/omnibor/spec/&gt;, a minimalistic specification for describing software Artifact Dependency Graphs &lt;https://github.com/omnibor/spec/blob/eb1ee5c961c16215eb8709b2975d193a2007a35d/spec/SPEC.md#artifact-dependency-graph-adg&gt;.&quot;@en</td></tr></table> > ] 
