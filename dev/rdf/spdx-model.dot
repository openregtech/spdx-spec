# https://spdx.org/rdf/3/terms/Build/configSourceUri node1456
node1456 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>configSourceUri</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Build/configSourceUri' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Build/configSourceUri</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Property that describes the URI of the build configuration source file.&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;Property that describes the URI of the build configuration source file.&quot;@en</td></tr><tr><td align='left'>skos:note</td><td align='left'>&quot;If a build configuration exists for the toolchain or platform performing the
build, the configSourceUri of a build is the URI of that build configuration,
according to the buildType.

For example, a build triggered by a GitHub Action is defined by a build
configuration YAML file. In this case, the configSourceUri is the URL of that
YAML file.&quot;@en</td></tr></table> > ] 
# https://spdx.org/rdf/3/terms/Software/ContentIdentifierType/swhid node1457
node1457 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>swhid</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Software/ContentIdentifierType/swhid' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Software/ContentIdentifierType/swhid</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;SoftWare Hash IDentifier, a persistent intrinsic identifier for digital artifacts, such as files, trees (also known as directories or folders), commits, and other objects typically found in version control systems. The format of the identifiers is defined in the SWHID specification &lt;https://www.swhid.org/swhid-specification/v1.2/&gt; (ISO/IEC 18670 &lt;https://www.iso.org/standard/89985.html&gt;). They typically look like swh:1:cnt:94a9ed024d3859793618152ea559a168bbcbb5e2.&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;SoftWare Hash IDentifier, a persistent intrinsic identifier for digital artifacts, such as files, trees (also known as directories or folders), commits, and other objects typically found in version control systems. The format of the identifiers is defined in the SWHID specification &lt;https://www.swhid.org/swhid-specification/v1.2/&gt; (ISO/IEC 18670 &lt;https://www.iso.org/standard/89985.html&gt;). They typically look like swh:1:cnt:94a9ed024d3859793618152ea559a168bbcbb5e2.&quot;@en</td></tr></table> > ] 
