# https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/nli node1152
node1152 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>nli</B></td></tr><tr><td href='https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/nli' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/nli</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Natural Location Identifier (NLI) &lt;https://eccma.org/enli-eccma-natural-location-identifier/&gt; is a 14- or 15-character alphanumeric string standardized by ISO 8000-118 &lt;https://www.iso.org/standard/85428.html&gt; that uniquely identifies a three-dimensional geographic point location. The identifier is generated from geodetic coordinates and elevation data. For electronic storage, the ISO.NLI: prefix shall be retained (e.g., ISO.NLI:41TS8M-A8ELTQ-H2).&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;Natural Location Identifier (NLI) &lt;https://eccma.org/enli-eccma-natural-location-identifier/&gt; is a 14- or 15-character alphanumeric string standardized by ISO 8000-118 &lt;https://www.iso.org/standard/85428.html&gt; that uniquely identifies a three-dimensional geographic point location. The identifier is generated from geodetic coordinates and elevation data. For electronic storage, the ISO.NLI: prefix shall be retained (e.g., ISO.NLI:41TS8M-A8ELTQ-H2).&quot;@en</td></tr></table> > ] 
