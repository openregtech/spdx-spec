  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Core/postalName">
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/Core"/>
    <rdfs:label xml:lang="en">postalName</rdfs:label>
    <rdfs:comment xml:lang="en">The name of the recipient expressed in text.</rdfs:comment>
    <skos:definition xml:lang="en">The name of the recipient expressed in text.</skos:definition>
    <skos:note xml:lang="en">A postal name refers to the official name of a city, town, or locality as recognized by a postal system for mail delivery purposes. It ensures accurate addressing and routing of mail.</skos:note>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3.1/terms/Core/creationInfo">
