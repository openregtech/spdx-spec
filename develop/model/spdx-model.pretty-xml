    <skos:definition xml:lang="en"><![CDATA[SHA-2 with a digest length of 256, as defined in RFC 6234 <https://datatracker.ietf.org/doc/rfc6234/>.]]></skos:definition>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/RelationshipType/hasOptionalComponent">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/RelationshipType"/>
