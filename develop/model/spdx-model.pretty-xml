    <skos:definition xml:lang="en">When a CVSS score is between 4.0 - 6.9.</skos:definition>
  </owl:NamedIndividual>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Software/packageVersion">
