    <skos:definition xml:lang="en">The Element is a bill of materials.</skos:definition>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/RelationshipType/locatedAt">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/RelationshipType"/>
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/Core"/>
    <rdfs:label xml:lang="en">locatedAt</rdfs:label>
    <rdfs:comment xml:lang="en">from Element located at a specific to Location. A time period is optional.</rdfs:comment>
    <skos:definition xml:lang="en">from Element located at a specific to Location. A time period is optional.</skos:definition>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/HashAlgorithm/md4">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/HashAlgorithm"/>
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/Core"/>
    <rdfs:label xml:lang="en">md4</rdfs:label>
    <rdfs:comment xml:lang="en"><![CDATA[MD4 message-digest algorithm, as defined in RFC 1186 <https://datatracker.ietf.org/doc/rfc1186/>.]]></rdfs:comment>
    <skos:definition xml:lang="en"><![CDATA[MD4 message-digest algorithm, as defined in RFC 1186 <https://datatracker.ietf.org/doc/rfc1186/>.]]></skos:definition>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/ExternalRefType/cwe">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/ExternalRefType"/>
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/Core"/>
    <rdfs:label xml:lang="en">cwe</rdfs:label>
    <rdfs:comment xml:lang="en"><![CDATA[Common Weakness Enumeration <https://csrc.nist.gov/glossary/term/common_weakness_enumeration>. A reference to a source of software flaw defined within the official CWE List <https://cwe.mitre.org/data/> that conforms to the CWE specification <https://cwe.mitre.org/>.]]></rdfs:comment>
    <skos:definition xml:lang="en"><![CDATA[Common Weakness Enumeration <https://csrc.nist.gov/glossary/term/common_weakness_enumeration>. A reference to a source of software flaw defined within the official CWE List <https://cwe.mitre.org/data/> that conforms to the CWE specification <https://cwe.mitre.org/>.]]></skos:definition>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/ExternalRefType/purchaseOrder">
