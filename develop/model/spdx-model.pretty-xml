    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/Core/Location"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://spdx.org/rdf/3.1/terms/Software/Snippet">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/Software"/>
    <rdfs:label xml:lang="en">Snippet</rdfs:label>
    <rdfs:comment xml:lang="en">Describes a certain part of a file.</rdfs:comment>
    <skos:definition xml:lang="en">Describes a certain part of a file.</skos:definition>
    <skos:note xml:lang="en">A Snippet describes a certain part of a file and can be used when the file is
known to have some content that has been included from another original source.

Snippets are useful for denoting when part of a file may have been originally
created under another license or copied from a place with a known
vulnerability.</skos:note>
    <rdfs:subClassOf rdf:resource="https://spdx.org/rdf/3.1/terms/Software/SoftwareArtifact"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
    <sh:property>
      <rdf:Description rdf:nodeID="N0388a73fd0b04a2d94336e13a07a8459">
        <sh:path rdf:resource="https://spdx.org/rdf/3.1/terms/Software/byteRange"/>
