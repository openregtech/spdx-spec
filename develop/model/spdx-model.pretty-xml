    <skos:definition xml:lang="en"><![CDATA[Uniform Resource Identifier (URI) Schemes <https://www.iana.org/assignments/uri-schemes/uri-schemes.xhtml>. The scheme used in order to locate a resource.]]></skos:definition>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/RelationshipType/hasDynamicLink">
