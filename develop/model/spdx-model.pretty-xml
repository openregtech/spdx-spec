  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/gln">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType"/>
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/Core"/>
    <rdfs:label xml:lang="en">gln</rdfs:label>
    <rdfs:comment xml:lang="en"><![CDATA[Global Location Number (GLN) <https://www.gs1.org/standards/id-keys/gln> is a 13-digit number, assigned by GS1, that uniquely identifies a legal entity (e.g., a company or customer), a function within a legal entity, a physical location (e.g., a warehouse or a specific shelf in a store), or a digital location (e.g., an Electronic Data Interchange (EDI) gateway).]]></rdfs:comment>
    <skos:definition xml:lang="en"><![CDATA[Global Location Number (GLN) <https://www.gs1.org/standards/id-keys/gln> is a 13-digit number, assigned by GS1, that uniquely identifies a legal entity (e.g., a company or customer), a function within a legal entity, a physical location (e.g., a warehouse or a specific shelf in a store), or a digital location (e.g., an Electronic Data Interchange (EDI) gateway).]]></skos:definition>
  </owl:NamedIndividual>
  <owl:Class rdf:about="https://spdx.org/rdf/3.1/terms/SimpleLicensing/SimpleLicensingText">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdfs:isDefinedBy>
      <rdf:Description rdf:about="https://spdx.org/rdf/3.1/terms/SimpleLicensing">
        <vann:preferredNamespacePrefix>spdx-simplelicensing</vann:preferredNamespacePrefix>
