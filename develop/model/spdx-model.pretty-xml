  </owl:NamedIndividual>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Software/contentIdentifier">
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/Software"/>
    <rdfs:label xml:lang="en">contentIdentifier</rdfs:label>
    <rdfs:comment xml:lang="en">A canonical, unique, immutable identifier of the artifact content, that may be
used for verifying its identity and/or integrity.</rdfs:comment>
    <skos:definition xml:lang="en">A canonical, unique, immutable identifier of the artifact content, that may be
used for verifying its identity and/or integrity.</skos:definition>
    <skos:note xml:lang="en">A contentIdentifier is a canonical, unique, immutable identifier of the content
of a software artifact, such as a package, a file, or a snippet.

It may be used for verifying its identity and/or integrity.</skos:note>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/Software/ContentIdentifier"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/AI/domain">
