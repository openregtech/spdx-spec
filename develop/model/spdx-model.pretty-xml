    <skos:definition xml:lang="en">This property is used to denote the root Element(s) of a tree of elements contained in a BOM.</skos:definition>
    <skos:note xml:lang="en">This property is used to denote the root Element(s) of a tree of elements contained in a BOM.
The tree consists of other elements directly and indirectly related through properties or Relationships from the root.</skos:note>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/Core/Element"/>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Dataset/DatasetType/categorical">
