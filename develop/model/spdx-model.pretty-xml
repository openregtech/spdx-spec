    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/AI/modelDataPreprocessing">
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/AI"/>
    <rdfs:label xml:lang="en">modelDataPreprocessing</rdfs:label>
    <rdfs:comment xml:lang="en">Preprocessing steps applied to the training data before the model training.</rdfs:comment>
    <skos:definition xml:lang="en">Preprocessing steps applied to the training data before the model training.</skos:definition>
    <skos:note xml:lang="en">A free-form text that describes the preprocessing steps applied to the training
data before training of the model(s) contained in the AI software.</skos:note>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Core/description">
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/Core"/>
    <rdfs:label xml:lang="en">description</rdfs:label>
    <rdfs:comment xml:lang="en">Provides a detailed description of the Element.</rdfs:comment>
    <skos:definition xml:lang="en">Provides a detailed description of the Element.</skos:definition>
    <skos:note xml:lang="en">This field is a detailed description of the Element. It may also be extracted
from the Element itself.

The intent is to provide recipients of the SPDX file with a detailed technical
explanation of the functionality, anticipated use, and anticipated
implementation of the Element.

This field may also include a description of improvements over prior versions
of the Element.</skos:note>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
