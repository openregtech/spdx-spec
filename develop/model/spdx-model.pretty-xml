  <owl:Class rdf:about="https://spdx.org/rdf/3.1/terms/Hardware/ProductSpecification">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/Hardware"/>
    <rdfs:label xml:lang="en">ProductSpecification</rdfs:label>
    <rdfs:comment xml:lang="en">A product specification (product spec) is a detailed document that outlines the technical, functional, and design requirements of a product.</rdfs:comment>
    <skos:definition xml:lang="en">A product specification (product spec) is a detailed document that outlines the technical, functional, and design requirements of a product.</skos:definition>
    <skos:note xml:lang="en">A product specification (product spec) is a detailed document that outlines the technical, functional, and design requirements of a product. It serves as a guide for engineers, designers, and manufacturers to ensure the final product meets expectations.</skos:note>
    <rdfs:subClassOf rdf:resource="https://spdx.org/rdf/3.1/terms/Core/Specification"/>
