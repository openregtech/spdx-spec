  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/ExpandedLicensing/deprecatedVersion">
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/ExpandedLicensing"/>
    <rdfs:label xml:lang="en">deprecatedVersion</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies the SPDX License List version in which this license or exception
identifier was deprecated.</rdfs:comment>
    <skos:definition xml:lang="en">Specifies the SPDX License List version in which this license or exception
identifier was deprecated.</skos:definition>
    <skos:note xml:lang="en"><![CDATA[A deprecatedVersion, for a ListedLicense on the
SPDX License List <https://spdx.org/licenses/>
or a ListedLicenseException on the
SPDX License Exceptions <https://spdx.org/licenses/exceptions-index.html>,
specifies which version release of the License List was the first
one in which it was marked as deprecated.]]></skos:note>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Security/probability">
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/Security"/>
    <rdfs:label xml:lang="en">probability</rdfs:label>
    <rdfs:comment xml:lang="en">A probability score between 0 and 1 of a vulnerability being exploited.</rdfs:comment>
    <skos:definition xml:lang="en">A probability score between 0 and 1 of a vulnerability being exploited.</skos:definition>
    <skos:note xml:lang="en"><![CDATA[The probability score between 0 and 1 (0 and 100%) estimating the likelihood of
exploitation in the wild in the next 30 days (following score publication).
The definition follows "epss" in
EPSS Data <https://www.first.org/epss/data_stats>.]]></skos:note>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
