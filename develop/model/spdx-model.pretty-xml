    <rdfs:label xml:lang="en">namespaceMap</rdfs:label>
    <rdfs:comment xml:lang="en">Provides a NamespaceMap of prefixes and associated namespace partial URIs applicable to an SpdxDocument and independent of any specific serialization format or instance.</rdfs:comment>
    <skos:definition xml:lang="en">Provides a NamespaceMap of prefixes and associated namespace partial URIs applicable to an SpdxDocument and independent of any specific serialization format or instance.</skos:definition>
    <skos:note xml:lang="en">This field provides a NamespaceMap of prefixes and associated namespace partial URIs applicable to an SpdxDocument and independent of any specific serialization format or instance.</skos:note>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/Core/NamespaceMap"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3.1/terms/ExpandedLicensing/subjectAddition">
