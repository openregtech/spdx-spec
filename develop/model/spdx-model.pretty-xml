  <owl:Ontology rdf:about="https://spdx.org/rdf/3.1/terms/">
    <vann:preferredNamespacePrefix>spdx</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>https://spdx.org/rdf/3.1/terms/</vann:preferredNamespaceUri>
    <rdfs:label xml:lang="en">System Package Data Exchange™ (SPDX®) Ontology</rdfs:label>
    <dcterms:abstract xml:lang="en">This ontology defines the terms and relationships used in the SPDX specification to describe system packages</dcterms:abstract>
