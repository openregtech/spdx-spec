  <owl:Class rdf:about="https://spdx.org/rdf/3.1/terms/Security/ExploitCatalogVulnAssessmentRelationship">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/Security"/>
    <rdfs:label xml:lang="en">ExploitCatalogVulnAssessmentRelationship</rdfs:label>
    <rdfs:comment xml:lang="en">Provides an exploit assessment of a vulnerability.</rdfs:comment>
    <skos:definition xml:lang="en">Provides an exploit assessment of a vulnerability.</skos:definition>
    <skos:note xml:lang="en"><![CDATA[An ExploitCatalogVulnAssessmentRelationship describes if a vulnerability is
listed in any exploit catalog such as the
CISA Known Exploited Vulnerabilities (KEV) Catalog <https://www.cisa.gov/known-exploited-vulnerabilities-catalog>.

*Constraints*

- The relationship type shall be set to hasAssessmentFor.

*Example*

{
  "type": "security_ExploitCatalogVulnAssessmentRelationship",
  "spdxId": "urn:spdx.dev:exploit-catalog-1",
  "relationshipType": "hasAssessmentFor",
  "security_catalogType": "kev",
  "locator": "https://www.cisa.gov/known-exploited-vulnerabilities-catalog",
  "security_exploited": "true",
  "from": "urn:spdx.dev:vuln-cve-2023-2136",
  "to": ["urn:product-google-chrome-112.0.5615.136"],
  "suppliedBy": "urn:spdx.dev:agent-jane-doe",
  "security_publishedTime": "2021-03-09T11:04:53Z"
}]]></skos:note>
    <rdfs:subClassOf rdf:resource="https://spdx.org/rdf/3.1/terms/Security/VulnAssessmentRelationship"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
    <sh:property>
      <rdf:Description rdf:nodeID="Nc8c079951bd24f2183b83d8f68441e24">
        <sh:path rdf:resource="https://spdx.org/rdf/3.1/terms/Security/catalogType"/>
        <sh:in rdf:parseType="Collection">
          <rdf:Description rdf:about="https://spdx.org/rdf/3.1/terms/Security/ExploitCatalogType/kev"/>
          <rdf:Description rdf:about="https://spdx.org/rdf/3.1/terms/Security/ExploitCatalogType/other"/>
        </sh:in>
        <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
      </rdf:Description>
    </sh:property>
    <sh:property>
      <rdf:Description rdf:nodeID="Nb6b75ef5a2eb48cfb502cc58b62dcfc9">
        <sh:path rdf:resource="https://spdx.org/rdf/3.1/terms/Security/exploited"/>
        <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
      </rdf:Description>
    </sh:property>
    <sh:property>
      <rdf:Description rdf:nodeID="Nd76853913c3343c68decf622cf5289cd">
        <sh:path rdf:resource="https://spdx.org/rdf/3.1/terms/Security/locator"/>
        <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
      </rdf:Description>
    </sh:property>
  </owl:Class>
