  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Core/created">
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/Core"/>
    <rdfs:label xml:lang="en">created</rdfs:label>
    <rdfs:comment xml:lang="en">Identifies when the Element was originally created.</rdfs:comment>
    <skos:definition xml:lang="en">Identifies when the Element was originally created.</skos:definition>
    <skos:note xml:lang="en">Created is a date that identifies when the Element was originally created.

The time stamp can serve as an indication as to whether the analysis needs to
be updated.

This is often the date of last change (e.g., a git commit date), not the date
when the SPDX data was created, as doing so supports reproducible builds.</skos:note>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Core/hashValue">
