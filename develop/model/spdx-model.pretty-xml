    <rdfs:label xml:lang="en">locator</rdfs:label>
    <rdfs:comment xml:lang="en">Provides the location of an exploit catalog.</rdfs:comment>
    <skos:definition xml:lang="en">Provides the location of an exploit catalog.</skos:definition>
