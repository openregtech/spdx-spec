  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/FunctionalSafety/VerificationType/inspection">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/FunctionalSafety/VerificationType"/>
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/FunctionalSafety"/>
    <rdfs:label xml:lang="en">inspection</rdfs:label>
    <rdfs:comment xml:lang="en">A thorough examination or checking of documentation, records, processes, or systems to confirm compliance or adherence. An inspection needs to have a defined set of acceptance criteria (e.g. a checklist), a documentation of roles involved in the inspection (e.g. to document the inspector's independence) and a clear documentation of when and how it was performed.</rdfs:comment>
    <skos:definition xml:lang="en">A thorough examination or checking of documentation, records, processes, or systems to confirm compliance or adherence. An inspection needs to have a defined set of acceptance criteria (e.g. a checklist), a documentation of roles involved in the inspection (e.g. to document the inspector's independence) and a clear documentation of when and how it was performed.</skos:definition>
  </owl:NamedIndividual>
