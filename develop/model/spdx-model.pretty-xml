          <rdf:Description rdf:about="https://spdx.org/rdf/3.1/terms/Core/ProfileIdentifierType/dataset"/>
          <rdf:Description rdf:about="https://spdx.org/rdf/3.1/terms/Core/ProfileIdentifierType/extension"/>
