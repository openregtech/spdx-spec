  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Dataset/DatasetType/timeseries">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Dataset/DatasetType"/>
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/Dataset"/>
    <rdfs:label xml:lang="en">timeseries</rdfs:label>
    <rdfs:comment xml:lang="en">Data is recorded in an ordered sequence of timestamped entries, such as the price of a stock over the course of a day.</rdfs:comment>
    <skos:definition xml:lang="en">Data is recorded in an ordered sequence of timestamped entries, such as the price of a stock over the course of a day.</skos:definition>
  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3.1/terms/Hardware/yAxisLength">
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/Hardware"/>
    <rdfs:label xml:lang="en">yAxisLength</rdfs:label>
    <rdfs:comment xml:lang="en">Information related to hardware dimension.</rdfs:comment>
    <skos:definition xml:lang="en">Information related to hardware dimension.</skos:definition>
    <skos:note xml:lang="en">Information related to yAxis measurement of an object.</skos:note>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/Core/MeasureOfLength"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3.1/terms/Core/contactType">
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/Core"/>
    <rdfs:label xml:lang="en">contactType</rdfs:label>
    <rdfs:comment xml:lang="en">Identifies the nature of the contactPointRelationship.</rdfs:comment>
