    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/FunctionalSafety"/>
    <rdfs:label xml:lang="en">analysis</rdfs:label>
    <rdfs:comment xml:lang="en">Analytical evaluating of data, designs, or processes methodically to verify correctness against standards or expectations. Typical analysis methods are FMEA, FTA, STPA, static analysis for MISRA compliance etc.</rdfs:comment>
    <skos:definition xml:lang="en">Analytical evaluating of data, designs, or processes methodically to verify correctness against standards or expectations. Typical analysis methods are FMEA, FTA, STPA, static analysis for MISRA compliance etc.</skos:definition>
  </owl:NamedIndividual>
