  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3.1/terms/Hardware/bulkQuantity">
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/Hardware"/>
    <rdfs:label xml:lang="en">bulkQuantity</rdfs:label>
    <rdfs:comment xml:lang="en">The amount or measure of a bulk product.</rdfs:comment>
    <skos:definition xml:lang="en">The amount or measure of a bulk product.</skos:definition>
    <skos:note xml:lang="en">The amount or measure of a bulk product includes the quality and unit of measure.</skos:note>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/Core/UnitOfMeasure"/>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/orcidid">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType"/>
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/Core"/>
    <rdfs:label xml:lang="en">orcidid</rdfs:label>
    <rdfs:comment xml:lang="en"><![CDATA[Open Researcher and Contributor ID (ORCID) iD <https://info.orcid.org/what-is-orcid/> is a unique identifier for authors and contributors in scholarly communication; as a subset of the International Standard Name Identifier (ISNI), it typically appears as a URI such as https://orcid.org/0000-0002-1825-0097.]]></rdfs:comment>
    <skos:definition xml:lang="en"><![CDATA[Open Researcher and Contributor ID (ORCID) iD <https://info.orcid.org/what-is-orcid/> is a unique identifier for authors and contributors in scholarly communication; as a subset of the International Standard Name Identifier (ISNI), it typically appears as a URI such as https://orcid.org/0000-0002-1825-0097.]]></skos:definition>
  </owl:NamedIndividual>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Dataset/dataCollectionProcess">
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/Dataset"/>
    <rdfs:label xml:lang="en">dataCollectionProcess</rdfs:label>
    <rdfs:comment xml:lang="en">How the dataset was collected.</rdfs:comment>
    <skos:definition xml:lang="en">How the dataset was collected.</skos:definition>
    <skos:note xml:lang="en">A free-form text that describes how a dataset was collected.

Examples include the sources from which a dataset was scrapped and
the interview protocol that was used for data collection.</skos:note>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/ExpandedLicensing/additionText">
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/ExpandedLicensing"/>
    <rdfs:label xml:lang="en">additionText</rdfs:label>
    <rdfs:comment xml:lang="en">Identifies the full text of a LicenseAddition.</rdfs:comment>
    <skos:definition xml:lang="en">Identifies the full text of a LicenseAddition.</skos:definition>
    <skos:note xml:lang="en">An additionText contains the plain text of the LicenseAddition, without
templating or other similar markup.

Users of the additionText for a License can apply the
SPDX License List Matching Guidelines
when comparing it to another text for matching purposes.</skos:note>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/ProfileIdentifierType/expandedLicensing">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/ProfileIdentifierType"/>
