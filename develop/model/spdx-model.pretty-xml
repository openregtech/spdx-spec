          <rdf:Description rdf:about="https://spdx.org/rdf/3.1/terms/Core/ContactPointRelationshipType/securityVulnerability"/>
          <rdf:Description rdf:about="https://spdx.org/rdf/3.1/terms/Core/ContactPointRelationshipType/support"/>
