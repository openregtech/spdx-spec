  <owl:Class rdf:about="https://spdx.org/rdf/3.1/terms/Core/Hash">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/Core"/>
    <rdfs:label xml:lang="en">Hash</rdfs:label>
    <rdfs:comment xml:lang="en">A mathematically calculated representation of a grouping of data.</rdfs:comment>
    <skos:definition xml:lang="en">A mathematically calculated representation of a grouping of data.</skos:definition>
    <skos:note xml:lang="en">A hash is a grouping of characteristics unique to the result
of applying a mathematical algorithm
that maps data of arbitrary size to a bit string (the hash)
and is a one-way function, that is,
a function which is practically infeasible to invert.

This is commonly used for integrity checking of data.

Please note that different profiles may also provide additional methods for verifying the integrity of specific subclasses of Elements.</skos:note>
    <rdfs:subClassOf rdf:resource="https://spdx.org/rdf/3.1/terms/Core/IntegrityMethod"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#BlankNodeOrIRI"/>
    <sh:property>
      <rdf:Description rdf:nodeID="Nb6e967b5d4b741c5a394ab56321d4e75">
        <sh:path rdf:resource="https://spdx.org/rdf/3.1/terms/Core/algorithm"/>
        <sh:in rdf:parseType="Collection">
          <rdf:Description rdf:about="https://spdx.org/rdf/3.1/terms/Core/HashAlgorithm/adler32"/>
          <rdf:Description rdf:about="https://spdx.org/rdf/3.1/terms/Core/HashAlgorithm/blake2b256"/>
          <rdf:Description rdf:about="https://spdx.org/rdf/3.1/terms/Core/HashAlgorithm/blake2b384"/>
          <rdf:Description rdf:about="https://spdx.org/rdf/3.1/terms/Core/HashAlgorithm/blake2b512"/>
          <rdf:Description rdf:about="https://spdx.org/rdf/3.1/terms/Core/HashAlgorithm/blake3"/>
          <rdf:Description rdf:about="https://spdx.org/rdf/3.1/terms/Core/HashAlgorithm/crystalsDilithium"/>
          <rdf:Description rdf:about="https://spdx.org/rdf/3.1/terms/Core/HashAlgorithm/crystalsKyber"/>
          <rdf:Description rdf:about="https://spdx.org/rdf/3.1/terms/Core/HashAlgorithm/falcon"/>
          <rdf:Description rdf:about="https://spdx.org/rdf/3.1/terms/Core/HashAlgorithm/md2"/>
          <rdf:Description rdf:about="https://spdx.org/rdf/3.1/terms/Core/HashAlgorithm/md4"/>
          <rdf:Description rdf:about="https://spdx.org/rdf/3.1/terms/Core/HashAlgorithm/md5"/>
          <rdf:Description rdf:about="https://spdx.org/rdf/3.1/terms/Core/HashAlgorithm/md6"/>
          <rdf:Description rdf:about="https://spdx.org/rdf/3.1/terms/Core/HashAlgorithm/other"/>
          <rdf:Description rdf:about="https://spdx.org/rdf/3.1/terms/Core/HashAlgorithm/sha1"/>
