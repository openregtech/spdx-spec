      </rdf:Description>
    </sh:property>
    <sh:property>
      <rdf:Description rdf:nodeID="Na6d0ea863de04e07acbe36070eb54108">
        <sh:path rdf:resource="https://spdx.org/rdf/3.1/terms/Core/rootElement"/>
        <sh:class rdf:resource="https://spdx.org/rdf/3.1/terms/Core/Element"/>
