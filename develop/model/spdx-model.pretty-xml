    <rdfs:label xml:lang="en">packageVerificationCodeExcludedFile</rdfs:label>
    <rdfs:comment xml:lang="en">The relative file name of a file to be excluded from the
PackageVerificationCode.</rdfs:comment>
    <skos:definition xml:lang="en">The relative file name of a file to be excluded from the
PackageVerificationCode.</skos:definition>
    <skos:note xml:lang="en">A relative filename with the root of the package archive or directory
referencing a file to be excluded from the PackageVerificationCode.

Every filename is preceded with a ./.</skos:note>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Software/SbomType/runtime">
