    <rdfs:label xml:lang="en">zAxisLength</rdfs:label>
    <rdfs:comment xml:lang="en">Information related to hardware dimension.</rdfs:comment>
    <skos:definition xml:lang="en">Information related to hardware dimension.</skos:definition>
    <skos:note xml:lang="en">Information related to zAxis measurement of an object.

Z axis is the height of the object.</skos:note>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/Core/MeasureOfLength"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://spdx.org/rdf/3.1/terms/Core/SoftwareAgent">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/Core"/>
    <rdfs:label xml:lang="en">SoftwareAgent</rdfs:label>
    <rdfs:comment xml:lang="en">A software agent.</rdfs:comment>
    <skos:definition xml:lang="en">A software agent.</skos:definition>
    <skos:note xml:lang="en">A SoftwareAgent is a software program that is given the authority (similar to a
user's authority) to act on a system.</skos:note>
    <rdfs:subClassOf rdf:resource="https://spdx.org/rdf/3.1/terms/Core/Agent"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3.1/terms/Core/import">
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/Core"/>
    <rdfs:label xml:lang="en">import</rdfs:label>
    <rdfs:comment xml:lang="en">Provides an ExternalMap of Element identifiers.</rdfs:comment>
    <skos:definition xml:lang="en">Provides an ExternalMap of Element identifiers.</skos:definition>
    <skos:note xml:lang="en">An import provides an ExternalMap of an Element identifier that is used within a
document but defined external to that document.</skos:note>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/Core/ExternalMap"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3.1/terms/SupplyChain/plannedCurrent">
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/SupplyChain"/>
    <rdfs:label xml:lang="en">plannedCurrent</rdfs:label>
    <rdfs:comment xml:lang="en">This is the planned individual, business, or organization who currently manages goods, services, or assets.</rdfs:comment>
    <skos:definition xml:lang="en">This is the planned individual, business, or organization who currently manages goods, services, or assets.</skos:definition>
    <skos:note xml:lang="en">This is the planned individual, business, or organization who currently manages goods, services, or assets.</skos:note>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/Core/Agent"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3.1/terms/Software/snippetFromFile">
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/Software"/>
    <rdfs:label xml:lang="en">snippetFromFile</rdfs:label>
    <rdfs:comment xml:lang="en">Defines the original host file that the snippet information applies to.</rdfs:comment>
    <skos:definition xml:lang="en">Defines the original host file that the snippet information applies to.</skos:definition>
    <skos:note xml:lang="en">The field identifies the file which contains the snippet.</skos:note>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/Software/File"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://spdx.org/rdf/3.1/terms/Dataset/DatasetAvailabilityType">
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/Dataset"/>
    <rdfs:label xml:lang="en">DatasetAvailabilityType</rdfs:label>
    <rdfs:comment xml:lang="en">Availability of dataset.</rdfs:comment>
    <skos:definition xml:lang="en">Availability of dataset.</skos:definition>
  </owl:Class>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/ContactPointRelationshipType/other">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/ContactPointRelationshipType"/>
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/Core"/>
    <rdfs:label xml:lang="en">other</rdfs:label>
    <rdfs:comment xml:lang="en">A generic contact point to be used when the contact type does not match any of the other options.</rdfs:comment>
    <skos:definition xml:lang="en">A generic contact point to be used when the contact type does not match any of the other options.</skos:definition>
  </owl:NamedIndividual>
  <owl:Class rdf:about="https://spdx.org/rdf/3.1/terms/Core/SpecificationType">
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/Core"/>
    <rdfs:label xml:lang="en">SpecificationType</rdfs:label>
    <rdfs:comment xml:lang="en">A specification type defines the nature of a specification.</rdfs:comment>
    <skos:definition xml:lang="en">A specification type defines the nature of a specification.</skos:definition>
  </owl:Class>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/duns">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType"/>
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/Core"/>
    <rdfs:label xml:lang="en">duns</rdfs:label>
    <rdfs:comment xml:lang="en"><![CDATA[Data Universal Numbering System (D-U-N-S) Number <https://www.dnb.com/en-us/smb/duns.html> is a unique nine-digit identifier, issued by Dun & Bradstreet, that identifies a business entity, often on a location-specific basis.]]></rdfs:comment>
    <skos:definition xml:lang="en"><![CDATA[Data Universal Numbering System (D-U-N-S) Number <https://www.dnb.com/en-us/smb/duns.html> is a unique nine-digit identifier, issued by Dun & Bradstreet, that identifies a business entity, often on a location-specific basis.]]></skos:definition>
  </owl:NamedIndividual>
  <owl:Class rdf:about="https://spdx.org/rdf/3.1/terms/SupplyChain/ManufactureProcess">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/SupplyChain"/>
    <rdfs:label xml:lang="en">ManufactureProcess</rdfs:label>
    <rdfs:comment xml:lang="en">This class represents the process involved in manufacturing products.</rdfs:comment>
    <skos:definition xml:lang="en">This class represents the process involved in manufacturing products.</skos:definition>
    <skos:note xml:lang="en">The manufacturing process encompasses the series of steps required to transform materials into finished goods. It is a fundamental operation across various industries, including automotive, electronics, pharmaceuticals, textiles, and food production.</skos:note>
    <rdfs:subClassOf rdf:resource="https://spdx.org/rdf/3.1/terms/SupplyChain/CreateProcess"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3.1/terms/Core/definingArtifact">
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/Core"/>
    <rdfs:label xml:lang="en">definingArtifact</rdfs:label>
    <rdfs:comment xml:lang="en">Artifact representing a serialization instance of SPDX data containing the
definition of a particular Element.</rdfs:comment>
    <skos:definition xml:lang="en">Artifact representing a serialization instance of SPDX data containing the
definition of a particular Element.</skos:definition>
    <skos:note xml:lang="en">A definingArtifact property is used to link the Element identifier for an
Element defined external to a given SpdxDocument to an Artifact Element
representing the SPDX serialization instance which contains the definition for
the Element.</skos:note>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/Core/Artifact"/>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/LifecycleScopeType/update">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/LifecycleScopeType"/>
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/Core"/>
    <rdfs:label xml:lang="en">update</rdfs:label>
    <rdfs:comment xml:lang="en">A relationship has specific context implications for a product update.</rdfs:comment>
    <skos:definition xml:lang="en">A relationship has specific context implications for a product update.</skos:definition>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/issn">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType"/>
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/Core"/>
    <rdfs:label xml:lang="en">issn</rdfs:label>
    <rdfs:comment xml:lang="en"><![CDATA[International Standard Serial Number (ISSN) <https://www.issn.org/understanding-the-issn/what-is-an-issn/> is an eight-digit identifier for serial publications and other continuing resources standardized by ISO 3297 <https://www.iso.org/standard/84536.html>. It consists of two groups of four digits separated by a hyphen, where the final character is a check digit that may be an "X". The hyphen is retained when the identifier is stored electronically to maintain the standard 9-character string format (e.g., 1464-3693). The ISSN is media-specific; the same journal title may be assigned different identifiers for its physical and digital versions.]]></rdfs:comment>
    <skos:definition xml:lang="en"><![CDATA[International Standard Serial Number (ISSN) <https://www.issn.org/understanding-the-issn/what-is-an-issn/> is an eight-digit identifier for serial publications and other continuing resources standardized by ISO 3297 <https://www.iso.org/standard/84536.html>. It consists of two groups of four digits separated by a hyphen, where the final character is a check digit that may be an "X". The hyphen is retained when the identifier is stored electronically to maintain the standard 9-character string format (e.g., 1464-3693). The ISSN is media-specific; the same journal title may be assigned different identifiers for its physical and digital versions.]]></skos:definition>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/RelationshipType/hasSpecification">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/RelationshipType"/>
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/Core"/>
    <rdfs:label xml:lang="en">hasSpecification</rdfs:label>
