  <owl:Class rdf:about="https://spdx.org/rdf/3.1/terms/SupplyChain/UseProcess">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/SupplyChain"/>
    <rdfs:label xml:lang="en">UseProcess</rdfs:label>
    <rdfs:comment xml:lang="en">Use Process defines actions used by elements.</rdfs:comment>
    <skos:definition xml:lang="en">Use Process defines actions used by elements.</skos:definition>
    <skos:note xml:lang="en">The UseProcess is an abstract class used to define processes that interact with key elements. Plan, state, and inspection processes plus managing boundaries are critical processes used by elements.

Relationship:

For each UseProcess or subclass except the PlanProcess there is at least one /Core/Relationship class or subclass with the relationshipType of 'affects’ on the from and a /Core/Element class or subclass on the to.</skos:note>
    <rdfs:subClassOf rdf:resource="https://spdx.org/rdf/3.1/terms/Core/DefinedProcess"/>
    <sh:property>
      <rdf:Description rdf:nodeID="N0e2ad9cf495a46a8b62ced6adc27bbf2">
        <sh:path rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <sh:not>
          <rdf:Description rdf:nodeID="N4d82af3bf2af44f6a3b51f5ff6ac2f82">
            <sh:hasValue rdf:resource="https://spdx.org/rdf/3.1/terms/SupplyChain/UseProcess"/>
          </rdf:Description>
        </sh:not>
        <sh:message xml:lang="en">https://spdx.org/rdf/3.1/terms/SupplyChain/UseProcess is abstract and must not be instantiated directly.</sh:message>
      </rdf:Description>
    </sh:property>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
  </owl:Class>
