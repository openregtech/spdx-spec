    <rdfs:comment xml:lang="en">A LicenseAddition participating in a 'with addition' model.</rdfs:comment>
    <skos:definition xml:lang="en">A LicenseAddition participating in a 'with addition' model.</skos:definition>
    <skos:note xml:lang="en">A subjectAddition is a LicenseAddition which is subject to a 'with additional
text' effect (WithAdditionOperator).</skos:note>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/ExpandedLicensing/LicenseAddition"/>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/IsoAutomationLevel/conditionalAutomation">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/IsoAutomationLevel"/>
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/Core"/>
    <rdfs:label xml:lang="en">conditionalAutomation</rdfs:label>
    <rdfs:comment xml:lang="en">Level 3 - Conditional automation. The system can propose strategies and then automatically execute the approved plan, with an external agent being ready to take over when necessary.</rdfs:comment>
    <skos:definition xml:lang="en">Level 3 - Conditional automation. The system can propose strategies and then automatically execute the approved plan, with an external agent being ready to take over when necessary.</skos:definition>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Hardware/VirtualHardwareModelType/function">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Hardware/VirtualHardwareModelType"/>
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/Hardware"/>
    <rdfs:label xml:lang="en">function</rdfs:label>
    <rdfs:comment xml:lang="en">Simulation the function of the hardware.</rdfs:comment>
    <skos:definition xml:lang="en">Simulation the function of the hardware.</skos:definition>
  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3.1/terms/Core/definitionSource">
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/Core"/>
    <rdfs:label xml:lang="en">definitionSource</rdfs:label>
    <rdfs:comment xml:lang="en">It is the authoritative or credible entity, document, or body of knowledge that provides the meaning of a type, ensuring accuracy, context, and standardization.</rdfs:comment>
    <skos:definition xml:lang="en">It is the authoritative or credible entity, document, or body of knowledge that provides the meaning of a type, ensuring accuracy, context, and standardization.</skos:definition>
    <skos:note xml:lang="en">It is the authoritative or credible entity, document, or body of knowledge that provides the meaning of a type, ensuring accuracy, context, and standardization.
These are adopted to create uniformity and facilitate interoperability within industries.</skos:note>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/Core/Specification"/>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Software/SoftwarePurpose/application">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Software/SoftwarePurpose"/>
