  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/ExternalRefType/vulnerabilityExploitabilityAssessment">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/ExternalRefType"/>
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/Core"/>
    <rdfs:label xml:lang="en">vulnerabilityExploitabilityAssessment</rdfs:label>
    <rdfs:comment xml:lang="en"><![CDATA[A reference to a Vulnerability Exploitability eXchange (VEX) statement which provides information on whether a product is impacted by a specific vulnerability in an included package and, if affected, whether there are actions recommended to remediate. See also NTIA VEX one-page summary <https://ntia.gov/files/ntia/publications/vex_one-page_summary.pdf>.]]></rdfs:comment>
    <skos:definition xml:lang="en"><![CDATA[A reference to a Vulnerability Exploitability eXchange (VEX) statement which provides information on whether a product is impacted by a specific vulnerability in an included package and, if affected, whether there are actions recommended to remediate. See also NTIA VEX one-page summary <https://ntia.gov/files/ntia/publications/vex_one-page_summary.pdf>.]]></skos:definition>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/evidenceUUID">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType"/>
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/Core"/>
    <rdfs:label xml:lang="en">evidenceUUID</rdfs:label>
    <rdfs:comment xml:lang="en">The UUID used by a reporting management system or any other lifecycle management tool to uniquely identify an evidence relationship item. UUID, or universally unique ID, is a standard term to refer to evidence items.</rdfs:comment>
    <skos:definition xml:lang="en">The UUID used by a reporting management system or any other lifecycle management tool to uniquely identify an evidence relationship item. UUID, or universally unique ID, is a standard term to refer to evidence items.</skos:definition>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/SupportType/noSupport">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/SupportType"/>
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/Core"/>
    <rdfs:label xml:lang="en">noSupport</rdfs:label>
    <rdfs:comment xml:lang="en">There is no support for the artifact from the supplier, consumer assumes any support obligations.</rdfs:comment>
    <skos:definition xml:lang="en">There is no support for the artifact from the supplier, consumer assumes any support obligations.</skos:definition>
  </owl:NamedIndividual>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/ExpandedLicensing/seeAlso">
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/ExpandedLicensing"/>
    <rdfs:label xml:lang="en">seeAlso</rdfs:label>
    <rdfs:comment xml:lang="en">Contains a URL where the License or LicenseAddition can be found in use.</rdfs:comment>
    <skos:definition xml:lang="en">Contains a URL where the License or LicenseAddition can be found in use.</skos:definition>
    <skos:note xml:lang="en">A seeAlso defines a cross-reference with a URL where the License or
LicenseAddition can be found in use by one or a few projects.

If applicable, it should include a URL where the license text is posted by
the license steward, particularly if the license steward has made available a
"canonical" primary URL for the license text.

If the license is OSI approved, a seeAlso should be included with the URL for
the license's listing on the OSI website.

The seeAlso URL may refer to a previously-available URL for the License or
LicenseAddition which is no longer active.

Where applicable, the seeAlso URL should include the license text in its
native language. seeAlso URLs to English or other translations may be included
where multiple, equivalent official translations exist.</skos:note>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
  </owl:DatatypeProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/RelationshipCompleteness/incomplete">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/RelationshipCompleteness"/>
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/Core"/>
    <rdfs:label xml:lang="en">incomplete</rdfs:label>
    <rdfs:comment xml:lang="en">The relationship is known not to be exhaustive.</rdfs:comment>
    <skos:definition xml:lang="en">The relationship is known not to be exhaustive.</skos:definition>
  </owl:NamedIndividual>
  <owl:Class rdf:about="https://spdx.org/rdf/3.1/terms/SupplyChain/TransportAction">
