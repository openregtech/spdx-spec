    <rdfs:label xml:lang="en">lexid</rdfs:label>
    <rdfs:comment xml:lang="en"><![CDATA[LEX Identifier is a Uniform Resource Name (URN) for sources of law within the LEX namespace <https://www.iana.org/assignments/urn-formal/lex>, as defined in RFC 9676 <https://datatracker.ietf.org/doc/rfc9676/> (e.g., urn:lex:it:stato:decreto.legislativo:2018-08-10;101).]]></rdfs:comment>
    <skos:definition xml:lang="en"><![CDATA[LEX Identifier is a Uniform Resource Name (URN) for sources of law within the LEX namespace <https://www.iana.org/assignments/urn-formal/lex>, as defined in RFC 9676 <https://datatracker.ietf.org/doc/rfc9676/> (e.g., urn:lex:it:stato:decreto.legislativo:2018-08-10;101).]]></skos:definition>
  </owl:NamedIndividual>
