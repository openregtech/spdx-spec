  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Software/SoftwarePurpose/patch">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Software/SoftwarePurpose"/>
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/Software"/>
    <rdfs:label xml:lang="en">patch</rdfs:label>
    <rdfs:comment xml:lang="en">The Element contains a set of changes to update, fix, or improve another Element.</rdfs:comment>
