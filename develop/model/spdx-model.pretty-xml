    <skos:definition xml:lang="en">Identify the version of a package.</skos:definition>
    <skos:note xml:lang="en">A packageVersion is useful for identification purposes and for indicating later
changes of the package version.</skos:note>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Software/SoftwarePurpose/specification">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Software/SoftwarePurpose"/>
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/Software"/>
    <rdfs:label xml:lang="en">specification</rdfs:label>
    <rdfs:comment xml:lang="en">The Element is a plan, guideline or strategy how to create, perform or analyze an application.</rdfs:comment>
    <skos:definition xml:lang="en">The Element is a plan, guideline or strategy how to create, perform or analyze an application.</skos:definition>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/FunctionalSafety/EvidenceType/log">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/FunctionalSafety/EvidenceType"/>
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/FunctionalSafety"/>
    <rdfs:label xml:lang="en">log</rdfs:label>
