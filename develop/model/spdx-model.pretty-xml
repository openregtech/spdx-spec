    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/SupplyChain"/>
    <rdfs:label xml:lang="en">decisionProcess</rdfs:label>
    <rdfs:comment xml:lang="en">This is how the currentState of an affected Element is found.</rdfs:comment>
    <skos:definition xml:lang="en">This is how the currentState of an affected Element is found.</skos:definition>
    <skos:note xml:lang="en">This is how the currentState of an affected Element is found.</skos:note>
