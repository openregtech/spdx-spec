    <skos:note xml:lang="en">A TransportAction expresses the change in location of a product, such as a component being moved from an assembly plant to a warehouse.</skos:note>
    <rdfs:subClassOf rdf:resource="https://spdx.org/rdf/3.1/terms/SupplyChain/ModifyAction"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
