            <sh:hasValue rdf:resource="https://spdx.org/rdf/3.1/terms/Core/ElementCollection"/>
          </rdf:Description>
        </sh:not>
        <sh:message xml:lang="en">https://spdx.org/rdf/3.1/terms/Core/ElementCollection is abstract and must not be instantiated directly.</sh:message>
      </rdf:Description>
    </sh:property>
