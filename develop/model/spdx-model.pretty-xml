  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/SupplyChain/ResponsibilityType/ownership">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/SupplyChain/ResponsibilityType"/>
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/SupplyChain"/>
    <rdfs:label xml:lang="en">ownership</rdfs:label>
    <rdfs:comment xml:lang="en">Ownership refers to the legal right to control, manage, and benefit from an asset, resource, or responsibility. It establishes authority, accountability, and entitlements over something, whether it's property, a business, intellectual property, or responsibilities.</rdfs:comment>
    <skos:definition xml:lang="en">Ownership refers to the legal right to control, manage, and benefit from an asset, resource, or responsibility. It establishes authority, accountability, and entitlements over something, whether it's property, a business, intellectual property, or responsibilities.</skos:definition>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Software/ContentIdentifierType/swhid">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Software/ContentIdentifierType"/>
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/Software"/>
    <rdfs:label xml:lang="en">swhid</rdfs:label>
    <rdfs:comment xml:lang="en"><![CDATA[SoftWare Hash IDentifier, a persistent intrinsic identifier for digital artifacts, such as files, trees (also known as directories or folders), commits, and other objects typically found in version control systems. The format of the identifiers is defined in the SWHID specification <https://www.swhid.org/swhid-specification/v1.2/> (ISO/IEC 18670 <https://www.iso.org/standard/89985.html>). They typically look like swh:1:cnt:94a9ed024d3859793618152ea559a168bbcbb5e2.]]></rdfs:comment>
    <skos:definition xml:lang="en"><![CDATA[SoftWare Hash IDentifier, a persistent intrinsic identifier for digital artifacts, such as files, trees (also known as directories or folders), commits, and other objects typically found in version control systems. The format of the identifiers is defined in the SWHID specification <https://www.swhid.org/swhid-specification/v1.2/> (ISO/IEC 18670 <https://www.iso.org/standard/89985.html>). They typically look like swh:1:cnt:94a9ed024d3859793618152ea559a168bbcbb5e2.]]></skos:definition>
  </owl:NamedIndividual>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Operations/exportControlSpecification">
