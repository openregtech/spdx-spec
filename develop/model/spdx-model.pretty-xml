      </rdf:Description>
    </sh:property>
    <sh:property>
      <rdf:Description rdf:nodeID="N2c535043886e4eb489287982346c659c">
        <sh:path rdf:resource="https://spdx.org/rdf/3.1/terms/Core/namespaceMap"/>
        <sh:class rdf:resource="https://spdx.org/rdf/3.1/terms/Core/NamespaceMap"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#BlankNodeOrIRI"/>
      </rdf:Description>
    </sh:property>
    <sh:property>
      <rdf:Description rdf:nodeID="Ncf83203a527b418fabc05d1aeba7c93f">
        <sh:path rdf:resource="https://spdx.org/rdf/3.1/terms/Core/dataLicense"/>
        <sh:class rdf:resource="https://spdx.org/rdf/3.1/terms/SimpleLicensing/AnyLicenseInfo"/>
