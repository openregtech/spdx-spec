            <sh:hasValue rdf:resource="https://spdx.org/rdf/3.1/terms/SupplyChain/ModifyAction"/>
          </rdf:Description>
        </sh:not>
        <sh:message xml:lang="en">https://spdx.org/rdf/3.1/terms/SupplyChain/ModifyAction is abstract and must not be instantiated directly.</sh:message>
      </rdf:Description>
    </sh:property>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
  </owl:Class>
