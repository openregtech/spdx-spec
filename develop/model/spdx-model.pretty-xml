      <rdf:Description rdf:nodeID="N12e1f78ffd364172b6f5cfabd9a540e7">
        <sh:path rdf:resource="https://spdx.org/rdf/3.1/terms/Core/country"/>
        <sh:pattern>^[A-Z]{3}$</sh:pattern>
        <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
      </rdf:Description>
    </sh:property>
    <sh:property>
      <rdf:Description rdf:nodeID="Nc2106d1ce2884ba988465f821a9ef1df">
        <sh:path rdf:resource="https://spdx.org/rdf/3.1/terms/Core/countyCode"/>
        <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
      </rdf:Description>
    </sh:property>
    <sh:property>
      <rdf:Description rdf:nodeID="Nfeecd51ec6334fcc80a42968b3766612">
        <sh:path rdf:resource="https://spdx.org/rdf/3.1/terms/Core/city"/>
        <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
