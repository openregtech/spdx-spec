  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/iswc">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType"/>
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/Core"/>
    <rdfs:label xml:lang="en">iswc</rdfs:label>
    <rdfs:comment xml:lang="en"><![CDATA[International Standard Musical Work Code (ISWC) <https://www.iswc.org/iswc> is an 11-character unique identifier standardized by ISO 15707 <https://www.iso.org/standard/83125.html> for musical works (compositions) as distinct from specific recordings. While the "ISWC" label and grouping separators (dots and hyphens) are used for human readability, they shall be omitted when the identifier is stored electronically (e.g., T0017812031).]]></rdfs:comment>
    <skos:definition xml:lang="en"><![CDATA[International Standard Musical Work Code (ISWC) <https://www.iswc.org/iswc> is an 11-character unique identifier standardized by ISO 15707 <https://www.iso.org/standard/83125.html> for musical works (compositions) as distinct from specific recordings. While the "ISWC" label and grouping separators (dots and hyphens) are used for human readability, they shall be omitted when the identifier is stored electronically (e.g., T0017812031).]]></skos:definition>
  </owl:NamedIndividual>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Core/provinceStateCode">
