    <skos:definition xml:lang="en"><![CDATA[FALCON <https://falcon-sign.info/falcon.pdf>]]></skos:definition>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/ExternalRefType/securityPolicy">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/ExternalRefType"/>
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/Core"/>
