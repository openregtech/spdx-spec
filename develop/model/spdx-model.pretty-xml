    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/SupplyChain/transportRoute">
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/SupplyChain"/>
    <rdfs:label xml:lang="en">transportRoute</rdfs:label>
    <rdfs:comment xml:lang="en">A transport route refers to the specific path or network used to move people, goods, data, or resources from one location to another.</rdfs:comment>
    <skos:definition xml:lang="en">A transport route refers to the specific path or network used to move people, goods, data, or resources from one location to another.</skos:definition>
    <skos:note xml:lang="en">A transport route is the path taken by people, products, goods, data or resources. Transport routes vary by product type, safety requirements, business constraints or other factors.</skos:note>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
