    <skos:definition xml:lang="en"><![CDATA[A reference to an npm package. The package locator format is defined in the npm documentation <https://docs.npmjs.com/cli/v10/configuring-npm/package-json> and looks like package@version.]]></skos:definition>
  </owl:NamedIndividual>
  <owl:Class rdf:about="https://spdx.org/rdf/3.1/terms/SupplyChain/DestroyAction">
