  </owl:NamedIndividual>
  <owl:Class rdf:about="https://spdx.org/rdf/3.1/terms/Core/Relationship">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/Core"/>
    <rdfs:label xml:lang="en">Relationship</rdfs:label>
    <rdfs:comment xml:lang="en">Describes a relationship between one or more elements.</rdfs:comment>
    <skos:definition xml:lang="en">Describes a relationship between one or more elements.</skos:definition>
    <skos:note xml:lang="en">A Relationship is a grouping of characteristics unique to an assertion
that one Element is related to one or more other Elements in some way.

To explicitly assert that no such relationships exist, the to property
shall contain the NoneElement individual and no other elements.

A relationship that contains NoneElement and additional elements in the to
property is not valid.

To explicitly assert that no assertions are being made regarding the
existence of such relationships, the to property shall contain the
NoAssertionElement individual.</skos:note>
    <rdfs:subClassOf rdf:resource="https://spdx.org/rdf/3.1/terms/Core/Element"/>
