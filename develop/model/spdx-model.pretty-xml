          <rdf:Description rdf:about="https://spdx.org/rdf/3.1/terms/Core/SupportType/deployed"/>
          <rdf:Description rdf:about="https://spdx.org/rdf/3.1/terms/Core/SupportType/limitedSupport"/>
          <rdf:Description rdf:about="https://spdx.org/rdf/3.1/terms/Core/SupportType/endOfSupport"/>
          <rdf:Description rdf:about="https://spdx.org/rdf/3.1/terms/Core/SupportType/noSupport"/>
          <rdf:Description rdf:about="https://spdx.org/rdf/3.1/terms/Core/SupportType/noAssertion"/>
        </sh:in>
        <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
