  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/nli">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType"/>
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/Core"/>
    <rdfs:label xml:lang="en">nli</rdfs:label>
    <rdfs:comment xml:lang="en"><![CDATA[Natural Location Identifier (NLI) <https://eccma.org/enli-eccma-natural-location-identifier/> is a 14- or 15-character alphanumeric string standardized by ISO 8000-118 <https://www.iso.org/standard/85428.html> that uniquely identifies a three-dimensional geographic point location. The identifier is generated from geodetic coordinates and elevation data. For electronic storage, the ISO.NLI: prefix shall be retained (e.g., ISO.NLI:41TS8M-A8ELTQ-H2).]]></rdfs:comment>
    <skos:definition xml:lang="en"><![CDATA[Natural Location Identifier (NLI) <https://eccma.org/enli-eccma-natural-location-identifier/> is a 14- or 15-character alphanumeric string standardized by ISO 8000-118 <https://www.iso.org/standard/85428.html> that uniquely identifies a three-dimensional geographic point location. The identifier is generated from geodetic coordinates and elevation data. For electronic storage, the ISO.NLI: prefix shall be retained (e.g., ISO.NLI:41TS8M-A8ELTQ-H2).]]></skos:definition>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/ibrn">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType"/>
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/Core"/>
    <rdfs:label xml:lang="en">ibrn</rdfs:label>
    <rdfs:comment xml:lang="en"><![CDATA[International Business Registration Number (IBRN) <https://ekys.org/business_identifiers/> is a unique identifier for legal entities standardized by ISO 8000-116 <https://www.iso.org/standard/75117.html>. It is composed of two parts: a jurisdiction prefix and a local authoritative legal entity identifier (ALEI), separated by a colon. The prefix contains an ISO 3166 country code, an optional subdivision code, and a register code (e.g., US-DE.BER:3031657).]]></rdfs:comment>
    <skos:definition xml:lang="en"><![CDATA[International Business Registration Number (IBRN) <https://ekys.org/business_identifiers/> is a unique identifier for legal entities standardized by ISO 8000-116 <https://www.iso.org/standard/75117.html>. It is composed of two parts: a jurisdiction prefix and a local authoritative legal entity identifier (ALEI), separated by a colon. The prefix contains an ISO 3166 country code, an optional subdivision code, and a register code (e.g., US-DE.BER:3031657).]]></skos:definition>
  </owl:NamedIndividual>
