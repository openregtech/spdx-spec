  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/ExpandedLicensing/isOsiApproved">
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/ExpandedLicensing"/>
    <rdfs:label xml:lang="en">isOsiApproved</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies whether the License is listed as approved by the
Open Source Initiative (OSI).</rdfs:comment>
    <skos:definition xml:lang="en">Specifies whether the License is listed as approved by the
Open Source Initiative (OSI).</skos:definition>
    <skos:note xml:lang="en"><![CDATA[isOsiApproved specifies whether the
Open Source Initiative (OSI) <https://opensource.org>
has listed this License as "approved" in their list of OSI Approved Licenses,
located at the time of this writing at
OSI Approved Licenses <https://opensource.org/licenses>.

A value of "true" indicates that the license is in the list of licenses that
OSI publishes as approved.

A value of "false" indicates that the license is explicitly not in the
corresponding list of OSI licenses (e.g., OSI has stated publicly that a
license is not approved).

If the isOsiApproved field is not specified, the SPDX data creator makes no
assertions about whether the License is approved by the OSI.]]></skos:note>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3.1/terms/Core/elementValue">
