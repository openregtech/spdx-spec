    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/SupplyChain"/>
    <rdfs:label xml:lang="en">TransportProcess</rdfs:label>
    <rdfs:comment xml:lang="en">A prescribed change to a product's location.</rdfs:comment>
    <skos:definition xml:lang="en">A prescribed change to a product's location.</skos:definition>
    <skos:note xml:lang="en">A TransportProcess is a process that will result in a change in location of a product, such as a component being moved from an assembly plant to a warehouse.</skos:note>
    <rdfs:subClassOf rdf:resource="https://spdx.org/rdf/3.1/terms/SupplyChain/ModifyProcess"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
    <sh:property>
      <rdf:Description rdf:nodeID="Nc263a9852e97456b99ab64e081ae7876">
        <sh:path rdf:resource="https://spdx.org/rdf/3.1/terms/SupplyChain/plannedTransportRoutes"/>
        <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      </rdf:Description>
    </sh:property>
    <sh:property>
      <rdf:Description rdf:nodeID="N7d7dd559c9b44834bfd4b996c97b3555">
        <sh:path rdf:resource="https://spdx.org/rdf/3.1/terms/SupplyChain/forPickupLocation"/>
        <sh:class rdf:resource="https://spdx.org/rdf/3.1/terms/Core/Location"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
      </rdf:Description>
    </sh:property>
    <sh:property>
      <rdf:Description rdf:nodeID="Ne030bb63545d4f1e8f3df17c3bbd730c">
        <sh:path rdf:resource="https://spdx.org/rdf/3.1/terms/SupplyChain/forDropoffLocation"/>
        <sh:class rdf:resource="https://spdx.org/rdf/3.1/terms/Core/Location"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
      </rdf:Description>
    </sh:property>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Core/startTime">
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/Core"/>
    <rdfs:label xml:lang="en">startTime</rdfs:label>
    <rdfs:comment xml:lang="en">The point in time when an element or an action starts,
becomes applicable, or becomes valid.</rdfs:comment>
    <skos:definition xml:lang="en">The point in time when an element or an action starts,
becomes applicable, or becomes valid.</skos:definition>
    <skos:note xml:lang="en">A timestamp marking the commencement of an action,
the beginning of an element's relevance,
or the intended start of either.

It encompasses the moment of triggering processes,
such as build executions or service instantiations,
as well as the point in time when an element
or a relationship between elements becomes effective or active.</skos:note>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
  </owl:DatatypeProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/HashAlgorithm/sha512">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/HashAlgorithm"/>
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/Core"/>
    <rdfs:label xml:lang="en">sha512</rdfs:label>
    <rdfs:comment xml:lang="en"><![CDATA[SHA-2 with a digest length of 512, as defined in RFC 6234 <https://datatracker.ietf.org/doc/rfc6234/>.]]></rdfs:comment>
    <skos:definition xml:lang="en"><![CDATA[SHA-2 with a digest length of 512, as defined in RFC 6234 <https://datatracker.ietf.org/doc/rfc6234/>.]]></skos:definition>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/ProfileIdentifierType/functionalSafety">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/ProfileIdentifierType"/>
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/Core"/>
    <rdfs:label xml:lang="en">functionalSafety</rdfs:label>
    <rdfs:comment xml:lang="en">The element follows the FunctionalSafety profile specification.</rdfs:comment>
    <skos:definition xml:lang="en">The element follows the FunctionalSafety profile specification.</skos:definition>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/RelationshipType/delegatedTo">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/RelationshipType"/>
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/Core"/>
    <rdfs:label xml:lang="en">delegatedTo</rdfs:label>
    <rdfs:comment xml:lang="en">The from Agent is delegating an action to the Agent of the to Relationship (which shall be of type invokedBy), during a LifecycleScopeType (e.g. the to invokedBy Relationship is being done on behalf of from).</rdfs:comment>
    <skos:definition xml:lang="en">The from Agent is delegating an action to the Agent of the to Relationship (which shall be of type invokedBy), during a LifecycleScopeType (e.g. the to invokedBy Relationship is being done on behalf of from).</skos:definition>
  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3.1/terms/Hardware/productAgent">
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/Hardware"/>
    <rdfs:label xml:lang="en">productAgent</rdfs:label>
    <rdfs:comment xml:lang="en">The Agent who is responsible for product branding such as an OEM.</rdfs:comment>
    <skos:definition xml:lang="en">The Agent who is responsible for product branding such as an OEM.</skos:definition>
    <skos:note xml:lang="en">The Agent is responsible for defining the partNumber, batchNumber or serialNumber of the unit of hardware.</skos:note>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/Core/Agent"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://spdx.org/rdf/3.1/terms/SupplyChain/AssemblyProcess">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/SupplyChain"/>
    <rdfs:label xml:lang="en">AssemblyProcess</rdfs:label>
    <rdfs:comment xml:lang="en">The AssemblyProcess represents the process of creating a product by assembling a set of components, potentially in a way that allows for at disassembly (at least partially).</rdfs:comment>
    <skos:definition xml:lang="en">The AssemblyProcess represents the process of creating a product by assembling a set of components, potentially in a way that allows for at disassembly (at least partially).</skos:definition>
    <skos:note xml:lang="en">The AssemblyProcess refers to the systematic method of putting together different components to create a finished product. The process of assembly is part of the manufacturing process used in industries such as automotive, electronics, aerospace, and consumer goods. Assembled products may be designed to be disassembled into components.</skos:note>
    <rdfs:subClassOf rdf:resource="https://spdx.org/rdf/3.1/terms/SupplyChain/CreateProcess"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
  </owl:Class>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Service/AuthenticationProtocolType/other">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Service/AuthenticationProtocolType"/>
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/Service"/>
    <rdfs:label xml:lang="en">other</rdfs:label>
    <rdfs:comment xml:lang="en">An authentication protocol not covered by one of the other AuthenticationProtocolTypes.</rdfs:comment>
    <skos:definition xml:lang="en">An authentication protocol not covered by one of the other AuthenticationProtocolTypes.</skos:definition>
  </owl:NamedIndividual>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Core/country">
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/Core"/>
    <rdfs:label xml:lang="en">country</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies a country code of the location.</rdfs:comment>
    <skos:definition xml:lang="en">Specifies a country code of the location.</skos:definition>
    <skos:note xml:lang="en">Specifies a country code of the location.</skos:note>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/RelationshipType/verifiedBy">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/RelationshipType"/>
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/Core"/>
    <rdfs:label xml:lang="en">verifiedBy</rdfs:label>
    <rdfs:comment xml:lang="en">The from Requirement that has verification (test, review, analysis etc.) details defined in the to RequirementVerification.</rdfs:comment>
    <skos:definition xml:lang="en">The from Requirement that has verification (test, review, analysis etc.) details defined in the to RequirementVerification.</skos:definition>
  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3.1/terms/Core/externalRefType">
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/Core"/>
    <rdfs:label xml:lang="en">externalRefType</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies the type of the external reference.</rdfs:comment>
    <skos:definition xml:lang="en">Specifies the type of the external reference.</skos:definition>
    <skos:note xml:lang="en">An externalRefType specifies the type of the external reference.</skos:note>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/Core/ExternalRefType"/>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/RelationshipType/hasDataFile">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/RelationshipType"/>
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/Core"/>
    <rdfs:label xml:lang="en">hasDataFile</rdfs:label>
    <rdfs:comment xml:lang="en">The from Element treats each to Element as a data file. A data file is an artifact that stores data required or optional for the from Element's functionality. A data file can be a database file, an index file, a log file, an AI model file, a calibration data file, a temporary file, a backup file, and more. For AI training dataset, test dataset, test artifact, configuration data, build input data, and build output data, please consider using the more specific relationship types: trainedOn, testedOn, hasTest, configures, hasInput, and hasOutput, respectively. This relationship does not imply dependency.</rdfs:comment>
    <skos:definition xml:lang="en">The from Element treats each to Element as a data file. A data file is an artifact that stores data required or optional for the from Element's functionality. A data file can be a database file, an index file, a log file, an AI model file, a calibration data file, a temporary file, a backup file, and more. For AI training dataset, test dataset, test artifact, configuration data, build input data, and build output data, please consider using the more specific relationship types: trainedOn, testedOn, hasTest, configures, hasInput, and hasOutput, respectively. This relationship does not imply dependency.</skos:definition>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Software/SoftwarePurpose/evidence">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Software/SoftwarePurpose"/>
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/Software"/>
    <rdfs:label xml:lang="en">evidence</rdfs:label>
    <rdfs:comment xml:lang="en">The Element is the evidence that a specification or requirement has been fulfilled.</rdfs:comment>
    <skos:definition xml:lang="en">The Element is the evidence that a specification or requirement has been fulfilled.</skos:definition>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/RelationshipType/modifiedBy">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/RelationshipType"/>
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/Core"/>
    <rdfs:label xml:lang="en">modifiedBy</rdfs:label>
    <rdfs:comment xml:lang="en">The from Element is modified by each to Element.</rdfs:comment>
    <skos:definition xml:lang="en">The from Element is modified by each to Element.</skos:definition>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/cpe23">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType"/>
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/Core"/>
    <rdfs:label xml:lang="en">cpe23</rdfs:label>
    <rdfs:comment xml:lang="en"><![CDATA[Common Platform Enumeration: Naming Specification Version 2.3 <https://csrc.nist.gov/publications/detail/nistir/7695/final>.]]></rdfs:comment>
    <skos:definition xml:lang="en"><![CDATA[Common Platform Enumeration: Naming Specification Version 2.3 <https://csrc.nist.gov/publications/detail/nistir/7695/final>.]]></skos:definition>
  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3.1/terms/Core/suppliedBy">
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/Core"/>
    <rdfs:label xml:lang="en">suppliedBy</rdfs:label>
    <rdfs:comment xml:lang="en">Identifies who or what supplied the artifact or VulnAssessmentRelationship
referenced by the Element.</rdfs:comment>
    <skos:definition xml:lang="en">Identifies who or what supplied the artifact or VulnAssessmentRelationship
referenced by the Element.</skos:definition>
    <skos:note xml:lang="en">Identify the actual distribution source for the artifact (e.g., snippet, file,
package, vulnerability) or VulnAssessmentRelationship being referenced.

This may or may not be different from the originating distribution source
for the artifact (e.g., snippet, file, package, vulnerability) or
VulnAssessmentRelationship.</skos:note>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/Core/Agent"/>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/RelationshipType/coordinatedBy">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/RelationshipType"/>
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/Core"/>
    <rdfs:label xml:lang="en">coordinatedBy</rdfs:label>
    <rdfs:comment xml:lang="en">The from Vulnerability is coordinatedBy the to Agent(s) (vendor, researcher, or consumer agent).</rdfs:comment>
    <skos:definition xml:lang="en">The from Vulnerability is coordinatedBy the to Agent(s) (vendor, researcher, or consumer agent).</skos:definition>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/ExternalRefType/productMetadata">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/ExternalRefType"/>
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/Core"/>
    <rdfs:label xml:lang="en">productMetadata</rdfs:label>
    <rdfs:comment xml:lang="en">A reference to additional product metadata such as reference within organization's product catalog.</rdfs:comment>
    <skos:definition xml:lang="en">A reference to additional product metadata such as reference within organization's product catalog.</skos:definition>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/FunctionalSafety/EvidenceType/recording">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/FunctionalSafety/EvidenceType"/>
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/FunctionalSafety"/>
    <rdfs:label xml:lang="en">recording</rdfs:label>
    <rdfs:comment xml:lang="en">Captured datastream like audio, video, or any other kind of continuous electronic capture of events, behavior or conditions.</rdfs:comment>
    <skos:definition xml:lang="en">Captured datastream like audio, video, or any other kind of continuous electronic capture of events, behavior or conditions.</skos:definition>
  </owl:NamedIndividual>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Service/serviceHostingCountry">
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/Service"/>
    <rdfs:label xml:lang="en">serviceHostingCountry</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies a country code where a software service is hosted.</rdfs:comment>
    <skos:definition xml:lang="en">Specifies a country code where a software service is hosted.</skos:definition>
    <skos:note xml:lang="en"><![CDATA[Specifies a country or territory where a software service is located.
This includes indirect locations (e.g., where the data may be hosted).

The string shall be in the ISO 3166-1 alpha-3 <https://www.iso.org/obp/ui/#iso:std:iso:3166:-1> three-letter format.
See the ISO 3166-1 alpha-3 Wikipedia page <https://en.wikipedia.org/wiki/ISO_3166-1_alpha-3> for more information.]]></skos:note>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
