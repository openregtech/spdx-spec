        <sh:path rdf:resource="https://spdx.org/rdf/3.1/terms/Security/severity"/>
        <sh:in rdf:parseType="Collection">
          <rdf:Description rdf:about="https://spdx.org/rdf/3.1/terms/Security/CvssSeverityType/critical"/>
