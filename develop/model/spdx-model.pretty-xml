    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/Core"/>
    <rdfs:label xml:lang="en">socialMedia</rdfs:label>
    <rdfs:comment xml:lang="en">A reference to a social media channel for a package.</rdfs:comment>
    <skos:definition xml:lang="en">A reference to a social media channel for a package.</skos:definition>
  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3.1/terms/Hardware/zAxisLength">
