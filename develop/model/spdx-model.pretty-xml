  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/hsCodes">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType"/>
