    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/Core"/>
    <rdfs:label xml:lang="en">Regulation</rdfs:label>
    <rdfs:comment xml:lang="en">Regulation represents a rule or directive maintained by an authority.</rdfs:comment>
    <skos:definition xml:lang="en">Regulation represents a rule or directive maintained by an authority.</skos:definition>
    <skos:note xml:lang="en">The Regulation class represents any rules or directives enforced by an official authority.
Regulations within this class can be either mandatory or voluntary.

Examples of these regulations include the EU Radio Equipment Directive, EU Cyber Resilience Act,
the Japan Cyber STAR, or the U.S. Cyber Trust Mark.</skos:note>
    <rdfs:subClassOf rdf:resource="https://spdx.org/rdf/3.1/terms/Core/Specification"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
  </owl:Class>
