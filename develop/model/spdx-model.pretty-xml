    <rdfs:comment xml:lang="en">Every from Action is performedBy to Agent.</rdfs:comment>
    <skos:definition xml:lang="en">Every from Action is performedBy to Agent.</skos:definition>
  </owl:NamedIndividual>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Core/standardName">
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/Core"/>
    <rdfs:label xml:lang="en">standardName</rdfs:label>
    <rdfs:comment xml:lang="en">The name of a relevant standard that may apply to an artifact.</rdfs:comment>
    <skos:definition xml:lang="en">The name of a relevant standard that may apply to an artifact.</skos:definition>
    <skos:note xml:lang="en">Various standards may be relevant or useful to capture for specific artifacts.

This does not imply that the artifact is compliant with the standard,
but rather that the standard is used as a reference or guideline for
the design, implementation, production, or evaluation of the artifact.

For compliance with a standard, use the standardCompliance property instead.</skos:note>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
