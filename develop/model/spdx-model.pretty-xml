  <owl:Class rdf:about="https://spdx.org/rdf/3.1/terms/Hardware/Hardware">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/Hardware"/>
    <rdfs:label xml:lang="en">Hardware</rdfs:label>
    <rdfs:comment xml:lang="en">Class that describes an instance of Hardware.</rdfs:comment>
    <skos:definition xml:lang="en">Class that describes an instance of Hardware.</skos:definition>
    <skos:note xml:lang="en">A hardware artifact is a distinct unit related to hardware.</skos:note>
    <rdfs:subClassOf rdf:resource="https://spdx.org/rdf/3.1/terms/Core/Artifact"/>
    <sh:property>
      <rdf:Description rdf:nodeID="Nf278e020086e43bebfe81c3481259ead">
        <sh:path rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <sh:not>
          <rdf:Description rdf:nodeID="N1f2767a0b59242888b21213c894772f4">
