  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/ibid">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType"/>
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/Core"/>
    <rdfs:label xml:lang="en">ibid</rdfs:label>
    <rdfs:comment xml:lang="en"><![CDATA[International Business Identifier (IBID) <https://ekys.org/business_identifiers/> is a verifiable unique identifier for legal entities as defined in the ISO/DIS 25500-3 <https://www.iso.org/standard/87705.html> draft standard. It is composed of three data elements: the International Business Registration Number (IBRN), the legal name, and the date of origin formatted as eight numeric characters (YYYYMMDD). Each element is separated by a pipe character (|) (e.g., US-DE.BER:3031657|Code Management Association|19990420).]]></rdfs:comment>
    <skos:definition xml:lang="en"><![CDATA[International Business Identifier (IBID) <https://ekys.org/business_identifiers/> is a verifiable unique identifier for legal entities as defined in the ISO/DIS 25500-3 <https://www.iso.org/standard/87705.html> draft standard. It is composed of three data elements: the International Business Registration Number (IBRN), the legal name, and the date of origin formatted as eight numeric characters (YYYYMMDD). Each element is separated by a pipe character (|) (e.g., US-DE.BER:3031657|Code Management Association|19990420).]]></skos:definition>
  </owl:NamedIndividual>
