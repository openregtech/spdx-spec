  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Security/CvssSeverityType/high">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Security/CvssSeverityType"/>
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/Security"/>
    <rdfs:label xml:lang="en">high</rdfs:label>
    <rdfs:comment xml:lang="en">When a CVSS score is between 7.0 - 8.9.</rdfs:comment>
    <skos:definition xml:lang="en">When a CVSS score is between 7.0 - 8.9.</skos:definition>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Security/CvssSeverityType/low">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Security/CvssSeverityType"/>
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/Security"/>
    <rdfs:label xml:lang="en">low</rdfs:label>
    <rdfs:comment xml:lang="en">When a CVSS score is between 0.1 - 3.9.</rdfs:comment>
    <skos:definition xml:lang="en">When a CVSS score is between 0.1 - 3.9.</skos:definition>
  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3.1/terms/Core/profileConformance">
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/Core"/>
    <rdfs:label xml:lang="en">profileConformance</rdfs:label>
    <rdfs:comment xml:lang="en">Describes one a profile which the creator of this ElementCollection intends to
conform to.</rdfs:comment>
    <skos:definition xml:lang="en">Describes one a profile which the creator of this ElementCollection intends to
conform to.</skos:definition>
    <skos:note xml:lang="en">Describes a profile to which the creator of this ElementCollection intends to
conform.

The profileConformance will apply to all Elements contained within the
collection as well as the collection itself.

Conformance to a profile is defined by the additional restrictions documented
in the profile specific documentation and schema files.

Use of this property allows the creator of an ElementCollection to communicate
to consumers their intent to adhere to the profile additional restrictions.

The profileConformance has a default value of "core" if no other
profileConformance is specified since all ElementCollections and Element shall
adhere to the Core profile.</skos:note>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/Core/ProfileIdentifierType"/>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/LifecycleScopeType/other">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/LifecycleScopeType"/>
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/Core"/>
    <rdfs:label xml:lang="en">other</rdfs:label>
    <rdfs:comment xml:lang="en">A relationship has other specific context information necessary to capture that the above set of enumerations does not handle.</rdfs:comment>
    <skos:definition xml:lang="en">A relationship has other specific context information necessary to capture that the above set of enumerations does not handle.</skos:definition>
  </owl:NamedIndividual>
