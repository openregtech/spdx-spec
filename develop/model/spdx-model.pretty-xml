    <skos:definition xml:lang="en">Information related to massOfHardware physical hardware.</skos:definition>
    <skos:note xml:lang="en">Mass is defined as an intrinsic property of a body for describing a physical hardware component.</skos:note>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/Core/MeasureOfMass"/>
