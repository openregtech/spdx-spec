          <rdf:Description rdf:about="https://spdx.org/rdf/3.1/terms/Core/HashAlgorithm/sha3_384"/>
          <rdf:Description rdf:about="https://spdx.org/rdf/3.1/terms/Core/HashAlgorithm/sha3_512"/>
        </sh:in>
