    <rdfs:label xml:lang="en">releaseDate</rdfs:label>
    <rdfs:comment xml:lang="en">Date of product release.</rdfs:comment>
    <skos:definition xml:lang="en">Date of product release.</skos:definition>
    <skos:note xml:lang="en">This is the first date associated to a specific product release.</skos:note>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://spdx.org/rdf/3.1/terms/FunctionalSafety/EvidenceRelationship">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/FunctionalSafety"/>
    <rdfs:label xml:lang="en">EvidenceRelationship</rdfs:label>
    <rdfs:comment xml:lang="en">EvidenceRelationship defines the association between pieces of evidence and EvaluationResult.</rdfs:comment>
    <skos:definition xml:lang="en">EvidenceRelationship defines the association between pieces of evidence and EvaluationResult.</skos:definition>
    <skos:note xml:lang="en">EvidenceRelationship defines the association between pieces of evidence and EvaluationResult. This establishes traceability and contextual linkage between evidence items, supporting certification, verification, and audit activities.</skos:note>
    <rdfs:subClassOf rdf:resource="https://spdx.org/rdf/3.1/terms/Core/Relationship"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
    <sh:property>
      <rdf:Description rdf:nodeID="N6eed3b0a320f44ab97305f546590ef33">
        <sh:path rdf:resource="https://spdx.org/rdf/3.1/terms/FunctionalSafety/evidenceUUID"/>
        <sh:class rdf:resource="https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifier"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#BlankNodeOrIRI"/>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
      </rdf:Description>
    </sh:property>
    <sh:property>
      <rdf:Description rdf:nodeID="Nd42c633c877641d58e1bfd80df3599c7">
        <sh:path rdf:resource="https://spdx.org/rdf/3.1/terms/FunctionalSafety/evidenceCategory"/>
        <sh:in rdf:parseType="Collection">
          <rdf:Description rdf:about="https://spdx.org/rdf/3.1/terms/FunctionalSafety/EvidenceType/report"/>
          <rdf:Description rdf:about="https://spdx.org/rdf/3.1/terms/FunctionalSafety/EvidenceType/log"/>
          <rdf:Description rdf:about="https://spdx.org/rdf/3.1/terms/FunctionalSafety/EvidenceType/recording"/>
          <rdf:Description rdf:about="https://spdx.org/rdf/3.1/terms/FunctionalSafety/EvidenceType/observation"/>
          <rdf:Description rdf:about="https://spdx.org/rdf/3.1/terms/FunctionalSafety/EvidenceType/other"/>
        </sh:in>
      </rdf:Description>
    </sh:property>
  </owl:Class>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/SpecificationType/formalStandard">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/SpecificationType"/>
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/Core"/>
    <rdfs:label xml:lang="en">formalStandard</rdfs:label>
    <rdfs:comment xml:lang="en">A formal standard is a standard ratified by a recognized standards-development organization and published as a normative reference.</rdfs:comment>
    <skos:definition xml:lang="en">A formal standard is a standard ratified by a recognized standards-development organization and published as a normative reference.</skos:definition>
  </owl:NamedIndividual>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Security/percentile">
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/Security"/>
    <rdfs:label xml:lang="en">percentile</rdfs:label>
    <rdfs:comment xml:lang="en">The percentile of the current probability score.</rdfs:comment>
    <skos:definition xml:lang="en">The percentile of the current probability score.</skos:definition>
    <skos:note xml:lang="en"><![CDATA[The percentile between 0 and 1 (0 and 100%) of the current probability score,
the proportion of all scored vulnerabilities with the same or a lower
probability score. The definition follows "percentile" in
EPSS Data <https://www.first.org/epss/data_stats>.]]></skos:note>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
