that is being used in the AI system.</skos:note>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/AI/EnergyConsumptionDescription"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://spdx.org/rdf/3.1/terms/Core/MeasureOfLength">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/Core"/>
    <rdfs:label xml:lang="en">MeasureOfLength</rdfs:label>
    <rdfs:comment xml:lang="en">The measure of length refers to the dimension of an object or space that describes how long it is, typically expressed in various units depending on the system of measurement being used.</rdfs:comment>
