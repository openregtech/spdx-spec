    <rdfs:label xml:lang="en">intendedUse</rdfs:label>
    <rdfs:comment xml:lang="en">The intendedUse property is designed to capture a summary of how or for what item or artifact is meant to be used for.</rdfs:comment>
    <skos:definition xml:lang="en">The intendedUse property is designed to capture a summary of how or for what item or artifact is meant to be used for.</skos:definition>
    <skos:note xml:lang="en">The intendedUse field allows users to enter a free-form textual description outlining the scope and boundaries of appropriate or intended applications for the item or artifact.</skos:note>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
