  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3.1/terms/AI/metricDecisionThreshold">
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/AI"/>
    <rdfs:label xml:lang="en">metricDecisionThreshold</rdfs:label>
    <rdfs:comment xml:lang="en">Threshold that was used for computation of a metric described in
the metric field.</rdfs:comment>
    <skos:definition xml:lang="en">Threshold that was used for computation of a metric described in
the metric field.</skos:definition>
    <skos:note xml:lang="en">Each metric can be computed based on a decision threshold.

For instance, precision or recall is typically computed by checking if the
probability of the outcome is larger than 0.5.

Each decision threshold shall match with a metric field defined in the AI
package.</skos:note>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/Core/DictionaryEntry"/>
  </owl:ObjectProperty>
