  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/ExternalRefType/secureSoftwareAttestation">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/ExternalRefType"/>
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/Core"/>
    <rdfs:label xml:lang="en">secureSoftwareAttestation</rdfs:label>
    <rdfs:comment xml:lang="en"><![CDATA[A reference to information assuring that the software is developed using security practices as defined by NIST SP 800-218 Secure Software Development Framework (SSDF) Version 1.1 <https://csrc.nist.gov/pubs/sp/800/218/final> or CISA Secure Software Development Attestation Form <https://www.cisa.gov/resources-tools/resources/secure-software-development-attestation-form>.]]></rdfs:comment>
    <skos:definition xml:lang="en"><![CDATA[A reference to information assuring that the software is developed using security practices as defined by NIST SP 800-218 Secure Software Development Framework (SSDF) Version 1.1 <https://csrc.nist.gov/pubs/sp/800/218/final> or CISA Secure Software Development Attestation Form <https://www.cisa.gov/resources-tools/resources/secure-software-development-attestation-form>.]]></skos:definition>
  </owl:NamedIndividual>
  <owl:Class rdf:about="https://spdx.org/rdf/3.1/terms/AI/SafetyRiskAssessmentType">
