  <owl:Class rdf:about="https://spdx.org/rdf/3.1/terms/SupplyChain/BoundaryDefinitionProcess">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/SupplyChain"/>
    <rdfs:label xml:lang="en">BoundaryDefinitionProcess</rdfs:label>
    <rdfs:comment xml:lang="en">The Boundary Definition Process refers to the process class used to produce boundaries.</rdfs:comment>
