  <owl:Class rdf:about="https://spdx.org/rdf/3.1/terms/Core/SupportRelationship">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdfs:isDefinedBy rdf:resource="https://spdx.org/rdf/3.1/terms/Core"/>
    <rdfs:label xml:lang="en">SupportRelationship</rdfs:label>
    <rdfs:comment xml:lang="en">Describes how an Agent provides support for an Artifact.</rdfs:comment>
    <skos:definition xml:lang="en">Describes how an Agent provides support for an Artifact.</skos:definition>
    <skos:note xml:lang="en">Specifies how an Agent supports a given Artifact. The relationship type shall be
providesSupportFor. The from of the relationship is the Agent providing
support, and the to are the Artifact for which support is being provided.

startTime and endTime are mandatory when using this class.</skos:note>
    <rdfs:subClassOf rdf:resource="https://spdx.org/rdf/3.1/terms/Core/Relationship"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
