# https://spdx.org/rdf/3/terms/Security/ExploitCatalogVulnAssessmentRelationship node528
node528 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>ExploitCatalogVulnAssessmentRelationship</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Security/ExploitCatalogVulnAssessmentRelationship' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Security/ExploitCatalogVulnAssessmentRelationship</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Provides an exploit assessment of a vulnerability.&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;Provides an exploit assessment of a vulnerability.&quot;@en</td></tr><tr><td align='left'>skos:note</td><td align='left'>&quot;An ExploitCatalogVulnAssessmentRelationship describes if a vulnerability is
listed in any exploit catalog such as the
CISA Known Exploited Vulnerabilities (KEV) Catalog &lt;https://www.cisa.gov/known-exploited-vulnerabilities-catalog&gt;.

*Constraints*

- The relationship type shall be set to hasAssessmentFor.

*Example*

{
  &quot;type&quot;: &quot;security_ExploitCatalogVulnAssessmentRelationship&quot;,
  &quot;spdxId&quot;: &quot;urn:spdx.dev:exploit-catalog-1&quot;,
  &quot;relationshipType&quot;: &quot;hasAssessmentFor&quot;,
  &quot;security_catalogType&quot;: &quot;kev&quot;,
  &quot;locator&quot;: &quot;https://www.cisa.gov/known-exploited-vulnerabilities-catalog&quot;,
  &quot;security_exploited&quot;: &quot;true&quot;,
  &quot;from&quot;: &quot;urn:spdx.dev:vuln-cve-2023-2136&quot;,
  &quot;to&quot;: [&quot;urn:product-google-chrome-112.0.5615.136&quot;],
  &quot;suppliedBy&quot;: &quot;urn:spdx.dev:agent-jane-doe&quot;,
  &quot;security_publishedTime&quot;: &quot;2021-03-09T11:04:53Z&quot;
}&quot;@en</td></tr></table> > ] 
# https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/isrc node529
node529 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>isrc</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/isrc' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/isrc</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;International Standard Recording Code (ISRC) &lt;https://isrc.ifpi.org/isrc-standard&gt; is a unique 12-character alphanumeric identifier for sound recordings and music video recordings standardized by ISO 3901 &lt;https://www.iso.org/standard/64817.html&gt;. While the &quot;ISRC&quot; label and grouping hyphens used for human readability, they shall be omitted when the identifier is stored electronically (e.g., USCA28900153).&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;International Standard Recording Code (ISRC) &lt;https://isrc.ifpi.org/isrc-standard&gt; is a unique 12-character alphanumeric identifier for sound recordings and music video recordings standardized by ISO 3901 &lt;https://www.iso.org/standard/64817.html&gt;. While the &quot;ISRC&quot; label and grouping hyphens used for human readability, they shall be omitted when the identifier is stored electronically (e.g., USCA28900153).&quot;@en</td></tr></table> > ] 
