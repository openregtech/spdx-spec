# https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/ark node524
node524 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>ark</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/ark' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/ark</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Archival Resource Key (ARK) &lt;https://arks.org/about/&gt;, is a Uniform Resource Identifier (URI) suited to being a persistent identifier for information objects of any type, standardized by the ARK Identifier Scheme &lt;https://datatracker.ietf.org/doc/draft-kunze-ark/&gt; Internet-Draft. It consists of the &quot;ark:&quot; label followed by a Name Assigning Authority Number, a forward slash, a name, and an optional qualifier (e.g., ark:12148/btv1b8449691v/f29).&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;Archival Resource Key (ARK) &lt;https://arks.org/about/&gt;, is a Uniform Resource Identifier (URI) suited to being a persistent identifier for information objects of any type, standardized by the ARK Identifier Scheme &lt;https://datatracker.ietf.org/doc/draft-kunze-ark/&gt; Internet-Draft. It consists of the &quot;ark:&quot; label followed by a Name Assigning Authority Number, a forward slash, a name, and an optional qualifier (e.g., ark:12148/btv1b8449691v/f29).&quot;@en</td></tr></table> > ] 
