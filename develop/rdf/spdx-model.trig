    ns10:subjectLicense a owl:ObjectProperty ;
        rdfs:label "subjectLicense"@en ;
        rdfs:comment "A License participating in an 'or later' model."@en ;
        rdfs:isDefinedBy spdx-expandedlicensing: ;
