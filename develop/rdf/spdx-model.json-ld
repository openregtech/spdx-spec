  {
    "@id": "https://spdx.org/rdf/3/terms/ExpandedLicensing/isFsfLibre",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Specifies whether the License is listed as free by the\nFree Software Foundation (FSF)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://spdx.org/rdf/3/terms/ExpandedLicensing/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "isFsfLibre"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#boolean"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Specifies whether the License is listed as free by the\nFree Software Foundation (FSF)."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "isFsfLibre specifies whether the\nFree Software Foundation (FSF) <https://fsf.org>\nhas listed this License as \"free\" in their commentary on licenses, located at\nthe time of this writing at\nVarious Licenses and Comments about Them <https://www.gnu.org/licenses/license-list.en.html>.\n\nA value of \"true\" indicates that the license is in the list of licenses that\nFSF publishes as libre.\n\nA value of \"false\" indicates that the license is explicitly not in the\ncorresponding list of FSF libre licenses (e.g., FSF has the license on a\nnon-free list).\n\nIf the isFsfLibre field is not specified, the SPDX data creator makes no\nassertions about whether the License is listed in the FSF's commentary."
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/ibrn",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "International Business Registration Number (IBRN) <https://ekys.org/business_identifiers/> is a unique identifier for legal entities standardized by ISO 8000-116 <https://www.iso.org/standard/75117.html>. It is composed of two parts: a jurisdiction prefix and a local authoritative legal entity identifier (ALEI), separated by a colon. The prefix contains an ISO 3166 country code, an optional subdivision code, and a register code (e.g., US-DE.BER:3031657)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://spdx.org/rdf/3/terms/Core/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "ibrn"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "International Business Registration Number (IBRN) <https://ekys.org/business_identifiers/> is a unique identifier for legal entities standardized by ISO 8000-116 <https://www.iso.org/standard/75117.html>. It is composed of two parts: a jurisdiction prefix and a local authoritative legal entity identifier (ALEI), separated by a colon. The prefix contains an ISO 3166 country code, an optional subdivision code, and a register code (e.g., US-DE.BER:3031657)."
      }
    ]
  },
