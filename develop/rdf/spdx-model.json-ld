    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Temporary endeavor with a beginning and an end and that must be used to create a unique product, service or result."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Temporary endeavor with a beginning and an end and that must be used to create a unique product, service or result.\n\nBased on the Project Management Body of Knowledge (PMBOK), 3rd edition.\n\nstartTime is the time at which a project starts or is planned to start.\nendTime is the time at which a project ends or is planned to end."
      }
    ],
