      {
        "@language": "en",
        "@value": "Identify the actual distribution source for the artifact (e.g., snippet, file,\npackage, vulnerability) or VulnAssessmentRelationship being referenced.\n\nThis may or may not be different from the originating distribution source\nfor the artifact (e.g., snippet, file, package, vulnerability) or\nVulnAssessmentRelationship."
      }
    ]
  },
