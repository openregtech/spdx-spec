  {
    "@id": "https://spdx.org/rdf/3/terms/Core/startTime",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The point in time when an element or an action starts,\nbecomes applicable, or becomes valid."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://spdx.org/rdf/3/terms/Core/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "startTime"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#dateTimeStamp"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The point in time when an element or an action starts,\nbecomes applicable, or becomes valid."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "A timestamp marking the commencement of an action,\nthe beginning of an element's relevance,\nor the intended start of either.\n\nIt encompasses the moment of triggering processes,\nsuch as build executions or service instantiations,\nas well as the point in time when an element\nor a relationship between elements becomes effective or active."
      }
    ]
  },
  {
