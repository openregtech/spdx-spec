      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Quantity is the amount in the selected QUDT unit."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Quantity is a property that defines the count, multitude or magnitude.\n\nExpress it as an xsd:decimal whenever possible.\nIf it is not an xsd:decimal, place the notation being used in the parent element's comment field."
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/issn",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "International Standard Serial Number (ISSN) <https://www.issn.org/understanding-the-issn/what-is-an-issn/> is an eight-digit identifier for serial publications and other continuing resources standardized by ISO 3297 <https://www.iso.org/standard/84536.html>. It consists of two groups of four digits separated by a hyphen, where the final character is a check digit that may be an \"X\". The hyphen is retained when the identifier is stored electronically to maintain the standard 9-character string format (e.g., 1464-3693). The ISSN is media-specific; the same journal title may be assigned different identifiers for its physical and digital versions."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://spdx.org/rdf/3/terms/Core/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "issn"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "International Standard Serial Number (ISSN) <https://www.issn.org/understanding-the-issn/what-is-an-issn/> is an eight-digit identifier for serial publications and other continuing resources standardized by ISO 3297 <https://www.iso.org/standard/84536.html>. It consists of two groups of four digits separated by a hyphen, where the final character is a check digit that may be an \"X\". The hyphen is retained when the identifier is stored electronically to maintain the standard 9-character string format (e.g., 1464-3693). The ISSN is media-specific; the same journal title may be assigned different identifiers for its physical and digital versions."
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Security/VexVulnAssessmentRelationship",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class",
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Abstract ancestor class for all VEX relationships."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://spdx.org/rdf/3/terms/Security/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "VexVulnAssessmentRelationship"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://spdx.org/rdf/3/terms/Security/VulnAssessmentRelationship"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Abstract ancestor class for all VEX relationships."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "VexVulnAssessmentRelationship is an abstract subclass that defined the common\nproperties shared by all the SPDX-VEX status relationships.\n\n*Constraints*\n\nWhen linking elements using a VexVulnAssessmentRelationship, the following\nrequirements shall be observed:\n\n- The to: end shall point to elements representing the VEX *products*.\n\nTo specify a different element where the vulnerability was detected, the VEX\nrelationship can optionally specify *subcomponents* using the assessedElement\nproperty.\n\nVEX inherits information from the document level down to its statements. When a\nstatement is missing information it can be completed by reading the equivalent\nfield from the containing document. For example, if a VEX relationship is\nmissing data in its createdBy property, tools shall consider the entity\nlisted in the CreationInfo section of the document as the VEX author.\nIn the same way, when a VEX relationship does not have a created property,\nthe document's date shall be considered as authoritative."
      }
    ],
    "http://www.w3.org/ns/shacl#nodeKind": [
      {
        "@id": "http://www.w3.org/ns/shacl#IRI"
      }
    ],
    "http://www.w3.org/ns/shacl#property": [
      {
        "@id": "_:N53b416affc9d4169a18fb6c789482348"
      },
      {
        "@id": "_:N3bdd54d2e26142458ae1fdec100efa7f"
      },
      {
        "@id": "_:Nc10bb4affb1e4a9fb73775caf57229d1"
      }
    ]
  },
  {
    "@id": "_:N53b416affc9d4169a18fb6c789482348",
    "http://www.w3.org/ns/shacl#message": [
      {
        "@language": "en",
        "@value": "https://spdx.org/rdf/3/terms/Security/VexVulnAssessmentRelationship is abstract and must not be instantiated directly."
      }
    ],
    "http://www.w3.org/ns/shacl#not": [
      {
        "@id": "_:N55e855fa65cc4f67a250591e2d89b172"
      }
    ],
