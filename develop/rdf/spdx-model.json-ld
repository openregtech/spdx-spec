  {
    "@id": "https://spdx.org/rdf/3/terms/AI/safetyRiskAssessment",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Results of general safety risk assessment of the AI system."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://spdx.org/rdf/3/terms/AI/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "safetyRiskAssessment"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://spdx.org/rdf/3/terms/AI/SafetyRiskAssessmentType"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Results of general safety risk assessment of the AI system."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Results of general safety risk assessment of the AI system.\n\nUsing categorization according to the\nEU general risk assessment methodology <https://ec.europa.eu/docsroom/documents/17107>.\nThe methodology implements Article 20 of Regulation (EC) No 765/2008 and is\nintended to assist authorities when they assess general product safety\ncompliance.\n\nIt is important to note that this categorization differs from the one proposed\nin the EU AI Act's provisional agreement."
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Core/originatedBy",
    "@type": [
