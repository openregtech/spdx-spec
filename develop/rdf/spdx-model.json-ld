      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Core/created",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Identifies when the Element was originally created."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://spdx.org/rdf/3/terms/Core/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "created"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#dateTimeStamp"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Identifies when the Element was originally created."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Created is a date that identifies when the Element was originally created.\n\nThe time stamp can serve as an indication as to whether the analysis needs to\nbe updated.\n\nThis is often the date of last change (e.g., a git commit date), not the date\nwhen the SPDX data was created, as doing so supports reproducible builds."
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Core/standardName",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The name of a relevant standard that may apply to an artifact."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://spdx.org/rdf/3/terms/Core/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "standardName"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The name of a relevant standard that may apply to an artifact."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Various standards may be relevant or useful to capture for specific artifacts.\n\nThis does not imply that the artifact is compliant with the standard,\nbut rather that the standard is used as a reference or guideline for\nthe design, implementation, production, or evaluation of the artifact.\n\nFor compliance with a standard, use the standardCompliance property instead."
