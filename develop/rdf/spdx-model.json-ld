        "@value": "standardAdditionTemplate"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Identifies the full text of a LicenseAddition, in SPDX templating format."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "A standardAdditionTemplate contains a license addition template which describes\nsections of the LicenseAddition text which can be varied.\n\nSee the Legacy Text Template format section of the\nSPDX License List Matching Guidelines\nfor format information.\n\nIt is recommended to use licenseXml instead, as it can\ncapture all the text and metadata associated with a license."
      }
    ]
  },
