    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "A licenseText contains the plain text of the License or Addition,\nwithout templating or other similar markup.\n\nUsers of the licenseText for a License can apply the\nSPDX License List Matching Guidelines\nwhen comparing it to another text for matching purposes."
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Operations/Project",
    "@type": [
