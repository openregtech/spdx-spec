      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Dataset/ConfidentialityLevelType/amber",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3/terms/Dataset/ConfidentialityLevelType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Data points in the dataset can be shared only with specific organizations and their clients on a need to know basis."
      }
    ],
