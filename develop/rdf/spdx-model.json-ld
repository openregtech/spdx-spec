    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A property name with an associated value."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://spdx.org/rdf/3/terms/Extension/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "CdxPropertyEntry"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A property name with an associated value."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Each CdxPropertyEntry contains a name-value pair which maps the name to its\nassociated value.\n\nUnlike key-value stores, properties in CdxPropertiesExtension support duplicate\nnames, each potentially having different values.\n\nThis class can be used to implement CycloneDX compatible properties."
      }
    ],
