  {
    "@id": "https://spdx.org/rdf/3/terms/Software/packageUrl",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Provides a place for the SPDX data creator to record the Package-URL\nfor a software Package."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://spdx.org/rdf/3/terms/Software/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "packageUrl"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#anyURI"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Provides a place for the SPDX data creator to record the Package-URL\nfor a software Package."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "A packageUrl property specifies a Package-URL (PURL).\nThe PURL shall be a valid Uniform Resource Identifier (URI) and\nUniform Resource Locator (URL) that identifies a software package independent\nof its ecosystem or distribution channel, in accordance with\nECMA-427 <https://ecma-international.org/publications-and-standards/standards/ecma-427/>.\n\nThe PURL contains a type component that defines the ecosystem-specific\nstructure and semantics for the remaining PURL components.\n\nThe registered PURL type definitions are maintained in the Package-URL type\nregistry available at https://packageurl.org/docs/purl/purl-types."
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/AI/SafetyRiskAssessmentType/low",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
