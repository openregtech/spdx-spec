      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A requirementUID is a unique identifier assigned to a Requirement."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "A unique identifier, as used by requirements management or other lifecycle\nmanagement tools, usually a string that follows a project specific naming\nconvention."
      }
    ]
  },
