  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Core/ExternalRefType/vulnerabilityDisclosureReport",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3/terms/Core/ExternalRefType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A reference to a Vulnerability Disclosure Report (VDR) which provides the software supplier's analysis and findings describing the impact (or lack of impact) that reported vulnerabilities have on packages or products in the supplier's SBOM as defined in NIST SP 800-161 Cybersecurity Supply Chain Risk Management Practices for Systems and Organizations <https://csrc.nist.gov/pubs/sp/800/161/r1/final>."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://spdx.org/rdf/3/terms/Core/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "vulnerabilityDisclosureReport"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A reference to a Vulnerability Disclosure Report (VDR) which provides the software supplier's analysis and findings describing the impact (or lack of impact) that reported vulnerabilities have on packages or products in the supplier's SBOM as defined in NIST SP 800-161 Cybersecurity Supply Chain Risk Management Practices for Systems and Organizations <https://csrc.nist.gov/pubs/sp/800/161/r1/final>."
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Security/probability",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A probability score between 0 and 1 of a vulnerability being exploited."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://spdx.org/rdf/3/terms/Security/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "probability"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#decimal"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A probability score between 0 and 1 of a vulnerability being exploited."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "The probability score between 0 and 1 (0 and 100%) estimating the likelihood of\nexploitation in the wild in the next 30 days (following score publication).\nThe definition follows \"epss\" in\nEPSS Data <https://www.first.org/epss/data_stats>."
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Software/lineRange",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Defines the line range in the original host file that the snippet information\napplies to."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://spdx.org/rdf/3/terms/Software/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "lineRange"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://spdx.org/rdf/3/terms/Core/PositiveIntegerRange"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Defines the line range in the original host file that the snippet information\napplies to."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "This field defines the line range in the original host file that the snippet\ninformation applies to.\n\nIf there is a disagreement between the byte range and line range, the byte\nrange values will take precedence.\n\nA range of lines is a convenient reference for those files where there is a\nknown line delimiter.\nThe choice was made to start the numbering of the lines at 1 to be consistent\nwith the W3C pointer method vocabulary."
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Build/Build",
    "@type": [
