    "@id": "_:Na7e597e8fc164f4eba473bc887dc9f11",
    "http://www.w3.org/ns/shacl#hasValue": [
      {
        "@id": "https://spdx.org/rdf/3/terms/Extension/Extension"
      }
    ]
  },
