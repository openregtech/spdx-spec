      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#decimal"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The percentile of the current probability score."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "The percentile between 0 and 1 (0 and 100%) of the current probability score,\nthe proportion of all scored vulnerabilities with the same or a lower\nprobability score. The definition follows \"percentile\" in\nEPSS Data <https://www.first.org/epss/data_stats>."
      }
    ]
  },
