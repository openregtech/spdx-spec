  {
    "@id": "https://spdx.org/rdf/3/terms/SimpleLicensing/customIdToLicense",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Maps a \"LicenseRef-\" string for a custom license or a \"AdditionRef-\" string for\na custom license addition to a CustomLicense, a CustomLicenseAddition, or a\nSimpleLicensingText."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://spdx.org/rdf/3/terms/SimpleLicensing/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "customIdToLicense"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://spdx.org/rdf/3/terms/Core/ElementMap"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Maps a \"LicenseRef-\" string for a custom license or a \"AdditionRef-\" string for\na custom license addition to a CustomLicense, a CustomLicenseAddition, or a\nSimpleLicensingText."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Within a license expression, references can be made to a custom license or a\ncustom license addition.\n\nThe License Expression syntax\ndictates any reference starting with a\n\"LicenseRef-\" or \"AdditionRef-\" refers to license or addition text not found in\nthe official SPDX License List <https://spdx.org/licenses/>.\n\nThe key for the ElementMap is the string used in the license expression\nand the elementValue is the target Element, which must be a CustomLicense,\nCustomLicenseAddition, or SimpleLicensingText.\n\nThe key for the ElementMap shall be matched against the license expression\nin a case-insensitive manner.\nThis is required because the entire license expression string is itself\ncase-insensitive."
      }
    ]
  },
  {
