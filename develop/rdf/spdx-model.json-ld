  {
    "@id": "https://spdx.org/rdf/3/terms/Software/byteRange",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Defines the byte range in the original host file that the snippet information\napplies to."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://spdx.org/rdf/3/terms/Software/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "byteRange"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://spdx.org/rdf/3/terms/Core/PositiveIntegerRange"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Defines the byte range in the original host file that the snippet information\napplies to."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "This field defines the byte range in the original host file that the snippet\ninformation applies to.\n\nA range of bytes is independent of various formatting concerns, and the most\naccurate way of referring to the differences. The choice was made to start the\nnumbering of the byte range at 1 to be consistent with the W3C pointer method\nvocabulary."
      }
    ]
  },
