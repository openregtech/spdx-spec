    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "A ModifyProcess is a process that will result in the alteration of a product, such as a change to its configuration or its location.\n\nRelationship:\n\nFor each ModifyProcess there is at least one /Core/Relationship class or subclass with the relationshipType of 'hasOutput’ on the from and a /Core/Element subclass on the to.\n\nFor each ModifyProcess there is at least one /Core/Relationship class or subclass with the relationshipType of 'hasInput’ on the from and a /Core/Element subclass on the to."
      }
    ],
