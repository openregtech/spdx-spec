  {
    "@id": "https://spdx.org/rdf/3/terms/Core/rationale",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A rationale is supporting information that provides the underlying\njustification or reasoning for an associated element, decision, or process."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://spdx.org/rdf/3/terms/Core/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "rationale"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A rationale is supporting information that provides the underlying\njustification or reasoning for an associated element, decision, or process."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "A rationale is a detailed explanation that documents the logic and intent\nbehind a specific element, decision, or process.\nIt provides the justification for why an item exists or why a particular\nconclusion was reached, often citing evidence, criteria, or analysis methods.\n\nThis context ensures transparency in the decision-making process by accounting\nfor the considerations, risks, or motivations that inform the primary\nstatement."
      }
    ]
  },
