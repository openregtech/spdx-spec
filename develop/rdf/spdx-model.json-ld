      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Property describing a parameter used in an instance of a build."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "parameter is a key-value of a build parameter and its value that\nwas provided to the builder for a build instance, according to the buildType.\n\nThis is different from the environment property in that\nthe key and value are provided as command line arguments or\na configuration file to the builder."
      }
    ]
  },
  {
