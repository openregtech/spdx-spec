      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Agent represents anything with the potential to act on a system."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://spdx.org/rdf/3/terms/Core/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Agent"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://spdx.org/rdf/3/terms/Core/Element"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Agent represents anything with the potential to act on a system."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "The Agent class represents anything that has the potential to act on a system.\n\nThis could be a person, organization, software agent, etc.\n\nThis is not to be confused with tools that are used to perform tasks."
