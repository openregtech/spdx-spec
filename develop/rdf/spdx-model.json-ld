        "@value": "endTime"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#dateTimeStamp"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The point in time when an element or an action ends,\nbecomes no longer applicable, or becomes no longer valid."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "A timestamp marking the conclusion of an action,\nthe ending of an element's relevance,\nor the intended or unintended termination of either.\n\nIt encompasses the moment of completion or cessation of processes,\nsuch as build finishes, service shutdowns, or system failures,\nas well as the point in time when an element\nor a relationship between elements becomes deprecated, expired,\nterminated, or inactive."
      }
    ]
  },
