      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "An actual alteration of a product."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "A ModifyAction is an action that alters a product, such as a change to its configuration or its location.\n\nRelationship:\n\nFor each ModifyAction there is at least one /Core/Relationship class or subclass with the relationshipType of hasOutput on the from and a /Core/Element subclass on the to.\n\nFor each ModifyAction there is at least one /Core/Relationship class or subclass with the relationshipType of performedBy on the from and a /Core/Element subclass on the to."
      }
    ],
