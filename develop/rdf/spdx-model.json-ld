      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Records if sensitive personal information is used during model training or\ncould be used during the inference."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Notes if sensitive personal information is used in the training or inference of\nthe AI models.\n\nThis can include biometric data, addresses or other data that can be used to\ninfer a person's identity.\n\nRelated: hasSensitivePersonalInformation in /Dataset/DatasetPackage"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Core/roleQualification",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "roleQualification specifies the requirements, criteria, or conditions that must be met for an entity to be considered qualified to fulfill a particular role."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://spdx.org/rdf/3/terms/Core/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "roleQualification"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://spdx.org/rdf/3/terms/Core/Requirement"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "roleQualification specifies the requirements, criteria, or conditions that must be met for an entity to be considered qualified to fulfill a particular role."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "roleQualification is an object property that links a Role to one or more Requirement elements.\nIt defines the qualifications—educational, experiential, certification, or competency-based—that an entity must possess to be considered capable of performing the responsibilities associated with the role."
      }
    ]
  },
