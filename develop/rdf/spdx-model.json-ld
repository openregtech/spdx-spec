    "http://www.w3.org/ns/shacl#message": [
      {
        "@language": "en",
        "@value": "https://spdx.org/rdf/3/terms/SupplyChain/CreateProcess is abstract and must not be instantiated directly."
      }
    ],
    "http://www.w3.org/ns/shacl#not": [
      {
        "@id": "_:N6d91a582016846e9b94ca17a246b30dd"
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#type"
      }
    ]
  },
