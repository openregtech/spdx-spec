  {
    "@id": "https://spdx.org/rdf/3/terms/Core/isoAutomationLevel",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "ISO level of automation."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://spdx.org/rdf/3/terms/Core/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "isoAutomationLevel"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://spdx.org/rdf/3/terms/Core/IsoAutomationLevel"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "ISO level of automation."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "The level of automation describes a spectrum of system capability, defining\nthe degree of control and decision-making authority a system possesses\nrelative to an external control.\n\nThis classification helps to define the roles and responsibilities of both the\nhuman operator and the automated system. It is a critical component for risk\nassessment, regulatory compliance, and user interface design."
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Core/identifierLocator",
