    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Describes a relationship between one or more elements."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "A Relationship is a grouping of characteristics unique to an assertion\nthat one Element is related to one or more other Elements in some way.\n\nTo explicitly assert that no such relationships exist, the to property\nshall contain the NoneElement individual and no other elements.\n\nA relationship that contains NoneElement and additional elements in the to\nproperty is not valid.\n\nTo explicitly assert that no assertions are being made regarding the\nexistence of such relationships, the to property shall contain the\nNoAssertionElement individual."
      }
    ],
