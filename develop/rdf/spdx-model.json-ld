  {
    "@id": "https://spdx.org/rdf/3/terms/Core/ElementCollection",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class",
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A collection of Elements, not necessarily with unifying context."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://spdx.org/rdf/3/terms/Core/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "ElementCollection"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://spdx.org/rdf/3/terms/Core/Element"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A collection of Elements, not necessarily with unifying context."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "An ElementCollection is a collection of Elements, not necessarily with unifying\ncontext.\n\nAll ElementCollections shall conform to the Core profile even if the\nCore profile is not specified in the profileConformance property.\n\nIf the profileConformance property is not provided, it shall be evaluated as\na list containing the \"core\" profile identifier.\n\nThe inclusion of a profile identifier within the profileConformance property\nshall constitute a declaration that all constituent elements conform to the\nrestrictions specified by that profile.\n\n*Constraints*\n\n- If the ElementCollection has at least 1 element, it shall also have at least\n  1 rootElement.\n- The element shall not be of type SpdxDocument.\n- The rootElement shall not be of type SpdxDocument."
      }
    ],
    "http://www.w3.org/ns/shacl#nodeKind": [
      {
        "@id": "http://www.w3.org/ns/shacl#IRI"
      }
    ],
