      {
        "@language": "en",
        "@value": "score"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#decimal"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Provides a numerical (0-10) representation of the severity of a vulnerability."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "The score provides information on the severity of a vulnerability per the\nCommon Vulnerability Scoring System as defined by\nForum of Incident Response and Security Teams <https://www.first.org/cvss/>."
      }
    ]
  },
  {
