["https://spdx.org/rdf/3/terms/Core/SpecificationType/other", "http://www.w3.org/2000/01/rdf-schema#comment", "Any specification that does not fall under any of the other entries.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:N0b753b81275c4112b8b043288c01b98f", "http://www.w3.org/1999/02/22-rdf-syntax-ns#rest", "_:N2e18a90b10e1487ead95efb3a8fd6146", "localId", "", ""]
["https://spdx.org/rdf/3/terms/Operations/ExportControlClassification", "http://www.w3.org/2004/02/skos/core#note", "Assessment of an Element for export control classification\naccording to the classification schema of one or multiple countries.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/RoleRelationship", "http://www.w3.org/2000/01/rdf-schema#comment", "RoleRelationship represents a relationship between an entity holding a role and the scope or context in which that role applies. The givenRole property specifies the role assigned.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:N532576b1b5764b75903d5d23804a1f6a", "http://www.w3.org/1999/02/22-rdf-syntax-ns#rest", "_:Nc349747340e44bb494d1b214b04a290e", "localId", "", ""]
["https://spdx.org/rdf/3/terms/Dataset/confidentialityLevel", "http://www.w3.org/2004/02/skos/core#note", "Describes the levels of confidentiality of the data points contained in the dataset.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Software/SoftwarePurpose/application", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "https://spdx.org/rdf/3/terms/Software/SoftwarePurpose", "globalId", "", ""]
