["https://spdx.org/rdf/3.1/terms/Hardware/Hardware", "http://www.w3.org/2004/02/skos/core#note", "A hardware artifact is a distinct unit related to hardware.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/Core/RelationshipType/resolved", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "http://www.w3.org/2002/07/owl#NamedIndividual", "globalId", "", ""]
