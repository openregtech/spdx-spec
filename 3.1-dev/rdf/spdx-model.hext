["https://spdx.org/rdf/3/terms/Core/ExternalRefType/x509Cert", "http://www.w3.org/2004/02/skos/core#definition", "A reference to an X.509 certificate as defined in RFC 1422 <https://datatracker.ietf.org/doc/rfc1422/>. The media type shall be one of application/x-x509-ca-cert or application/x-x509-user-cert.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/AI/energyQuantity", "http://www.w3.org/2000/01/rdf-schema#label", "energyQuantity", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/doi", "http://www.w3.org/2000/01/rdf-schema#comment", "Digital Object Identifier (DOI) <https://www.doi.org/the-identifier/what-is-a-doi/> is a unique, ISO 26324 <https://www.iso.org/standard/88862.html>-standardized identifier for physical, digital, or abstract objects, formatted as a prefix and suffix separated by a forward slash (e.g., 10.1000/182).", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
