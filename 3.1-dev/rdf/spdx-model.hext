["https://spdx.org/rdf/3.1/terms/Dataset/dataCollectionProcess", "http://www.w3.org/2004/02/skos/core#note", "A free-form text that describes how a dataset was collected.\n\nExamples include the sources from which a dataset was scrapped and\nthe interview protocol that was used for data collection.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/FunctionalSafety/VerificationType/demonstration", "http://www.w3.org/2000/01/rdf-schema#comment", "Demonstrating and monitoring or recording that the item under verification to confirm that a requirement is met by the item under verification.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/Core/builtTime", "http://www.w3.org/2000/01/rdf-schema#comment", "Specifies the time an artifact was built.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
