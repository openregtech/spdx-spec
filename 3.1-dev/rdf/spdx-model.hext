["https://spdx.org/rdf/3.1/terms/Core/created", "http://www.w3.org/2004/02/skos/core#note", "Created is a date that identifies when the Element was originally created.\n\nThe time stamp can serve as an indication as to whether the analysis needs to\nbe updated.\n\nThis is often the date of last change (e.g., a git commit date), not the date\nwhen the SPDX data was created, as doing so supports reproducible builds.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/Software/ContentIdentifierType/swhid", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "https://spdx.org/rdf/3.1/terms/Software/ContentIdentifierType", "globalId", "", ""]
["https://spdx.org/rdf/3.1/terms/Core/PositiveIntegerRange", "http://www.w3.org/2000/01/rdf-schema#comment", "A tuple of two positive integers that define a range.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/AI/EnergyUnitType/kilowattHour", "http://www.w3.org/2004/02/skos/core#definition", "Kilowatt-hour.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/FunctionalSafety/EvaluationResultType/pass", "http://www.w3.org/2000/01/rdf-schema#comment", "Indicates a successful evaluation where the requirement or condition is clearly met.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
