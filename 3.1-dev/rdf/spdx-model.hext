["_:N93674e0911c842068c21f00867f3fbb5", "http://www.w3.org/ns/shacl#class", "https://spdx.org/rdf/3/terms/Core/Agent", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Core/quantity", "http://www.w3.org/2004/02/skos/core#note", "Quantity is a property that defines the count, multitude or magnitude.\n\nExpress it as an xsd:decimal whenever possible.\nIf it is not an xsd:decimal, place the notation being used in the parent element's comment field.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Operations/Project", "http://www.w3.org/2000/01/rdf-schema#isDefinedBy", "https://spdx.org/rdf/3/terms/Operations/", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Core/processReadiness", "http://www.w3.org/2004/02/skos/core#note", "Draft, active, obsolete or other are used to define the readiness of a proceedure.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Security/VexJustificationType/vulnerableCodeCannotBeControlledByAdversary", "http://www.w3.org/2004/02/skos/core#definition", "The vulnerable component is present, and the component contains the vulnerable code. However, vulnerable code is used in such a way that an attacker cannot mount any anticipated attack.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/RelationshipType/hasRoleIn", "http://www.w3.org/2004/02/skos/core#definition", "The from Element has a role in the to Element. The use of the hasRoleIn is constrained to RoleRelationship classed relationships.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/swid", "http://www.w3.org/2000/01/rdf-schema#isDefinedBy", "https://spdx.org/rdf/3/terms/Core/", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Core/ExternalRefType/chat", "http://www.w3.org/2004/02/skos/core#definition", "A reference to the instant messaging system used by the maintainer for a package.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/AI/inferenceEnergyConsumption", "http://www.w3.org/2000/01/rdf-schema#comment", "Energy consumed during inference time by an AI model\nthat is being used in the AI system.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Security/CvssSeverityType/critical", "http://www.w3.org/2000/01/rdf-schema#label", "critical", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Security/decisionType", "http://www.w3.org/2000/01/rdf-schema#comment", "Provide the enumeration of possible decisions in the\nStakeholder-Specific Vulnerability Categorization (SSVC) decision tree <https://www.cisa.gov/stakeholder-specific-vulnerability-categorization-ssvc>.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
