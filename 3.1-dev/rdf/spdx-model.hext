["https://spdx.org/rdf/3.1/terms/SupplyChain/plannedInspectionLocation", "http://www.w3.org/2004/02/skos/core#note", "This is the property of the storage class that defines a planned location related to the inspection of a good, product or material.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:Nc82107e7deef41769f4c1d3980f5adb9", "http://www.w3.org/1999/02/22-rdf-syntax-ns#first", "https://spdx.org/rdf/3.1/terms/Software/Package", "globalId", "", ""]
["https://spdx.org/rdf/3.1/terms/Core/RelationshipType/hasOutput", "http://www.w3.org/2000/01/rdf-schema#comment", "The from Build, DefinedProcess or Action element generates each to Element as an output.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/Core/Agent", "http://www.w3.org/2004/02/skos/core#note", "The Agent class represents anything that has the potential to act on a system.\n\nThis could be a person, organization, software agent, etc.\n\nThis is not to be confused with tools that are used to perform tasks.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
