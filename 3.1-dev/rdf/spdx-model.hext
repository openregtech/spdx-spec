["https://spdx.org/rdf/3.1/terms/Security/VexJustificationType/vulnerableCodeNotPresent", "http://www.w3.org/2004/02/skos/core#definition", "The product is not affected because the code underlying the vulnerability is not present in the product.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/Core/suppliedBy", "http://www.w3.org/2004/02/skos/core#definition", "Identifies who or what supplied the artifact or VulnAssessmentRelationship\nreferenced by the Element.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/Core/name", "http://www.w3.org/2000/01/rdf-schema#label", "name", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/Core/created", "http://www.w3.org/2004/02/skos/core#definition", "Identifies when the Element was originally created.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
