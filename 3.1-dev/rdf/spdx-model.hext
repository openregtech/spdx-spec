["https://spdx.org/rdf/3.1/terms/Core/SpecificationType/specification", "http://www.w3.org/2000/01/rdf-schema#comment", "A specification is a detailed document (or set of documents) that describes the requirements, design, behavior, or other characteristics of a system, component, or process so that all stakeholders have a clear, unambiguous reference.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/Core/RelationshipType/other", "http://www.w3.org/2000/01/rdf-schema#label", "other", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/Core/devLifecycleStage", "http://www.w3.org/2004/02/skos/core#note", "The development lifecycle stage specifies the phase or phases of a product\u2019s lifecycle to which a given requirement applies. These may include requirements that govern the design phase, guide development activities, define constraints for the build environment, provide instructions for the decommissioning phase, etc.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/Security/ExploitCatalogVulnAssessmentRelationship", "http://www.w3.org/2000/01/rdf-schema#subClassOf", "https://spdx.org/rdf/3.1/terms/Security/VulnAssessmentRelationship", "globalId", "", ""]
["https://spdx.org/rdf/3.1/terms/FunctionalSafety/VerificationType/analysis", "http://www.w3.org/2004/02/skos/core#definition", "Analytical evaluating of data, designs, or processes methodically to verify correctness against standards or expectations. Typical analysis methods are FMEA, FTA, STPA, static analysis for MISRA compliance etc.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/ExpandedLicensing/LicenseAddition", "http://www.w3.org/2004/02/skos/core#note", "A LicenseAddition represents text which is intended to be added to a License\nas additional text, but which is not itself intended to be a standalone\nLicense.\n\nIt may be an exception which is listed on the\nSPDX License Exceptions <https://spdx.org/licenses/exceptions-index.html>\n(ListedLicenseException), or may be any other additional text (as an exception\nor otherwise) which is defined by an SPDX data creator (CustomLicenseAddition).", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/Core/SupportType", "http://www.w3.org/2000/01/rdf-schema#isDefinedBy", "https://spdx.org/rdf/3.1/terms/Core", "globalId", "", ""]
