["_:N2a7784d6e753465d8f286bec7067ce5c", "http://www.w3.org/ns/shacl#not", "_:Nfbfeb569c5404a50b40cbf22c2bad970", "localId", "", ""]
["https://spdx.org/rdf/3/terms/ExpandedLicensing/OrLaterOperator", "http://www.w3.org/2004/02/skos/core#note", "An OrLaterOperator indicates that this portion of the AnyLicenseInfo\nrepresents either (1) the specified version of the corresponding License, or\n(2) any later version of that License. It is represented in the SPDX License\nExpression Syntax by the + operator.\n\nIt is context-dependent, and unspecified by SPDX, as to what constitutes a\n\"later version\" of any particular License. Some Licenses may not be versioned,\nor may not have clearly-defined ordering for versions. The consumer of SPDX\ndata will need to determine for themselves what meaning to attribute to a\n\"later version\" operator for a particular License.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/AI/EnergyUnitType/megajoule", "http://www.w3.org/2004/02/skos/core#definition", "Megajoule.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/FunctionalSafety/VerificationType/test", "http://www.w3.org/2000/01/rdf-schema#comment", "Conducting controlled tests, experiments or simulations to verify that specific requirements regarding performance, functionality, robustness, etc. are met.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:N7d1f7b6073be4792bde950e3c941269c", "http://www.w3.org/1999/02/22-rdf-syntax-ns#first", "https://spdx.org/rdf/3/terms/SupplyChain/TransportProcess", "globalId", "", ""]
