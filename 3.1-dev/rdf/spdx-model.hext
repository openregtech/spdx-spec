["https://spdx.org/rdf/3.1/terms/SupplyChain/boundaryParameter", "http://www.w3.org/2000/01/rdf-schema#label", "boundaryParameter", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/ExpandedLicensing/obsoletedBy", "http://www.w3.org/2004/02/skos/core#note", "An obsoletedBy value for a deprecated License or LicenseAddition specifies\nthe licenseId of the replacement License or LicenseAddition that is preferred\nto be used in its place. It shall use the same format as specified for a\nlicenseId.\n\nThe License's or LicenseAddition's comment value may include more information\nabout the reason why the licenseId specified in the obsoletedBy value is\npreferred.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
