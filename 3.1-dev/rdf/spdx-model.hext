["_:Nb8afeb4419e148a8a09a7c7267c9bbec", "http://www.w3.org/1999/02/22-rdf-syntax-ns#first", "https://spdx.org/rdf/3.1/terms/SupplyChain/InstantiateVirtualHardwareProcess", "globalId", "", ""]
["https://spdx.org/rdf/3.1/terms/SupplyChain/AssemblyAction", "http://www.w3.org/2004/02/skos/core#note", "AssemblyAction refers to the process of constructing a product by putting together various components. These actions can vary depending on the purpose and requirements. In this context, the assembled product is typically designed to allow for disassembly.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/Dataset/ConfidentialityLevelType/red", "http://www.w3.org/2004/02/skos/core#definition", "Data points in the dataset are highly confidential and can only be shared with named recipients.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
