["https://spdx.org/rdf/3.1/terms/FunctionalSafety/EvidenceRelationship", "http://www.w3.org/2004/02/skos/core#definition", "EvidenceRelationship defines the association between pieces of evidence and EvaluationResult.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/Software/contentIdentifierValue", "http://www.w3.org/2004/02/skos/core#definition", "Specifies the value of the content identifier.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/Core/ExternalRefType/riskAssessment", "http://www.w3.org/2000/01/rdf-schema#isDefinedBy", "https://spdx.org/rdf/3.1/terms/Core", "globalId", "", ""]
