["https://spdx.org/rdf/3.1/terms/Extension/cdxPropName", "http://www.w3.org/2004/02/skos/core#note", "A cdxPropName is used in a CdxPropertyEntry name-value pair.\n\nUnlike key-value stores, properties in CdxPropertiesExtension support duplicate\nnames, each potentially having different values.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:Nedbf4271a8bc48c3aeead5ff19ffe793", "http://www.w3.org/ns/shacl#maxCount", "1", "http://www.w3.org/2001/XMLSchema#integer", "", ""]
["https://spdx.org/rdf/3.1/terms/FunctionalSafety/assumptionStatement", "http://www.w3.org/2004/02/skos/core#definition", "A text describing the design constraint defined by the assumption.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/Software/primaryPurpose", "http://www.w3.org/2004/02/skos/core#note", "primaryPurpose provides information about the primary purpose of the software\nartifact.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/Core/Element", "http://www.w3.org/2000/01/rdf-schema#label", "Element", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/FunctionalSafety/VerificationType/inspection", "http://www.w3.org/2000/01/rdf-schema#comment", "A thorough examination or checking of documentation, records, processes, or systems to confirm compliance or adherence. An inspection needs to have a defined set of acceptance criteria (e.g. a checklist), a documentation of roles involved in the inspection (e.g. to document the inspector's independence) and a clear documentation of when and how it was performed.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/Software/SbomType/design", "http://www.w3.org/2004/02/skos/core#definition", "SBOM of intended, planned software project or product with included components (some of which may not yet exist) for a new software artifact.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/Core/SpdxDocument", "http://www.w3.org/ns/shacl#property", "_:Nae2c4e289769474794c3356ac6babc98", "localId", "", ""]
