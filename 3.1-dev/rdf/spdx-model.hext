["https://spdx.org/rdf/3/terms/Dataset/dataCollectionProcess", "http://www.w3.org/2004/02/skos/core#note", "A free-form text that describes how a dataset was collected.\n\nExamples include the sources from which a dataset was scrapped and\nthe interview protocol that was used for data collection.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:Nfec9684b29ff4212b3607d694651f470", "http://www.w3.org/ns/shacl#minCount", "1", "http://www.w3.org/2001/XMLSchema#integer", "", ""]
["_:N7df04a4972e246a18b64ed2fd91c58a3", "http://www.w3.org/ns/shacl#maxCount", "1", "http://www.w3.org/2001/XMLSchema#integer", "", ""]
["https://spdx.org/rdf/3/terms/SimpleLicensing/customIdToUri", "http://www.w3.org/2004/02/skos/core#note", "Within a License Expression, references can be made to a Custom License or a\nCustom License Addition.\n\nThe License Expression syntax\ndictates any reference starting with a\n\"LicenseRef-\" or \"AdditionRef-\" refers to license or addition text not found in\nthe official SPDX License List <https://spdx.org/licenses/>.\n\nThese custom licenses shall be a CustomLicense, a CustomLicenseAddition, or a\nSimpleLicensingText which are identified with a unique URI identifier.\n\nThe key for the DictionaryEntry is the string used in the license expression\nand the value is the URI for the corresponding CustomLicense,\nCustomLicenseAddition, or SimpleLicensingText.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/countyCode", "http://www.w3.org/2000/01/rdf-schema#comment", "A code that identifies a county.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:Nc8af1e27e8b74941bc2a3ee88029f063", "http://www.w3.org/ns/shacl#path", "https://spdx.org/rdf/3/terms/Core/verifiedUsing", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Core/IndividualElement", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "http://www.w3.org/ns/shacl#NodeShape", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/SupplyChain/transportRoute", "http://www.w3.org/2004/02/skos/core#note", "A transport route is the path taken by people, products, goods, data or resources. Transport routes vary by product type, safety requirements, business constraints or other factors.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/RelationshipType/hasDistributionArtifact", "http://www.w3.org/2000/01/rdf-schema#comment", "The from Element is distributed as an artifact in each to Element (e.g. an RPM or archive file).", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
