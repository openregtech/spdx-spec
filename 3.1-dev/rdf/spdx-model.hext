["https://spdx.org/rdf/3.1/terms/Core/RelationshipType/fixedBy", "http://www.w3.org/2004/02/skos/core#definition", "Designates a from Vulnerability has been fixed by the to Agent(s).", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/Core/IsoAutomationLevel/highAutomation", "http://www.w3.org/2004/02/skos/core#definition", "Level 4 - High automation. The system performs parts of its mission without external intervention.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/Security/publishedTime", "http://www.w3.org/2004/02/skos/core#definition", "Specifies the time when a vulnerability was published.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/AI/useSensitivePersonalInformation", "http://www.w3.org/2004/02/skos/core#note", "Notes if sensitive personal information is used in the training or inference of\nthe AI models.\n\nThis can include biometric data, addresses or other data that can be used to\ninfer a person's identity.\n\nRelated: hasSensitivePersonalInformation in /Dataset/DatasetPackage", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
