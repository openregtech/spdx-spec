# https://spdx.org/rdf/3.1/terms/Core/intendedUse node510
node510 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>intendedUse</B></td></tr><tr><td href='https://spdx.org/rdf/3.1/terms/Core/intendedUse' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3.1/terms/Core/intendedUse</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;The intendedUse property is designed to capture a summary of how or for what item or artifact is meant to be used for.&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;The intendedUse property is designed to capture a summary of how or for what item or artifact is meant to be used for.&quot;@en</td></tr><tr><td align='left'>skos:note</td><td align='left'>&quot;The intendedUse field allows users to enter a free-form textual description outlining the scope and boundaries of appropriate or intended applications for the item or artifact.&quot;@en</td></tr></table> > ] 
