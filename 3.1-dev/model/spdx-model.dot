# https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/nli node759
node759 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>nli</B></td></tr><tr><td href='https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/nli' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/nli</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Natural Location Identifier (NLI) &lt;https://eccma.org/enli-eccma-natural-location-identifier/&gt; is a 14- or 15-character alphanumeric string standardized by ISO 8000-118 &lt;https://www.iso.org/standard/85428.html&gt; that uniquely identifies a three-dimensional geographic point location. The identifier is generated from geodetic coordinates and elevation data. For electronic storage, the ISO.NLI: prefix shall be retained (e.g., ISO.NLI:41TS8M-A8ELTQ-H2).&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;Natural Location Identifier (NLI) &lt;https://eccma.org/enli-eccma-natural-location-identifier/&gt; is a 14- or 15-character alphanumeric string standardized by ISO 8000-118 &lt;https://www.iso.org/standard/85428.html&gt; that uniquely identifies a three-dimensional geographic point location. The identifier is generated from geodetic coordinates and elevation data. For electronic storage, the ISO.NLI: prefix shall be retained (e.g., ISO.NLI:41TS8M-A8ELTQ-H2).&quot;@en</td></tr></table> > ] 
# https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/ibrn node760
node760 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>ibrn</B></td></tr><tr><td href='https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/ibrn' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/ibrn</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;International Business Registration Number (IBRN) &lt;https://ekys.org/business_identifiers/&gt; is a unique identifier for legal entities standardized by ISO 8000-116 &lt;https://www.iso.org/standard/75117.html&gt;. It is composed of two parts: a jurisdiction prefix and a local authoritative legal entity identifier (ALEI), separated by a colon. The prefix contains an ISO 3166 country code, an optional subdivision code, and a register code (e.g., US-DE.BER:3031657).&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;International Business Registration Number (IBRN) &lt;https://ekys.org/business_identifiers/&gt; is a unique identifier for legal entities standardized by ISO 8000-116 &lt;https://www.iso.org/standard/75117.html&gt;. It is composed of two parts: a jurisdiction prefix and a local authoritative legal entity identifier (ALEI), separated by a colon. The prefix contains an ISO 3166 country code, an optional subdivision code, and a register code (e.g., US-DE.BER:3031657).&quot;@en</td></tr></table> > ] 
