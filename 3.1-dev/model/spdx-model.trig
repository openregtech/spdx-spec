        skos:definition "The location for picking up a package or item."@en ;
        skos:note "This is the designated location for pickup of an item."@en .

    ns8:pickupLocation a owl:ObjectProperty ;
        rdfs:label "pickupLocation"@en ;
        rdfs:comment "The location for picking up a package or item."@en ;
        rdfs:isDefinedBy spdx-supplychain: ;
