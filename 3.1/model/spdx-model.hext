["https://spdx.org/rdf/3/terms/ExpandedLicensing/licenseXml", "http://www.w3.org/2004/02/skos/core#note", "The license XML format is defined and used by the SPDX legal team.\n\nThe formal schema definition is available at\nSPDX License List XML Schema <https://github.com/spdx/license-list-XML/blob/v3.25.0/schema/ListedLicense.xsd>.\n\nFor a text description of the XML fields, see\nXML template fields <https://github.com/spdx/license-list-XML/blob/v3.25.0/DOCS/xml-fields.md>.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/postOfficeBoxNumber", "http://www.w3.org/2000/01/rdf-schema#comment", "The number that identifies a PO box. A PO box is a box in a post office or other postal service location assigned to an organization where postal items may be kept.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Security/CvssV2VulnAssessmentRelationship", "http://www.w3.org/2000/01/rdf-schema#comment", "Provides a CVSS version 2.0 assessment for a vulnerability.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
