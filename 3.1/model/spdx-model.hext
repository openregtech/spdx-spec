["https://spdx.org/rdf/3/terms/Core/streetAddress", "http://www.w3.org/2004/02/skos/core#note", "Street address includes a street number, name and unit ID to identify a specific street.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
