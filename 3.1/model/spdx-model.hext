["https://spdx.org/rdf/3/terms/Hardware/partNumber", "http://www.w3.org/2004/02/skos/core#note", "Product Part Number as defined by manufacturer. Can be used for an SKU.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
