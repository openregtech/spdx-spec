["https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/nli", "http://www.w3.org/2004/02/skos/core#definition", "Natural Location Identifier (NLI) <https://eccma.org/enli-eccma-natural-location-identifier/> is a 14- or 15-character alphanumeric string standardized by ISO 8000-118 <https://www.iso.org/standard/85428.html> that uniquely identifies a three-dimensional geographic point location. The identifier is generated from geodetic coordinates and elevation data. For electronic storage, the ISO.NLI: prefix shall be retained (e.g., ISO.NLI:41TS8M-A8ELTQ-H2).", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Dataset/DatasetType/timeseries", "http://www.w3.org/2004/02/skos/core#definition", "Data is recorded in an ordered sequence of timestamped entries, such as the price of a stock over the course of a day.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Security/ExploitCatalogType", "http://www.w3.org/2000/01/rdf-schema#isDefinedBy", "https://spdx.org/rdf/3/terms/Security/", "globalId", "", ""]
