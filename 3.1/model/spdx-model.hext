["https://spdx.org/rdf/3/terms/Core/ExternalRefType/altDownloadLocation", "http://www.w3.org/2000/01/rdf-schema#comment", "A reference to an alternative download location.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
