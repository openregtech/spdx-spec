["https://spdx.org/rdf/3/terms/Security/assessedElement", "http://www.w3.org/2000/01/rdf-schema#comment", "Specifies an Element contained in a piece of software where a vulnerability was\nfound.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/comment", "http://www.w3.org/2000/01/rdf-schema#comment", "Provide consumers with comments by the creator of the Element about the\nElement.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
