["https://spdx.org/rdf/3/terms/Core/RelationshipType/hasOutput", "http://www.w3.org/2000/01/rdf-schema#comment", "The from /Build/Build, DefinedProcess or Action element generates each to Element as an output.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/FunctionalSafety/evidenceCategory", "http://www.w3.org/2004/02/skos/core#note", "evidenceCategory refers to a category of documented or observable proof\nused to verify compliance, qualification, or performance.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
