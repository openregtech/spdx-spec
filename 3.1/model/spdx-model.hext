["_:Nfda6eb9fdd4e434ab798b9ead6e883de", "http://www.w3.org/1999/02/22-rdf-syntax-ns#rest", "http://www.w3.org/1999/02/22-rdf-syntax-ns#nil", "globalId", "", ""]
