["https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/packageUrl", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "http://www.w3.org/2002/07/owl#NamedIndividual", "globalId", "", ""]
["_:N3111d94e47e7474baee71914b0a2bb07", "http://www.w3.org/ns/shacl#path", "https://spdx.org/rdf/3/terms/Core/from", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/FunctionalSafety/VerificationType/analysis", "http://www.w3.org/2000/01/rdf-schema#comment", "Analytical evaluating of data, designs, or processes methodically to verify correctness against standards or expectations. Typical analysis methods are FMEA, FTA, STPA, static analysis for MISRA compliance etc.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:N571134e1f13c47e290af338debb2771d", "http://www.w3.org/ns/shacl#maxCount", "1", "http://www.w3.org/2001/XMLSchema#integer", "", ""]
["https://spdx.org/rdf/3/terms/ExpandedLicensing/IndividualLicensingInfo", "http://www.w3.org/2000/01/rdf-schema#comment", "A concrete subclass of AnyLicenseInfo used by Individuals in the\nExpandedLicensing profile.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:N3062f4387af449b49c75b6496bca2f82", "http://www.w3.org/ns/shacl#property", "_:Nf05466a505f046aaaf2eeb76675d4d56", "localId", "", ""]
["_:N57fd3fdb14a042798a0a1a6399745a1a", "http://www.w3.org/1999/02/22-rdf-syntax-ns#rest", "_:N00d02d95df9d4a88a30608f7e610b25c", "localId", "", ""]
["https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/isbn", "http://www.w3.org/2004/02/skos/core#definition", "International Standard Book Number (ISBN) <https://www.isbn-international.org/content/isbn-users-manual/29> is a unique numeric identifier for monographic publications standardized by ISO 2108 <https://www.iso.org/standard/65483.html>. It consists of either 10 digits (for assignments prior to January 1, 2007) or 13 digits. A 13-digit ISBN is composed of five parts: a GS1 prefix, a registration group, a registrant, a publication element, and a check digit. While elements may be divided by spaces or hyphens for human readability, these separators shall be omitted when the identifier is stored electronically (e.g., 9780198836063).", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/SupplyChain/InspectionProcess", "http://www.w3.org/2004/02/skos/core#note", "Different types of products and services require different types of inspection processes. Your specific inspection process is defined in this process. You can define multiple inspection processes for goods based on requirements.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/description", "http://www.w3.org/2000/01/rdf-schema#comment", "Provides a detailed description of the Element.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/AI/metricDecisionThreshold", "http://www.w3.org/2004/02/skos/core#note", "Each metric can be computed based on a decision threshold.\n\nFor instance, precision or recall is typically computed by checking if the\nprobability of the outcome is larger than 0.5.\n\nEach decision threshold shall match with a metric field defined in the AI\npackage.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/ExpandedLicensing/standardAdditionTemplate", "http://www.w3.org/2000/01/rdf-schema#range", "http://www.w3.org/2001/XMLSchema#string", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/AI/SafetyRiskAssessmentType/high", "http://www.w3.org/2004/02/skos/core#definition", "The second-highest level of risk posed by an AI system.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/RelationshipType/trainedOn", "http://www.w3.org/2000/01/rdf-schema#label", "trainedOn", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/orcidid", "http://www.w3.org/2000/01/rdf-schema#comment", "Open Researcher and Contributor ID (ORCID) iD <https://info.orcid.org/what-is-orcid/> is a unique identifier for authors and contributors in scholarly communication; as a subset of the International Standard Name Identifier (ISNI), it typically appears as a URI such as https://orcid.org/0000-0002-1825-0097.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/gitoid", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "http://www.w3.org/2002/07/owl#NamedIndividual", "globalId", "", ""]
["_:N6ff8bc6eb8cb463aaaca4dd4b5bcdd41", "http://www.w3.org/ns/shacl#hasValue", "https://spdx.org/rdf/3/terms/Core/Element", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Core/RelationshipType/affects", "http://www.w3.org/2000/01/rdf-schema#label", "affects", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:N63eb4144639d44c0a2f14cc1c42ab827", "http://www.w3.org/1999/02/22-rdf-syntax-ns#first", "https://spdx.org/rdf/3/terms/Software/File", "globalId", "", ""]
["_:N584dbe799ca14a06acb977258c0c8414", "http://www.w3.org/ns/shacl#datatype", "http://www.w3.org/2001/XMLSchema#string", "globalId", "", ""]
