["https://spdx.org/rdf/3/terms/Core/validUntilTime", "http://www.w3.org/2000/01/rdf-schema#isDefinedBy", "https://spdx.org/rdf/3/terms/Core/", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Security/vexVersion", "http://www.w3.org/2004/02/skos/core#note", "The statement version default value is zero.\nWhen any VEX-related content changes, the version shall be incremented.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Security/assessedElement", "http://www.w3.org/2004/02/skos/core#note", "Specifies subpackages, files or snippets referenced by a security assessment\nto specify the precise location where a vulnerability was found.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Security/VulnAssessmentRelationship", "http://www.w3.org/ns/shacl#property", "_:N9f5d7daac5fc4d6bbaa187b2aeee587a", "localId", "", ""]
