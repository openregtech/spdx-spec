["https://spdx.org/rdf/3/terms/Software/fileKind", "http://www.w3.org/2000/01/rdf-schema#isDefinedBy", "https://spdx.org/rdf/3/terms/Software/", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/SupplyChain/plannedStorageLocation", "http://www.w3.org/2004/02/skos/core#note", "This is the property of the storage class that defines a planned location related to the storage of a good, product or material.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
