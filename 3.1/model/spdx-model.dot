# https://spdx.org/rdf/3/terms/SupplyChain/DestroyAction node772
node772 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>DestroyAction</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/SupplyChain/DestroyAction' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/SupplyChain/DestroyAction</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;The record of destruction is entered in this action.&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;The record of destruction is entered in this action.&quot;@en</td></tr><tr><td align='left'>skos:note</td><td align='left'>&quot;The action of destroying an element is recorded as part of the DestroyAction. To destroy refers to the act of completely eliminating, or rendering something unusable or irretrievable.&quot;@en</td></tr></table> > ] 
