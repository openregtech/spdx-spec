# https://spdx.org/rdf/3/terms/Hardware/ProductSpecification node1172
node1172 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>ProductSpecification</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Hardware/ProductSpecification' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Hardware/ProductSpecification</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;A product specification (product spec) is a detailed document that outlines the technical, functional, and design requirements of a product.&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;A product specification (product spec) is a detailed document that outlines the technical, functional, and design requirements of a product.&quot;@en</td></tr><tr><td align='left'>skos:note</td><td align='left'>&quot;A product specification (product spec) is a detailed document that outlines the technical, functional, and design requirements of a product. It serves as a guide for engineers, designers, and manufacturers to ensure the final product meets expectations.&quot;@en</td></tr></table> > ] 
