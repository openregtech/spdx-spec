# https://spdx.org/rdf/3/terms/Core/postalName node766
node766 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>postalName</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/postalName' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/postalName</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;The name of the recipient expressed in text.&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;The name of the recipient expressed in text.&quot;@en</td></tr><tr><td align='left'>skos:note</td><td align='left'>&quot;A postal name refers to the official name of a city, town, or locality as recognized by a postal system for mail delivery purposes. It ensures accurate addressing and routing of mail.&quot;@en</td></tr></table> > ] 
# https://spdx.org/rdf/3/terms/SupplyChain/UseProcess node767
node767 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>UseProcess</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/SupplyChain/UseProcess' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/SupplyChain/UseProcess</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Use Process defines actions used by elements.&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;Use Process defines actions used by elements.&quot;@en</td></tr><tr><td align='left'>skos:note</td><td align='left'>&quot;The UseProcess is an abstract class used to define processes that interact with key elements. Plan, state, and inspection processes plus managing boundaries are critical processes used by elements.

Relationship:

For each UseProcess or subclass except the PlanProcess there is at least one /Core/Relationship class or subclass with the relationshipType of &#x27;affects’ on the from and a /Core/Element class or subclass on the to.&quot;@en</td></tr></table> > ] 
# https://spdx.org/rdf/3/terms/Core/UnitOfMeasure node768
node768 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>UnitOfMeasure</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/UnitOfMeasure' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/UnitOfMeasure</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;UnitofMeasure specify information structures through industry standards for Units of Measure, Quantity Kinds, Dimensions and Data Types.&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;UnitofMeasure specify information structures through industry standards for Units of Measure, Quantity Kinds, Dimensions and Data Types.&quot;@en</td></tr><tr><td align='left'>skos:note</td><td align='left'>&quot;The QUDT, or &quot;Quantity, Unit, Dimension and Type&quot; schema defines the base classes properties, and restrictions used for modeling physical quantities, units of measure, and their dimensions in various measurement systems.&quot;@en</td></tr></table> > ] 
# https://spdx.org/rdf/3/terms/Core/ExternalRefType/purchaseOrder node769
node769 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>purchaseOrder</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/ExternalRefType/purchaseOrder' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/ExternalRefType/purchaseOrder</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;A reference to a purchase order for a package.&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;A reference to a purchase order for a package.&quot;@en</td></tr></table> > ] 
# https://spdx.org/rdf/3/terms/SimpleLicensing/AnyLicenseInfo node770
node770 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>AnyLicenseInfo</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/SimpleLicensing/AnyLicenseInfo' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/SimpleLicensing/AnyLicenseInfo</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Abstract class representing a license combination consisting of one or more licenses.&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;Abstract class representing a license combination consisting of one or more licenses.&quot;@en</td></tr><tr><td align='left'>skos:note</td><td align='left'>&quot;AnyLicenseInfo is
an abstract class representing a license combination consisting of one or more
licenses (optionally including additional text), which may be combined
according to the
SPDX license expression syntax.

An AnyLicenseInfo is used by licensing properties of software artifacts.

It can be:

- a NoneLicense;
- a NoAssertionLicense;
- a single license (either on the
  SPDX License List &lt;https://spdx.org/licenses/&gt; or
  a custom-defined license);
- a single license with an &quot;or later&quot; operator applied;
- the foregoing with additional text applied; or
- a set of licenses combined by applying &quot;AND&quot; and &quot;OR&quot; operators recursively.&quot;@en</td></tr></table> > ] 
