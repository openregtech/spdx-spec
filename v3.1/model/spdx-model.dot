# https://spdx.org/rdf/3/terms/Core/Element node92
node92 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Element</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/Element' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/Element</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Base domain class from which all other SPDX 3 domain classes derive.&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;Base domain class from which all other SPDX 3 domain classes derive.&quot;@en</td></tr><tr><td align='left'>skos:note</td><td align='left'>&quot;An Element is a representation of a fundamental concept either directly inherent
to the Bill of Materials (BOM) domain or indirectly related to the BOM domain
and necessary for contextually characterizing BOM concepts and relationships.

Within SPDX 3 structure this is the base class acting as a consistent,
unifying, and interoperable foundation for all explicit
and inter-relatable content objects.&quot;@en</td></tr></table> > ] 
