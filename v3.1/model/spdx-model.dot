node51 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>bom</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Software/SoftwarePurpose/bom' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Software/SoftwarePurpose/bom</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;The Element is a bill of materials.&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;The Element is a bill of materials.&quot;@en</td></tr></table> > ] 
# https://spdx.org/rdf/3/terms/Core/created node52
node52 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>created</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/created' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/created</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Identifies when the Element was originally created.&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;Identifies when the Element was originally created.&quot;@en</td></tr><tr><td align='left'>skos:note</td><td align='left'>&quot;Created is a date that identifies when the Element was originally created.

The time stamp can serve as an indication as to whether the analysis needs to
be updated.

This is often the date of last change (e.g., a git commit date), not the date
when the SPDX data was created, as doing so supports reproducible builds.&quot;@en</td></tr></table> > ] 
