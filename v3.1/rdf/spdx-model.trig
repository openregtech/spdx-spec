  "type": "security_CvssV2VulnAssessmentRelationship",
  "spdxId": "urn:spdx.dev:cvssv2-cve-2020-28498",
  "relationshipType": "hasAssessmentFor",
  "security_score": "4.3",
  "security_vectorString": "AV:N/AC:M/Au:N/C:P/I:N/A:N",
