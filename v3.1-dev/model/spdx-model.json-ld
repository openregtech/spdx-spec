      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "verificationPostcondition"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Verification postcondition that are true immediately after a verification method has been performed"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Verification postcondition are explicit criteria, states, or conditions that are true immediately after a verification method (such as a test, inspection, or analysis) has been performed, confirming the successful execution and complete outcomes of the verification."
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3.1/terms/Build/Build",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class",
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Class that describes a build instance of software/artifacts."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://spdx.org/rdf/3.1/terms/Build"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Build"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://spdx.org/rdf/3.1/terms/Core/Element"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Class that describes a build instance of software/artifacts."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "A build is a representation of the process in which a piece of software or\nartifact is built. It encapsulates information related to a build process and\nprovides an element from which relationships can be created to describe the\nbuild's inputs, outputs, and related entities (e.g. builders, identities,\netc.).\n\nExternalIdentifier of type \"urlScheme\" may be used to identify build logs.\nIn this case, the comment of the ExternalIdentifier shall be \"LogReference\".\n\nNote that startTime and endTime are optional, and may be omitted to\nsimplify creating reproducible builds.\n\nbuildStartTime and buildEndTime are deprecated.\nMigrate to startTime and endTime\nbuildStartTime and buildEndTime will be removed in a future release."
      }
    ],
