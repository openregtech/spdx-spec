    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "A requirement element is a distinct unit that defines an expectation, need, behavior, or design intent of an item that either already exists or is to be created in accordance with this requirement.\n\nA rationale is an additional detail used to define the reason or\njustification for the existence of the requirement.\nThe rationale is usually less formal than the wording of the\nrequirement statement itself."
      }
