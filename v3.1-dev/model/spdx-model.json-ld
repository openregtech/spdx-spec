  {
    "@id": "https://spdx.org/rdf/3.1/terms/Software/packageUrl",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Provides a place for the SPDX data creator to record the package URL string\n(in accordance with the Package URL specification) for a software Package."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://spdx.org/rdf/3.1/terms/Software"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "packageUrl"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#anyURI"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Provides a place for the SPDX data creator to record the package URL string\n(in accordance with the Package URL specification) for a software Package."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "A package URL (commonly pronounced and referred to as \"purl\") is an attempt to standardize package representations\nin order to reliably identify and locate software packages.\nA packageUrl is a URL string which represents a package in a\nmostly universal and uniform way across programming languages, package\nmanagers, packaging conventions, tools, APIs and databases.\n\nA packageUrl is composed of seven components:\n\nscheme:type/namespace/name@version?qualifiers#subpath\n\n\nThe definition for each component can be found in the corresponding\nAnnex of this document.\nKnown type definitions can be found in the\nPackage URL type definitions <https://github.com/package-url/purl-spec/blob/b33dda1cf4515efa8eabbbe8e9b140950805f845/PURL-TYPES.rst>.\n\nComponents are designed such that they form a hierarchy from the most\nsignificant on the left to the least significant components on the right."
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/orcidid",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Open Researcher and Contributor ID (ORCID) iD <https://info.orcid.org/what-is-orcid/> is a unique identifier for authors and contributors in scholarly communication; as a subset of the International Standard Name Identifier (ISNI), it typically appears as a URI such as https://orcid.org/0000-0002-1825-0097."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
