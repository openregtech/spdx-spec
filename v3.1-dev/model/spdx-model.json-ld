    "http://www.w3.org/ns/shacl#message": [
      {
        "@language": "en",
        "@value": "https://spdx.org/rdf/3.1/terms/SupplyChain/CreateProcess is abstract and must not be instantiated directly."
      }
    ],
    "http://www.w3.org/ns/shacl#not": [
