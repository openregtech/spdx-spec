    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "ISO level of automation."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "The level of automation describes a spectrum of system capability, defining\nthe degree of control and decision-making authority a system possesses\nrelative to an external control.\n\nThis classification helps to define the roles and responsibilities of both the\nhuman operator and the automated system. It is a critical component for risk\nassessment, regulatory compliance, and user interface design."
      }
    ]
  },
