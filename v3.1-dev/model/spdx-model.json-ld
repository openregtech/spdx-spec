  {
    "@id": "https://spdx.org/rdf/3.1/terms/Security/actionStatement",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Provides advise on how to mitigate or remediate a vulnerability when a VEX product\nis affected by it."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://spdx.org/rdf/3.1/terms/Security"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "actionStatement"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Provides advise on how to mitigate or remediate a vulnerability when a VEX product\nis affected by it."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "When an element is referenced with a VexAffectedVulnAssessmentRelationship,\nthe relationship shall include one actionStatement that should describe actions\nto remediate or mitigate the vulnerability."
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3.1/terms/AI/standardCompliance",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Standard that an artifact is being complied with."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://spdx.org/rdf/3.1/terms/AI"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "standardCompliance"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Standard that an artifact is being complied with."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "A free-form text that captures a standard that an artifact complies with.\n\nThe standard may, but is not necessarily required to, satisfy a legal or\nregulatory requirement.\n\nIf the artifact is using a standard as a reference or guideline, but not\nnecessarily compliant with it, use the /Core/standardName property instead.\n\nFor a detailed compliance information, please consider defining\na Relationship with \"conformsTo\" relationship type to a Regulation."
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3.1/terms/Core/intendedUse",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The intendedUse property is designed to capture a summary of how or for what item or artifact is meant to be used for."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://spdx.org/rdf/3.1/terms/Core"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "intendedUse"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The intendedUse property is designed to capture a summary of how or for what item or artifact is meant to be used for."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "The intendedUse field allows users to enter a free-form textual description outlining the scope and boundaries of appropriate or intended applications for the item or artifact."
      }
    ]
  },
