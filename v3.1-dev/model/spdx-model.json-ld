      {
        "@id": "https://spdx.org/rdf/3.1/terms/Core/DictionaryEntry"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Property describing the session in which a build is invoked."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "environment is a map of environment variables and values that are set during a\nbuild session, according to the buildType.\n\nThis is different from the parameter property in that it\ndescribes the environment variables set before a build is invoked rather than\nthe variables provided to the builder."
      }
    ]
  },
