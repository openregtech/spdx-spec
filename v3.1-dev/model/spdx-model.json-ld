      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A buildId is a locally unique identifier used by a builder to identify a unique\ninstance of a build produced by it."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "A buildId is a locally unique identifier to identify a unique instance of a\nbuild, according to the buildType.\n\nThis identifier differs based on build toolchain, platform, or naming\nconvention used by an organization or standard."
