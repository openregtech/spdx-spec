  {
    "@id": "https://spdx.org/rdf/3.1/terms/Core/rationale",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A rationale is supporting information that provides the underlying\njustification or reasoning for an associated element, decision, or process."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://spdx.org/rdf/3.1/terms/Core"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "rationale"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A rationale is supporting information that provides the underlying\njustification or reasoning for an associated element, decision, or process."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "A rationale is a detailed explanation that documents the logic and intent\nbehind a specific element, decision, or process.\nIt provides the justification for why an item exists or why a particular\nconclusion was reached, often citing evidence, criteria, or analysis methods.\n\nThis context ensures transparency in the decision-making process by accounting\nfor the considerations, risks, or motivations that inform the primary\nstatement."
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3.1/terms/Security/EpssVulnAssessmentRelationship",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class",
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Provides an EPSS assessment for a vulnerability."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://spdx.org/rdf/3.1/terms/Security"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "EpssVulnAssessmentRelationship"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://spdx.org/rdf/3.1/terms/Security/VulnAssessmentRelationship"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Provides an EPSS assessment for a vulnerability."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "An EpssVulnAssessmentRelationship relationship describes the likelihood or\nprobability that a vulnerability will be exploited in the wild, and the\npercentile ranking of probability relative to all other vulnerabilities' EPSS\nscores, using the Exploit Prediction Scoring System (EPSS) as defined at\nThe EPSS Model <https://www.first.org/epss/model>.\n\n*Constraints*\n\n- The relationship type shall be set to hasAssessmentFor.\n- The probability shall be between 0 and 1.\n- The percentile shall be between 0 and 1.\n\n*Example*\n\n{\n  \"type\": \"security_EpssVulnAssessmentRelationship\",\n  \"spdxId\": \"urn:spdx.dev:epss-CVE-2020-28498\",\n  \"relationshipType\": \"hasAssessmentFor\",\n  \"security_probability\": \"0.00105\",\n  \"security_percentile\": \"0.42356\",\n  \"from\": \"urn:spdx.dev:vuln-cve-2020-28498\",\n  \"to\": [\"urn:product-acme-application-1.3\"],\n  \"suppliedBy\": \"urn:spdx.dev:agent-jane-doe\",\n  \"security_publishedTime\": \"2023-10-05T00:00:30Z\"\n}"
      }
    ],
    "http://www.w3.org/ns/shacl#nodeKind": [
      {
        "@id": "http://www.w3.org/ns/shacl#IRI"
      }
    ],
