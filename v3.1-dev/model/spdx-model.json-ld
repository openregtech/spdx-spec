      {
        "@language": "en",
        "@value": "A PlanAction involves the execution of a plan in relation to a PlanProcess."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://spdx.org/rdf/3.1/terms/SupplyChain"
      }
