  {
    "@id": "https://spdx.org/rdf/3.1/terms/SupplyChain/AssemblyAction",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class",
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "AssemblyAction represents the event of creating a product by assembling individual components."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://spdx.org/rdf/3.1/terms/SupplyChain"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "AssemblyAction"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://spdx.org/rdf/3.1/terms/SupplyChain/CreateAction"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "AssemblyAction represents the event of creating a product by assembling individual components."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "AssemblyAction refers to the process of constructing a product by putting together various components. These actions can vary depending on the purpose and requirements. In this context, the assembled product is typically designed to allow for disassembly."
      }
    ],
    "http://www.w3.org/ns/shacl#nodeKind": [
      {
        "@id": "http://www.w3.org/ns/shacl#IRI"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3.1/terms/SimpleLicensing/AnyLicenseInfo",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class",
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Abstract class representing a license combination consisting of one or more licenses."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://spdx.org/rdf/3.1/terms/SimpleLicensing"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "AnyLicenseInfo"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://spdx.org/rdf/3.1/terms/Core/Element"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Abstract class representing a license combination consisting of one or more licenses."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "AnyLicenseInfo is\nan abstract class representing a license combination consisting of one or more\nlicenses (optionally including additional text), which may be combined\naccording to the\nSPDX license expression syntax.\n\nAn AnyLicenseInfo is used by licensing properties of software artifacts.\n\nIt can be:\n\n- a NoneLicense;\n- a NoAssertionLicense;\n- a single license (either on the\n  SPDX License List <https://spdx.org/licenses/> or\n  a custom-defined license);\n- a single license with an \"or later\" operator applied;\n- the foregoing with additional text applied; or\n- a set of licenses combined by applying \"AND\" and \"OR\" operators recursively."
      }
    ],
    "http://www.w3.org/ns/shacl#nodeKind": [
      {
        "@id": "http://www.w3.org/ns/shacl#IRI"
      }
    ],
    "http://www.w3.org/ns/shacl#property": [
      {
        "@id": "_:Nfd5fd0be89464a0dabc80f698eadfcca"
      }
    ]
  },
  {
    "@id": "_:Nfd5fd0be89464a0dabc80f698eadfcca",
    "http://www.w3.org/ns/shacl#message": [
      {
        "@language": "en",
        "@value": "https://spdx.org/rdf/3.1/terms/SimpleLicensing/AnyLicenseInfo is abstract and must not be instantiated directly."
      }
    ],
    "http://www.w3.org/ns/shacl#not": [
      {
        "@id": "_:N9cb71bfae42e43a2b9e5992a2db9d822"
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#type"
      }
    ]
  },
  {
    "@id": "_:N9cb71bfae42e43a2b9e5992a2db9d822",
    "http://www.w3.org/ns/shacl#hasValue": [
      {
        "@id": "https://spdx.org/rdf/3.1/terms/SimpleLicensing/AnyLicenseInfo"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3.1/terms/Core/ExternalRefType/license",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3.1/terms/Core/ExternalRefType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
