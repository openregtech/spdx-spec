  {
    "@id": "https://spdx.org/rdf/3.1/terms/Core/headquartersLocation",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The headquartersLocation defines the location of the organization's headquarters."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://spdx.org/rdf/3.1/terms/Core"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "headquartersLocation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://spdx.org/rdf/3.1/terms/Core/Location"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The headquartersLocation defines the location of the organization's headquarters."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Headquarters denotes the location where most or all of the important functions of an organization are coordinated. In the United States, the corporate headquarters represents the entity at the center or the top of a corporation taking full responsibility for managing all business activities.\nTo identify an organization's headquarters accurately, you provide address information (mailing, street and GPL) information related to the organization’s headquarters."
      }
    ]
  },
  {
    "@id": "_:Nbda3431b92ce4a4dba7e713030e01ca7",
    "@type": [
