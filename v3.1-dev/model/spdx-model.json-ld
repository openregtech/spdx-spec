    "@id": "https://spdx.org/rdf/3.1/terms/ExpandedLicensing/DisjunctiveLicenseSet",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class",
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Portion of an AnyLicenseInfo representing a set of licensing information where\nonly one of the elements applies."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://spdx.org/rdf/3.1/terms/ExpandedLicensing"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
