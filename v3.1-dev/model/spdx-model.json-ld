    "@id": "https://spdx.org/rdf/3.1/terms/AI/EnergyConsumptionDescription",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class",
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The class that helps note down the quantity of energy consumption and the unit\nused for measurement."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://spdx.org/rdf/3.1/terms/AI"
      }
    ],
