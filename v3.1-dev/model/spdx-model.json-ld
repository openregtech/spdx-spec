    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A license or addition that is not listed on the SPDX License List."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "A SimpleLicensingText represents a License or Addition that is not listed on\nthe SPDX License List <https://spdx.org/licenses>,\nand is therefore defined by an SPDX data creator."
      }
    ],
    "http://www.w3.org/ns/shacl#nodeKind": [
