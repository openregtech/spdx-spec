      {
        "@language": "en",
        "@value": "SBOM generated through analysis of artifacts (e.g., executables, packages, containers, and virtual machine images) after its build. Such analysis generally requires a variety of heuristics. In some contexts, this may also be referred to as a \"3rd party\" SBOM."
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3.1/terms/Operations/Project",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class",
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Temporary endeavor with a beginning and an end and that must be used to create a unique product, service or result."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://spdx.org/rdf/3.1/terms/Operations"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Project"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://spdx.org/rdf/3.1/terms/Core/Bundle"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Temporary endeavor with a beginning and an end and that must be used to create a unique product, service or result."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Temporary endeavor with a beginning and an end and that must be used to create a unique product, service or result.\n\nBased on the Project Management Body of Knowledge (PMBOK), 3rd edition.\n\nstartTime is the time at which a project starts or is planned to start.\nendTime is the time at which a project ends or is planned to end."
      }
    ],
    "http://www.w3.org/ns/shacl#nodeKind": [
      {
        "@id": "http://www.w3.org/ns/shacl#IRI"
      }
    ],
    "http://www.w3.org/ns/shacl#property": [
      {
        "@id": "_:Nefe6eaa252fb4ee1b1f7a08d186226bb"
