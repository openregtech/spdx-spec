["https://spdx.org/rdf/3/terms/Core/SpecificationType/specification", "http://www.w3.org/2004/02/skos/core#definition", "A specification is a detailed document (or set of documents) that describes the requirements, design, behavior, or other characteristics of a system, component, or process so that all stakeholders have a clear, unambiguous reference.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/ExternalRefType/purchaseOrder", "http://www.w3.org/2004/02/skos/core#definition", "A reference to a purchase order for a package.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/devLifecycleStage", "http://www.w3.org/2004/02/skos/core#note", "The development lifecycle stage specifies the phase or phases of a product\u2019s lifecycle to which a given requirement applies. These may include requirements that govern the design phase, guide development activities, define constraints for the build environment, provide instructions for the decommissioning phase, etc.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
