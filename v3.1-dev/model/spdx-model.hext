["https://spdx.org/rdf/3/terms/Core/geographicPointLocation", "http://www.w3.org/2000/01/rdf-schema#comment", "This is a set of point coordinates as defined in by the GPS standard.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
