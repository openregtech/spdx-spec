["https://spdx.org/rdf/3/terms/Core/scope", "http://www.w3.org/2000/01/rdf-schema#comment", "Capture the scope of information about a specific relationship between elements.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/ExpandedLicensing/subjectAddition", "http://www.w3.org/2004/02/skos/core#definition", "A LicenseAddition participating in a 'with addition' model.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/ExternalRefType/dynamicAnalysisReport", "http://www.w3.org/2004/02/skos/core#definition", "A reference to a dynamic analysis report for a package.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
