["https://spdx.org/rdf/3/terms/Hardware/massOfHardware", "http://www.w3.org/2000/01/rdf-schema#label", "massOfHardware", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/isbn", "http://www.w3.org/2004/02/skos/core#definition", "International Standard Book Number (ISBN) <https://www.isbn-international.org/content/isbn-users-manual/29> is a unique numeric identifier for monographic publications standardized by ISO 2108 <https://www.iso.org/standard/65483.html>. It consists of either 10 digits (for assignments prior to January 1, 2007) or 13 digits. A 13-digit ISBN is composed of five parts: a GS1 prefix, a registration group, a registrant, a publication element, and a check digit. While elements may be divided by spaces or hyphens for human readability, these separators shall be omitted when the identifier is stored electronically (e.g., 9780198836063).", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/FunctionalSafety/VerificationType/review", "http://www.w3.org/2000/01/rdf-schema#comment", "A examination or checking of documentation, records, processes, or systems to confirm compliance or adherence with an upper level requirement. Typically done as peer review, offline review or review meeting.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/FunctionalSafety/verificationUID", "http://www.w3.org/2000/01/rdf-schema#label", "verificationUID", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Security/actionStatement", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "http://www.w3.org/2002/07/owl#DatatypeProperty", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Core/Tool", "http://www.w3.org/ns/shacl#nodeKind", "http://www.w3.org/ns/shacl#IRI", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/isil", "http://www.w3.org/2000/01/rdf-schema#comment", "International Standard Identifier for Libraries and Related Organizations (ISIL) <https://slks.dk/english/work-areas/libraries-and-literature/library-standards/isil/> is a unique alphanumeric code for identifying libraries, archives, museums, and related organizations standardized by ISO 15511 <https://www.iso.org/standard/77849.html>. It consists of a prefix\u2014which may be an ISO 3166-1 alpha-2 country code or a non-country code assigned by the ISIL Registration Authority\u2014followed by a unit identifier, totaling up to 16 characters (e.g., FI-Sipoo-S\u00f6 or ZDB-1-SBD). Valid symbols include any alphanumeric character, solidus (/), hyphen-minus (-), or colon.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/RelationshipType/createdBy", "http://www.w3.org/2004/02/skos/core#definition", "The from Action or DefinedProcess is createdBy to Agent(s).", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
