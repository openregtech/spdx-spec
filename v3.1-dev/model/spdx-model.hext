["https://spdx.org/rdf/3/terms/Core/ExternalRefType/buildSystem", "http://www.w3.org/2000/01/rdf-schema#comment", "A reference to a build system used to create or publish the package.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
