["https://spdx.org/rdf/3/terms/Security/ExploitCatalogType/kev", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "http://www.w3.org/2002/07/owl#NamedIndividual", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/SimpleLicensing/licenseText", "http://www.w3.org/2000/01/rdf-schema#range", "http://www.w3.org/2001/XMLSchema#string", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/FunctionalSafety/EvaluationResultType/inconclusive", "http://www.w3.org/2004/02/skos/core#definition", "Inconclusive refers to a result or outcome from a verification, test, or analysis that cannot be clearly classified as either positive (successful, pass) or negative (failed, reject). An inconclusive result means there was not enough clear evidence, data, or signal to make a definitive determination, and further investigation or additional testing is necessary. An inconclusive result always shall need a comment on it.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Software/SoftwarePurpose/container", "http://www.w3.org/2000/01/rdf-schema#isDefinedBy", "https://spdx.org/rdf/3/terms/Software/", "globalId", "", ""]
["_:Ne24b447f92044b68a5f55d15cb5c3d2d", "http://www.w3.org/1999/02/22-rdf-syntax-ns#first", "_:Nf4dbffc688204859bb81e16e72ae310f", "localId", "", ""]
["https://spdx.org/rdf/3/terms/Security/CvssSeverityType/low", "http://www.w3.org/2004/02/skos/core#definition", "When a CVSS score is between 0.1 - 3.9.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/MeasureOfLength", "http://www.w3.org/2000/01/rdf-schema#subClassOf", "https://spdx.org/rdf/3/terms/Core/UnitOfMeasure", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Core/ExternalRefType/vulnerabilityDisclosureReport", "http://www.w3.org/2000/01/rdf-schema#label", "vulnerabilityDisclosureReport", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Software/FileKindType/file", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "https://spdx.org/rdf/3/terms/Software/FileKindType", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/ExpandedLicensing/CustomLicense", "http://www.w3.org/ns/shacl#nodeKind", "http://www.w3.org/ns/shacl#IRI", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Hardware/VirtualHardware", "http://www.w3.org/2004/02/skos/core#note", "A VirtualHardware is a distinct article related to simulation or emulation hardware.\nThis is used to assist in recording \"Digital Twinning\".\n\nAn FPGA simulation of hardware is a VirtualHardware.\nVirtual hardware requires instantiation involving specific hardware and software.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:Nfe98abb372884e84a0144e0aea12fff8", "http://www.w3.org/1999/02/22-rdf-syntax-ns#rest", "_:Nb11504c57e46442b99ecf6c6cd76889c", "localId", "", ""]
