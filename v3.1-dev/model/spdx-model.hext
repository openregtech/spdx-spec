["https://spdx.org/rdf/3/terms/Core/RelationshipType/delegatedTo", "http://www.w3.org/2000/01/rdf-schema#comment", "The from Agent is delegating an action to the Agent of the to Relationship (which shall be of type invokedBy), during a LifecycleScopeType period (e.g. the to invokedBy Relationship is being done on behalf of from).", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:N3ab89c5a60c04e21b6526d271b96f5a0", "http://www.w3.org/1999/02/22-rdf-syntax-ns#rest", "_:N1984000bd66b4e44a271d9a0c2b244ac", "localId", "", ""]
["https://spdx.org/rdf/3/terms/SupplyChain/ReproduceProcess", "http://www.w3.org/2004/02/skos/core#note", "Reproduction is the biological process by which living organisms produce offspring.\n\nIt occurs in plants, animals, and microorganisms.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/HashAlgorithm/sha3_256", "http://www.w3.org/2004/02/skos/core#definition", "SHA-3 with a digest length of 256, as defined in FIPS 202 <https://csrc.nist.gov/pubs/fips/202/final>.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/ProcessReadinessType/other", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "https://spdx.org/rdf/3/terms/Core/ProcessReadinessType", "globalId", "", ""]
["_:N7bf9b6cf66db4c06b3819cdfb5f4cbf1", "http://www.w3.org/ns/shacl#maxCount", "1", "http://www.w3.org/2001/XMLSchema#integer", "", ""]
["https://spdx.org/rdf/3/terms/Core/LifecycleScopeType/test", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "http://www.w3.org/2002/07/owl#NamedIndividual", "globalId", "", ""]
["_:Nb8108c9e0ec147ae9ef7f587e181d0ce", "http://www.w3.org/ns/shacl#class", "https://spdx.org/rdf/3/terms/Operations/Project", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/ibrn", "http://www.w3.org/2000/01/rdf-schema#comment", "International Business Registration Number (IBRN) <https://ekys.org/business_identifiers/> is a unique identifier for legal entities standardized by ISO 8000-116 <https://www.iso.org/standard/75117.html>. It is composed of two parts: a jurisdiction prefix and a local authoritative legal entity identifier (ALEI), separated by a colon. The prefix contains an ISO 3166 country code, an optional subdivision code, and a register code (e.g., US-DE.BER:3031657).", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:N481756439eb0476b821f1f71bf70a383", "http://www.w3.org/ns/shacl#path", "https://spdx.org/rdf/3/terms/AI/metricDecisionThreshold", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/SupplyChain/currentState", "http://www.w3.org/2004/02/skos/core#note", "The state of an object refers to a string assigned to its attributes (or properties) at a given moment in time. The state describes the current condition or behavior of the object.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:N0750f877e780461abc68b91cc074c6a3", "http://www.w3.org/1999/02/22-rdf-syntax-ns#rest", "_:Ne64a06fbbcd648f4b0134cd3cf6f560b", "localId", "", ""]
