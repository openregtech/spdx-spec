["_:Nceaf5b38998f48fdaa4f212523cd9896", "http://www.w3.org/ns/shacl#path", "https://spdx.org/rdf/3/terms/Core/from", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Core/Hash", "http://www.w3.org/2000/01/rdf-schema#label", "Hash", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Software/homePage", "http://www.w3.org/2004/02/skos/core#note", "A homePage is a place for the SPDX document creator to record a website that\nserves as the package's home page.\n\nThis saves the recipient of the SPDX document who is looking for more info from\nhaving to search for and verify a match between the package and the associated\nproject home page.\n\nThis link can also be used to reference further information about the package\nreferenced by the SPDX document creator.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/ExpandedLicensing/isDeprecatedAdditionId", "http://www.w3.org/2000/01/rdf-schema#label", "isDeprecatedAdditionId", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/AI/modelDataPreprocessing", "http://www.w3.org/2004/02/skos/core#note", "A free-form text that describes the preprocessing steps applied to the training\ndata before training of the model(s) contained in the AI software.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:N3424a6639dad4b518802edafe3cdf858", "http://www.w3.org/1999/02/22-rdf-syntax-ns#rest", "_:Nbb15ea837c3449e881caedd983bcdb61", "localId", "", ""]
["https://spdx.org/rdf/3/terms/Core/hashValue", "http://www.w3.org/2000/01/rdf-schema#comment", "The result of applying a hash algorithm to an Element.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:N42f0f176148148648bb4159421a8de5d", "http://www.w3.org/ns/shacl#maxCount", "1", "http://www.w3.org/2001/XMLSchema#integer", "", ""]
