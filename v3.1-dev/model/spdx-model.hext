["https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/hsCodes", "http://www.w3.org/2004/02/skos/core#definition", "The Harmonized System (HS) <https://www.wcoomd.org/en/topics/nomenclature/overview/what-is-the-harmonized-system.aspx> of tariff nomenclature is an internationally standardized system of names and numbers, defined by the World Customs Organization, used to classify traded products.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/Tool", "http://www.w3.org/2004/02/skos/core#definition", "An element of hardware and/or software utilized to carry out a particular function.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:N9147565099f148ac9fec499d35ccf37d", "http://www.w3.org/1999/02/22-rdf-syntax-ns#first", "https://spdx.org/rdf/3/terms/Core/LifecycleScopeType/update", "globalId", "", ""]
