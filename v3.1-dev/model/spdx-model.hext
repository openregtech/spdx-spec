["https://spdx.org/rdf/3/terms/Core/externalIdentifierType", "http://www.w3.org/2004/02/skos/core#note", "An externalIdentifierType specifies the type of the external identifier.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
