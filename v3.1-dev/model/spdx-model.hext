["https://spdx.org/rdf/3/terms/Software/SoftwarePurpose/patch", "http://www.w3.org/2000/01/rdf-schema#label", "patch", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/RelationshipType/reportedBy", "http://www.w3.org/2004/02/skos/core#definition", "Designates a from /Security/Vulnerability was first reported to a project, vendor, or tracking database for formal identification by each to Agent.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/AI/EnergyUnitType/other", "http://www.w3.org/2004/02/skos/core#definition", "Any other units of energy measurement.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/CreationInfo", "http://www.w3.org/2000/01/rdf-schema#isDefinedBy", "https://spdx.org/rdf/3/terms/Core/", "globalId", "", ""]
["_:N0d4a4e192eff4d22944a308e9ff00fea", "http://www.w3.org/1999/02/22-rdf-syntax-ns#first", "_:Nb6020c54af81427b961b91e5034d6e08", "localId", "", ""]
