["https://spdx.org/rdf/3/terms/SupplyChain/StorageAction", "http://www.w3.org/2000/01/rdf-schema#comment", "Records the storage of a product.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
