["https://spdx.org/rdf/3/terms/Core/ExternalIdentifier", "http://www.w3.org/2000/01/rdf-schema#comment", "A reference to a resource identifier defined outside the scope of SPDX 3 content that uniquely identifies an Element.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Hardware/ProductSpecification", "http://www.w3.org/2004/02/skos/core#note", "A product specification (product spec) is a detailed document that outlines the technical, functional, and design requirements of a product. It serves as a guide for engineers, designers, and manufacturers to ensure the final product meets expectations.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
