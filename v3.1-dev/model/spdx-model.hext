["https://spdx.org/rdf/3/terms/SupplyChain/dropoffLocation", "http://www.w3.org/2004/02/skos/core#note", "This is a specific location that an item was dropped off to.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/externalSpdxId", "http://www.w3.org/2000/01/rdf-schema#range", "http://www.w3.org/2001/XMLSchema#anyURI", "globalId", "", ""]
