["https://spdx.org/rdf/3/terms/Core/PhysicalLocation", "http://www.w3.org/2004/02/skos/core#note", "A physical location is a tangible, geographically identifiable place where objects, people, or assets exist or operate.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
