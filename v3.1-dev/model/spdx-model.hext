["_:Ncf98b9ba77f14bf680fd6d9c7be8c890", "http://www.w3.org/1999/02/22-rdf-syntax-ns#first", "https://spdx.org/rdf/3/terms/Dataset/ConfidentialityLevelType/red", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Core/RoleRelationship", "http://www.w3.org/2004/02/skos/core#note", "RoleRelationship is a concrete subclass of Relationship that captures the connection between an entities (such as a person, organization, tool, or component) and the specific position, function, or responsibility it fulfills. This relationship type is used when documenting roles that are not implicitly defined by the SPDX document structure, allowing explicit modeling of organizational responsibilities, tooling involvement, or component functions across systems or contexts.\nRoleRelationship inherits the from and to properties from Relationship, where:\n\n- relationshipType = hasRoleIn.\n- from: The element to which the role is assigned (the role recipient).\n- to: The context, system, element or domain within which the role exists.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:N031e9b68237242cfa2cef34edfbe1ab9", "http://www.w3.org/1999/02/22-rdf-syntax-ns#first", "https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/nli", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Security/vexVersion", "http://www.w3.org/2000/01/rdf-schema#isDefinedBy", "https://spdx.org/rdf/3/terms/Security/", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/glue", "http://www.w3.org/2000/01/rdf-schema#comment", "GLobal Unique Enterprise (GLUE) Identifiers <https://datatracker.ietf.org/doc/draft-ietf-spice-glue-id/>, as defined by the IETF Internet-Draft, is expressed as a GLUE URI, a Uniform Resource Identifier that standardizes the representation of existing organizational entity identifiers.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Security/score", "http://www.w3.org/2004/02/skos/core#note", "The score provides information on the severity of a vulnerability per the\nCommon Vulnerability Scoring System as defined by\nForum of Incident Response and Security Teams <https://www.first.org/cvss/>.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
