["https://spdx.org/rdf/3/terms/FunctionalSafety/EvidenceType/log", "http://www.w3.org/2000/01/rdf-schema#comment", "Time-stamped records capturing system or operational data recorded as usually as a response to specific triggers in a specified environment.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/ExpandedLicensing/IndividualLicensingInfo", "http://www.w3.org/2000/01/rdf-schema#label", "IndividualLicensingInfo", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/createdUsing", "http://www.w3.org/2004/02/skos/core#definition", "Identifies the tooling that was used during the creation of the Element.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/SimpleLicensing/LicenseExpression", "http://www.w3.org/2004/02/skos/core#note", "A LicenseExpression enables the representation, in a single string, of a\ncombination of one or more licenses, together with additions such as license\nexceptions.\n\nThe syntax for a licenseExpression string is set forth in the corresponding\nAnnex of this document\n(\"SPDX license expressions\").\nA licenseExpression string is not valid if it does not conform to the grammar\nset forth in that Annex.\n\nThe ExpandedLicensing profile can be used to represent the complete parsed\nlicense expression as a combination of license objects.\n\ncustomIdToUri is deprecated. Migrate to customIdToLicense. customIdToUri\nwill be removed in a future release.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/verificationUID", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType", "globalId", "", ""]
