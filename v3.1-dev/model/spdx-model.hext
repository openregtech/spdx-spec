["https://spdx.org/rdf/3/terms/Security/SsvcDecisionType/attend", "http://www.w3.org/2000/01/rdf-schema#comment", "The vulnerability requires attention from the organization's internal, supervisory-level individuals. Necessary actions include requesting assistance or information about the vulnerability, and may involve publishing a notification either internally and/or externally. CISA recommends remediating Attend vulnerabilities sooner than standard update timelines.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/RelationshipType/doesNotAffect", "http://www.w3.org/2000/01/rdf-schema#label", "doesNotAffect", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/SpecificationType", "http://www.w3.org/2000/01/rdf-schema#comment", "A specification type defines the nature of a specification.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/postOfficeBoxNumber", "http://www.w3.org/2000/01/rdf-schema#comment", "The number that identifies a PO box. A PO box is a box in a post office or other postal service location assigned to an organization where postal items may be kept.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/FunctionalSafety/VerificationType/other", "http://www.w3.org/2000/01/rdf-schema#label", "other", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/MeasureOfMass", "http://www.w3.org/2004/02/skos/core#definition", "The measure of mass refers to the quantity of matter in an object or substance.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/AI/limitation", "http://www.w3.org/2000/01/rdf-schema#comment", "Limitation of the AI software.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
