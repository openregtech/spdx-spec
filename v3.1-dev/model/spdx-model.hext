["_:N772c6b15e35946cc97ef2e56b23b4317", "http://www.w3.org/1999/02/22-rdf-syntax-ns#rest", "_:N7904fbf4a8fd4aa9a018a31fa4f21e56", "localId", "", ""]
["https://spdx.org/rdf/3/terms/Dataset/datasetNoise", "http://www.w3.org/2004/02/skos/core#note", "Describes what kinds of noises a dataset can encompass.\n\nThe free-form text specifies fields or samples that can be noisy.\n\nAlternatively, it can also be used to describe various noises that can\nimpact the whole dataset.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
