["https://spdx.org/rdf/3/terms/Core/RelationshipType/expandsTo", "http://www.w3.org/2000/01/rdf-schema#label", "expandsTo", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Service/", "http://purl.org/vocab/vann/preferredNamespaceUri", "https://spdx.org/rdf/3/terms/Service/", "http://www.w3.org/2001/XMLSchema#string", "", ""]
["_:N35be517740f1423b97e594b4dd13a241", "http://www.w3.org/1999/02/22-rdf-syntax-ns#first", "https://spdx.org/rdf/3/terms/Dataset/DatasetType/numeric", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Dataset/intendedUse", "http://www.w3.org/2004/02/skos/core#note", "**NOTE:**\nThis property is deprecated and only included for backward compatibility.\nNew documents should use\n/Core/intendedUse\ninstead.\n\nA free-form text that describes what the given dataset should be used for.\n\nSome datasets are collected to be used only for particular purposes.\n\nFor example, medical data collected from a specific demography should only be applicable\nfor training machine learning models to make predictions for that demography.\nIn such a case, the intendedUse field would capture this information.\nSimilarly, if a dataset is collected for building a facial recognition model,\nthe intendedUse field would specify that.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:Nc3cc000dc5384aec832f3599c6134afd", "http://www.w3.org/1999/02/22-rdf-syntax-ns#first", "https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/ibrn", "globalId", "", ""]
