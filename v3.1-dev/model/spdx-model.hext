["https://spdx.org/rdf/3/terms/Dataset/hasSensitivePersonalInformation", "http://www.w3.org/2004/02/skos/core#note", "Indicates the presence of sensitive personal data\nor information that allows drawing conclusions about a person's identity.\n\nRelated: useSensitivePersonalInformation in /AI/AIPackage", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/locationTime", "http://www.w3.org/2000/01/rdf-schema#comment", "A known location is specified at this time.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/SupplyChain/OutOfSpecAction", "http://www.w3.org/ns/shacl#nodeKind", "http://www.w3.org/ns/shacl#IRI", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/SupplyChain/ResponsibilityChangeAction", "http://www.w3.org/2004/02/skos/core#definition", "ResponsibilityChangeAction refers to the transfer of responsibility from one party to another.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
