["https://spdx.org/rdf/3/terms/Core/RelationshipType/hasContactPoint", "http://www.w3.org/2004/02/skos/core#definition", "The from Artifact has each to Agent as a contact point. The use of the hasContactPoint type is constrained to ContactPointRelationship classed relationships. The type of contact (i.e. security) may be specified using a ContactPointRelationship element.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:N639d8e0803e74126bffda3f3230854ed", "http://www.w3.org/1999/02/22-rdf-syntax-ns#first", "https://spdx.org/rdf/3/terms/FunctionalSafety/VerificationType/audit", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Core/unitQUDT", "http://www.w3.org/2000/01/rdf-schema#comment", "A QUDT unit applied to measurement criteria based on product type, region,\nand use.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:Naf840171c35145439895e91ca8a93176", "http://www.w3.org/ns/shacl#path", "https://spdx.org/rdf/3/terms/ExpandedLicensing/member", "globalId", "", ""]
