["https://spdx.org/rdf/3/terms/Core/SpecificationType/formalStandard", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "http://www.w3.org/2002/07/owl#NamedIndividual", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Operations/Project", "http://www.w3.org/2004/02/skos/core#note", "Temporary endeavor with a beginning and an end and that must be used to create a unique product, service or result.\n\nBased on the Project Management Body of Knowledge (PMBOK), 3rd edition.\n\nstartTime is the time at which a project starts or is planned to start.\nendTime is the time at which a project ends or is planned to end.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:Nfebd0aed810a4a66a56f3adc113d08ad", "http://www.w3.org/ns/shacl#path", "https://spdx.org/rdf/3/terms/Core/relationshipType", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/iscc", "http://www.w3.org/2004/02/skos/core#definition", "International Standard Content Code (ISCC) <https://iscc.io/> is a content-derived identifier standardized by ISO 24138 <https://www.iso.org/standard/77899.html> for identifying digital assets. ISCC can be used in conjunction with other schemes, such as DOI, ISAN, ISBN, ISRC, ISSN and ISWC. A standard ISCC-CODE is build from multiple ISCC-UNITs. Each unit serve a different purpose. An ISCC-CODE typically look like ISCC:KACT4EBWK27737D2AYCJRAL5Z36G76RFRMO4554RU26HZ4ORJGIVHDI.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:N1d604175c6ea4c2183f89c7ecb25c694", "http://www.w3.org/1999/02/22-rdf-syntax-ns#rest", "_:N62f7f61ca8c441d9b9aee01444b18398", "localId", "", ""]
