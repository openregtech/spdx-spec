["https://spdx.org/rdf/3/terms/Core/element", "http://www.w3.org/2004/02/skos/core#note", "This field refers to one or more Elements that are part of an\nElementCollection.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
