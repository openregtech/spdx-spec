["_:Nd785e5153dbc4a8d9811c08c86977ae3", "http://www.w3.org/ns/shacl#path", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Build/configSourceUri", "http://www.w3.org/2004/02/skos/core#note", "If a build configuration exists for the toolchain or platform performing the\nbuild, the configSourceUri of a build is the URI of that build configuration,\naccording to the buildType.\n\nFor example, a build triggered by a GitHub Action is defined by a build\nconfiguration YAML file. In this case, the configSourceUri is the URL of that\nYAML file.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Dataset/DatasetAvailabilityType", "http://www.w3.org/2000/01/rdf-schema#isDefinedBy", "https://spdx.org/rdf/3/terms/Dataset/", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Core/Element", "http://www.w3.org/ns/shacl#nodeKind", "http://www.w3.org/ns/shacl#IRI", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/SupplyChain/PlanAction", "http://www.w3.org/2004/02/skos/core#note", "A PlanAction involves the execution of a plan in relation to a PlanProcess.\n\nThe description of the PlanAction is a mandatory property.\n\nRelationship:\n\nFor each PlanAction there is at least one /Core/Relationship class or subclass with the relationshipType of 'generates\u2019 on the to and a PlanProcess class or subclass on the from.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/SupplyChain/OutOfSpecAction", "http://www.w3.org/2004/02/skos/core#note", "OutOfSpecAction refers to a situation where a product, material, environment, or process fails to meet the established standards or predefined specifications or exceeds specification parameters. Any result or condition that goes beyond these predefined parameters or thresholds is considered \"out of specification,\" indicating a non-conformance or deviation that must be investigated and addressed to maintain product quality and regulatory compliance. This term is often used in industries like manufacturing, pharmaceuticals, quality control, and regulatory compliance", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/SupplyChain/plannedStorageLocation", "http://www.w3.org/2004/02/skos/core#definition", "The planned location that a good, product or material is stored.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:N0b2492f74d4f49139326a12f201591ac", "http://www.w3.org/1999/02/22-rdf-syntax-ns#rest", "_:Ne2831de181374efb8544fb43f8a62635", "localId", "", ""]
["https://spdx.org/rdf/3/terms/Operations/weight", "http://www.w3.org/2004/02/skos/core#definition", "Weight to express relevance in de minimis consideration.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Operations/ExportControlClassificationAssessment", "http://www.w3.org/2000/01/rdf-schema#isDefinedBy", "https://spdx.org/rdf/3/terms/Operations/", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Software/ContentIdentifierType/gitoid", "http://www.w3.org/2004/02/skos/core#definition", "Gitoid <https://www.iana.org/assignments/uri-schemes/prov/gitoid>, stands for Git Object ID <https://git-scm.com/book/en/v2/Git-Internals-Git-Objects>. A gitoid of type blob is a unique hash of a binary artifact. A gitoid may represent either an Artifact Identifier <https://github.com/omnibor/spec/blob/eb1ee5c961c16215eb8709b2975d193a2007a35d/spec/SPEC.md#artifact-identifier-types> for the software artifact or an Input Manifest Identifier <https://github.com/omnibor/spec/blob/eb1ee5c961c16215eb8709b2975d193a2007a35d/spec/SPEC.md#input-manifest-identifier> for the software artifact's associated Artifact Input Manifest <https://github.com/omnibor/spec/blob/eb1ee5c961c16215eb8709b2975d193a2007a35d/spec/SPEC.md#artifact-input-manifest>; this ambiguity exists because the Artifact Input Manifest is itself an artifact, and the gitoid of that artifact is its valid identifier. Gitoids calculated on software artifacts (Snippet, File, or Package Elements) should be recorded in the SPDX 3 SoftwareArtifact's contentIdentifier property. Gitoids calculated on the Artifact Input Manifest (Input Manifest Identifier) should be recorded in the SPDX 3 Element's externalIdentifier property. See OmniBOR Specification <https://github.com/omnibor/spec/>, a minimalistic specification for describing software Artifact Dependency Graphs <https://github.com/omnibor/spec/blob/eb1ee5c961c16215eb8709b2975d193a2007a35d/spec/SPEC.md#artifact-dependency-graph-adg>.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Hardware/partNumber", "http://www.w3.org/2000/01/rdf-schema#isDefinedBy", "https://spdx.org/rdf/3/terms/Hardware/", "globalId", "", ""]
