["https://spdx.org/rdf/3/terms/Extension/cdxProperty", "http://www.w3.org/2004/02/skos/core#definition", "Provides a map of a property name to a value.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/statement", "http://www.w3.org/2004/02/skos/core#note", "A statement is a commentary on an assertion that an annotator has made.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Build/parameter", "http://www.w3.org/2000/01/rdf-schema#comment", "Property describing a parameter used in an instance of a build.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
