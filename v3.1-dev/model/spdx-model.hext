["_:N143d48199529451087214698cbfa29ea", "http://www.w3.org/1999/02/22-rdf-syntax-ns#first", "https://spdx.org/rdf/3/terms/Core/HashAlgorithm/blake2b512", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/SupplyChain/ManufactureProcess", "http://www.w3.org/2000/01/rdf-schema#isDefinedBy", "https://spdx.org/rdf/3/terms/SupplyChain/", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Security/VexFixedVulnAssessmentRelationship", "http://www.w3.org/2004/02/skos/core#definition", "Links a vulnerability and elements representing products (in the VEX sense) where\na fix has been applied and are no longer affected.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
