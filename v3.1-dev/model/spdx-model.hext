["https://spdx.org/rdf/3/terms/Core/ExternalRefType/bower", "http://www.w3.org/2004/02/skos/core#definition", "A reference to a Bower package. The package locator format, looks like package#version, is defined in the \"install\" section of Bower API documentation <https://bower.io/docs/api/#install>.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/SupplyChain/ResponsibilityChangeProcess", "http://www.w3.org/2004/02/skos/core#note", "The process changes of responsibility are recorded in this process. Responsibility Change refers to the transfer of rights, responsibilities, and/or control of an asset, property, business, or entity from one party to another.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/SupplyChain/previous", "http://www.w3.org/2004/02/skos/core#definition", "This is the individual, business, or organization who was previously managing goods, services, or assets.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Dataset/datasetSize", "http://www.w3.org/2000/01/rdf-schema#range", "http://www.w3.org/2001/XMLSchema#nonNegativeInteger", "globalId", "", ""]
