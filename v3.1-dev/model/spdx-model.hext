["https://spdx.org/rdf/3/terms/SupplyChain/HarvestProcess", "http://www.w3.org/2000/01/rdf-schema#comment", "Harvest is the process of extracting goods or products from nature.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/elementValue", "http://www.w3.org/2004/02/skos/core#note", "A value used in a key-value pair with a generic key that refers to an Element.\n\nA key-value pair can be used to implement a dictionary which associates a key\nwith an Element.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/ContactPointRelationshipType/other", "http://www.w3.org/2004/02/skos/core#definition", "A generic contact point to be used when the contact type does not match any of the other options.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
