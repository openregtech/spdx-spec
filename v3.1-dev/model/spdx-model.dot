# https://spdx.org/rdf/3.1/terms/Software/byteRange node914
node914 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>byteRange</B></td></tr><tr><td href='https://spdx.org/rdf/3.1/terms/Software/byteRange' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3.1/terms/Software/byteRange</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Defines the byte range in the original host file that the snippet information
applies to.&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;Defines the byte range in the original host file that the snippet information
applies to.&quot;@en</td></tr><tr><td align='left'>skos:note</td><td align='left'>&quot;This field defines the byte range in the original host file that the snippet
information applies to.

A range of bytes is independent of various formatting concerns, and the most
accurate way of referring to the differences. The choice was made to start the
numbering of the byte range at 1 to be consistent with the W3C pointer method
vocabulary.&quot;@en</td></tr></table> > ] 
# https://spdx.org/rdf/3.1/terms/SupplyChain/OutOfSpecAction node915
node915 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>OutOfSpecAction</B></td></tr><tr><td href='https://spdx.org/rdf/3.1/terms/SupplyChain/OutOfSpecAction' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3.1/terms/SupplyChain/OutOfSpecAction</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;An out of specification action is defined in this class.&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;An out of specification action is defined in this class.&quot;@en</td></tr><tr><td align='left'>skos:note</td><td align='left'>&quot;OutOfSpecAction refers to a situation where a product, material, environment, or process fails to meet the established standards or predefined specifications or exceeds specification parameters. Any result or condition that goes beyond these predefined parameters or thresholds is considered &quot;out of specification,&quot; indicating a non-conformance or deviation that must be investigated and addressed to maintain product quality and regulatory compliance. This term is often used in industries like manufacturing, pharmaceuticals, quality control, and regulatory compliance&quot;@en</td></tr></table> > ] 
