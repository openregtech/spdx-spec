# https://spdx.org/rdf/3/terms/Core/UnitOfMeasure node103
node103 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>UnitOfMeasure</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/UnitOfMeasure' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/UnitOfMeasure</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;A class that represents a measured quantity paired with a unit of measure from the QUDT ontology.&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;A class that represents a measured quantity paired with a unit of measure from the QUDT ontology.&quot;@en</td></tr><tr><td align='left'>skos:note</td><td align='left'>&quot;UnitOfMeasure class provides a structured way to express measurements: such as size, weight, volume, or other quantities.
It combines a numerical value quantity with a unit reference unitQUDT that points to a URI in the QUDT (Quantity, Unit, Dimension and Type) ontology.
The QUDT ontology and specifications are available at www.qudt.org &lt;https://www.qudt.org/&gt;.&quot;@en</td></tr></table> > ] 
