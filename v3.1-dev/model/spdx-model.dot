# https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/gitoid node349
node349 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>gitoid</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/gitoid' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/gitoid</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Gitoid &lt;https://www.iana.org/assignments/uri-schemes/prov/gitoid&gt;, stands for Git Object ID &lt;https://git-scm.com/book/en/v2/Git-Internals-Git-Objects&gt;. A gitoid of type blob is a unique hash of a binary artifact. A gitoid may represent either an Artifact Identifier &lt;https://github.com/omnibor/spec/blob/eb1ee5c961c16215eb8709b2975d193a2007a35d/spec/SPEC.md#artifact-identifier-types&gt; for the software artifact or an Input Manifest Identifier &lt;https://github.com/omnibor/spec/blob/eb1ee5c961c16215eb8709b2975d193a2007a35d/spec/SPEC.md#input-manifest-identifier&gt; for the software artifact&#x27;s associated Artifact Input Manifest &lt;https://github.com/omnibor/spec/blob/eb1ee5c961c16215eb8709b2975d193a2007a35d/spec/SPEC.md#artifact-input-manifest&gt;; this ambiguity exists because the Artifact Input Manifest is itself an artifact, and the gitoid of that artifact is its valid identifier. Gitoids calculated on software artifacts (Snippet, File, or Package Elements) should be recorded in the SPDX 3 SoftwareArtifact&#x27;s contentIdentifier property. Gitoids calculated on the Artifact Input Manifest (Input Manifest Identifier) should be recorded in the SPDX 3 Element&#x27;s externalIdentifier property. See OmniBOR Specification &lt;https://github.com/omnibor/spec/&gt;, a minimalistic specification for describing software Artifact Dependency Graphs &lt;https://github.com/omnibor/spec/blob/eb1ee5c961c16215eb8709b2975d193a2007a35d/spec/SPEC.md#artifact-dependency-graph-adg&gt;.&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;Gitoid &lt;https://www.iana.org/assignments/uri-schemes/prov/gitoid&gt;, stands for Git Object ID &lt;https://git-scm.com/book/en/v2/Git-Internals-Git-Objects&gt;. A gitoid of type blob is a unique hash of a binary artifact. A gitoid may represent either an Artifact Identifier &lt;https://github.com/omnibor/spec/blob/eb1ee5c961c16215eb8709b2975d193a2007a35d/spec/SPEC.md#artifact-identifier-types&gt; for the software artifact or an Input Manifest Identifier &lt;https://github.com/omnibor/spec/blob/eb1ee5c961c16215eb8709b2975d193a2007a35d/spec/SPEC.md#input-manifest-identifier&gt; for the software artifact&#x27;s associated Artifact Input Manifest &lt;https://github.com/omnibor/spec/blob/eb1ee5c961c16215eb8709b2975d193a2007a35d/spec/SPEC.md#artifact-input-manifest&gt;; this ambiguity exists because the Artifact Input Manifest is itself an artifact, and the gitoid of that artifact is its valid identifier. Gitoids calculated on software artifacts (Snippet, File, or Package Elements) should be recorded in the SPDX 3 SoftwareArtifact&#x27;s contentIdentifier property. Gitoids calculated on the Artifact Input Manifest (Input Manifest Identifier) should be recorded in the SPDX 3 Element&#x27;s externalIdentifier property. See OmniBOR Specification &lt;https://github.com/omnibor/spec/&gt;, a minimalistic specification for describing software Artifact Dependency Graphs &lt;https://github.com/omnibor/spec/blob/eb1ee5c961c16215eb8709b2975d193a2007a35d/spec/SPEC.md#artifact-dependency-graph-adg&gt;.&quot;@en</td></tr></table> > ] 
# https://spdx.org/rdf/3/terms/Core/Regulation node350
node350 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Regulation</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/Regulation' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/Regulation</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Regulation represents a rule or directive maintained by an authority.&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;Regulation represents a rule or directive maintained by an authority.&quot;@en</td></tr><tr><td align='left'>skos:note</td><td align='left'>&quot;The Regulation class represents any rules or directives enforced by an official authority.
Regulations within this class can be either mandatory or voluntary.

Examples of these regulations include the EU Radio Equipment Directive, EU Cyber Resilience Act,
the Japan Cyber STAR, or the U.S. Cyber Trust Mark.&quot;@en</td></tr></table> > ] 
