# https://spdx.org/rdf/3/terms/Core/authorization node268
node268 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>authorization</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/authorization' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/authorization</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Authorization specifies the permissions, rights, privileges, or benefits granted to a Role, defining what the role is authorized to access, perform, or receive.&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;Authorization specifies the permissions, rights, privileges, or benefits granted to a Role, defining what the role is authorized to access, perform, or receive.&quot;@en</td></tr><tr><td align='left'>skos:note</td><td align='left'>&quot;Authorization is a string property that captures the specific permissions, rights, privileges, or benefits that are associated with a Role. This property defines what the role is entitled to do or receive within a given context (e.g., build, system, distribution, supply chain, or lifecycle). For example, authorization might include access to certain resources, permissions to perform specific actions, or eligibility for particular benefits.&quot;@en</td></tr></table> > ] 
