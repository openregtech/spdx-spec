node485 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>devLifecycleStage</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/devLifecycleStage' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/devLifecycleStage</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;The product lifecycle phase, the requirement is applicable for.&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;The product lifecycle phase, the requirement is applicable for.&quot;@en</td></tr><tr><td align='left'>skos:note</td><td align='left'>&quot;The development lifecycle stage specifies the phase or phases of a product’s lifecycle to which a given requirement applies. These may include requirements that govern the design phase, guide development activities, define constraints for the build environment, provide instructions for the decommissioning phase, etc.&quot;@en</td></tr></table> > ] 
# https://spdx.org/rdf/3/terms/Core/Tool node486
