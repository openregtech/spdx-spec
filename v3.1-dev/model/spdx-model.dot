node1230 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>ibrn</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/ibrn' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/ibrn</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;International Business Registration Number (IBRN) &lt;https://ekys.org/business_identifiers/&gt; is a unique identifier for legal entities standardized by ISO 8000-116 &lt;https://www.iso.org/standard/75117.html&gt;. It is composed of two parts: a jurisdiction prefix and a local authoritative legal entity identifier (ALEI), separated by a colon. The prefix contains an ISO 3166 country code, an optional subdivision code, and a register code (e.g., US-DE.BER:3031657).&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;International Business Registration Number (IBRN) &lt;https://ekys.org/business_identifiers/&gt; is a unique identifier for legal entities standardized by ISO 8000-116 &lt;https://www.iso.org/standard/75117.html&gt;. It is composed of two parts: a jurisdiction prefix and a local authoritative legal entity identifier (ALEI), separated by a colon. The prefix contains an ISO 3166 country code, an optional subdivision code, and a register code (e.g., US-DE.BER:3031657).&quot;@en</td></tr></table> > ] 
# https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/iswc node1231
node1231 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>iswc</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/iswc' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/iswc</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;International Standard Musical Work Code (ISWC) &lt;https://www.iswc.org/iswc&gt; is an 11-character unique identifier standardized by ISO 15707 &lt;https://www.iso.org/standard/83125.html&gt; for musical works (compositions) as distinct from specific recordings. While the &quot;ISWC&quot; label and grouping separators (dots and hyphens) are used for human readability, they shall be omitted when the identifier is stored electronically (e.g., T0017812031).&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;International Standard Musical Work Code (ISWC) &lt;https://www.iswc.org/iswc&gt; is an 11-character unique identifier standardized by ISO 15707 &lt;https://www.iso.org/standard/83125.html&gt; for musical works (compositions) as distinct from specific recordings. While the &quot;ISWC&quot; label and grouping separators (dots and hyphens) are used for human readability, they shall be omitted when the identifier is stored electronically (e.g., T0017812031).&quot;@en</td></tr></table> > ] 
