node188 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nf6a79ba26195403f903318fa01c136d1</B></td></tr><tr><td href='Nf6a79ba26195403f903318fa01c136d1' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nf6a79ba26195403f903318fa01c136d1</font></td></tr><tr><td align='left'>sh:maxCount</td><td align='left'>&quot;1&quot;^^xsd:integer</td></tr></table> > ] 
# https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/ismn node189
node189 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>ismn</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/ismn' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/ismn</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;International Standard Music Number (ISMN) &lt;https://ismn-international.org/ismn/the-ismn/&gt; is a unique numeric identifier for printed music (notated music) standardized by ISO 10957 &lt;https://www.iso.org/standard/83122.html&gt;. It consists of either 10 characters (starting with the letter &quot;M&quot; for assignments prior to January 1, 2008) or 13 digits. A 13-digit ISMN is composed of four parts: the GS1 prefix 979-0, a registrant element, an item element, and a check digit. While elements may be divided by spaces or hyphens for human readability, these separators shall be omitted when the identifier is stored electronically (e.g., 9790006538424).&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;International Standard Music Number (ISMN) &lt;https://ismn-international.org/ismn/the-ismn/&gt; is a unique numeric identifier for printed music (notated music) standardized by ISO 10957 &lt;https://www.iso.org/standard/83122.html&gt;. It consists of either 10 characters (starting with the letter &quot;M&quot; for assignments prior to January 1, 2008) or 13 digits. A 13-digit ISMN is composed of four parts: the GS1 prefix 979-0, a registrant element, an item element, and a check digit. While elements may be divided by spaces or hyphens for human readability, these separators shall be omitted when the identifier is stored electronically (e.g., 9790006538424).&quot;@en</td></tr></table> > ] 
# https://spdx.org/rdf/3/terms/Core/authorization node190
node190 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>authorization</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/authorization' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/authorization</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Authorization specifies the permissions, rights, privileges, or benefits granted to a Role, defining what the role is authorized to access, perform, or receive.&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;Authorization specifies the permissions, rights, privileges, or benefits granted to a Role, defining what the role is authorized to access, perform, or receive.&quot;@en</td></tr><tr><td align='left'>skos:note</td><td align='left'>&quot;Authorization is a string property that captures the specific permissions, rights, privileges, or benefits that are associated with a Role. This property defines what the role is entitled to do or receive within a given context (e.g., build, system, distribution, supply chain, or lifecycle). For example, authorization might include access to certain resources, permissions to perform specific actions, or eligibility for particular benefits.&quot;@en</td></tr></table> > ] 
