node815 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>sha256</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/HashAlgorithm/sha256' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/HashAlgorithm/sha256</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;SHA-2 with a digest length of 256, as defined in RFC 6234 &lt;https://datatracker.ietf.org/doc/rfc6234/&gt;.&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;SHA-2 with a digest length of 256, as defined in RFC 6234 &lt;https://datatracker.ietf.org/doc/rfc6234/&gt;.&quot;@en</td></tr></table> > ] 
