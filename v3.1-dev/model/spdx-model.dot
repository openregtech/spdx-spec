# https://spdx.org/rdf/3/terms/SupplyChain/ManufactureProcess node367
node367 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>ManufactureProcess</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/SupplyChain/ManufactureProcess' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/SupplyChain/ManufactureProcess</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;This class represents the process involved in manufacturing products.&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;This class represents the process involved in manufacturing products.&quot;@en</td></tr><tr><td align='left'>skos:note</td><td align='left'>&quot;The manufacturing process encompasses the series of steps required to transform materials into finished goods. It is a fundamental operation across various industries, including automotive, electronics, pharmaceuticals, textiles, and food production.&quot;@en</td></tr></table> > ] 
# https://spdx.org/rdf/3/terms/Security/SsvcDecisionType/trackStar node368
