# https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/ibrn node1274
node1274 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>ibrn</B></td></tr><tr><td href='https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/ibrn' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/ibrn</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;International Business Registration Number (IBRN) &lt;https://ekys.org/business_identifiers/&gt; is a unique identifier for legal entities standardized by ISO 8000-116 &lt;https://www.iso.org/standard/75117.html&gt;. It is composed of two parts: a jurisdiction prefix and a local authoritative legal entity identifier (ALEI), separated by a colon. The prefix contains an ISO 3166 country code, an optional subdivision code, and a register code (e.g., US-DE.BER:3031657).&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;International Business Registration Number (IBRN) &lt;https://ekys.org/business_identifiers/&gt; is a unique identifier for legal entities standardized by ISO 8000-116 &lt;https://www.iso.org/standard/75117.html&gt;. It is composed of two parts: a jurisdiction prefix and a local authoritative legal entity identifier (ALEI), separated by a colon. The prefix contains an ISO 3166 country code, an optional subdivision code, and a register code (e.g., US-DE.BER:3031657).&quot;@en</td></tr></table> > ] 
# https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/lei node1275
node1275 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>lei</B></td></tr><tr><td href='https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/lei' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/lei</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;The Legal Entity Identifier (LEI) &lt;https://www.gleif.org/en/organizational-identity/introducing-the-legal-entity-identifier-lei&gt; is a 20-character, alphanumeric code based on the ISO 17442 &lt;https://www.iso.org/standard/78829.html&gt; standard developed by the International Organization for Standardization.&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;The Legal Entity Identifier (LEI) &lt;https://www.gleif.org/en/organizational-identity/introducing-the-legal-entity-identifier-lei&gt; is a 20-character, alphanumeric code based on the ISO 17442 &lt;https://www.iso.org/standard/78829.html&gt; standard developed by the International Organization for Standardization.&quot;@en</td></tr></table> > ] 
