# https://spdx.org/rdf/3/terms/Core/givenRole node117
node117 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>givenRole</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/givenRole' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/givenRole</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;givenRole is a property that specifies the role being assigned in a RoleRelationship. It links the relationship to an instance of the Role class, defining the function, responsibility, or position that the source element confers upon the target element.&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;givenRole is a property that specifies the role being assigned in a RoleRelationship. It links the relationship to an instance of the Role class, defining the function, responsibility, or position that the source element confers upon the target element.&quot;@en</td></tr><tr><td align='left'>skos:note</td><td align='left'>&quot;givenRole specific the role that is being assigned or defined by the relationship. This role represents the function, responsibility, or position that the source element (e.g., an organization, tool, or component) confers upon the target element (e.g., a person, team, or system).&quot;@en</td></tr></table> > ] 
# https://spdx.org/rdf/3/terms/Core/Role node118
node118 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Role</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/Role' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/Role</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;A Role defines a specific position, function, or capacity that an entity may assume within any relevant context.&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;A Role defines a specific position, function, or capacity that an entity may assume within any relevant context.&quot;@en</td></tr><tr><td align='left'>skos:note</td><td align='left'>&quot;A Role defines a specific position, function, or capacity that an entity may assume within any relevant context. This context is intentionally broad and adaptable, capable of representing environments including, but not limited to, software builds, system architectures, project management structures, distribution channels, supply chain operations, lifecycle stages, or any other domain where entities perform specific functions. The Role class provides a structured mechanism to model these functional assignments independently of the entities themselves, allowing for reusable and standardized definitions of responsibilities and privileges across different SPDX documents and ecosystems.&quot;@en</td></tr></table> > ] 
