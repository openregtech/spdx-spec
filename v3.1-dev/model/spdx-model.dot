# https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/orcidid node1094
node1094 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>orcidid</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/orcidid' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/orcidid</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Open Researcher and Contributor ID (ORCID) iD &lt;https://info.orcid.org/what-is-orcid/&gt; is a unique identifier for authors and contributors in scholarly communication; as a subset of the International Standard Name Identifier (ISNI), it typically appears as a URI such as https://orcid.org/0000-0002-1825-0097.&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;Open Researcher and Contributor ID (ORCID) iD &lt;https://info.orcid.org/what-is-orcid/&gt; is a unique identifier for authors and contributors in scholarly communication; as a subset of the International Standard Name Identifier (ISNI), it typically appears as a URI such as https://orcid.org/0000-0002-1825-0097.&quot;@en</td></tr></table> > ] 
# https://spdx.org/rdf/3/terms/Core/headquartersLocation node1095
node1095 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>headquartersLocation</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/headquartersLocation' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/headquartersLocation</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;The headquartersLocation defines the location of the organization&#x27;s headquarters.&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;The headquartersLocation defines the location of the organization&#x27;s headquarters.&quot;@en</td></tr><tr><td align='left'>skos:note</td><td align='left'>&quot;Headquarters denotes the location where most or all of the important functions of an organization are coordinated. In the United States, the corporate headquarters represents the entity at the center or the top of a corporation taking full responsibility for managing all business activities.
To identify an organization&#x27;s headquarters accurately, you provide address information (mailing, street and GPL) information related to the organization’s headquarters.&quot;@en</td></tr></table> > ] 
