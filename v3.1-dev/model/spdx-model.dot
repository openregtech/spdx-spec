# https://spdx.org/rdf/3/terms/Software/Snippet node84
node84 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Snippet</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Software/Snippet' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Software/Snippet</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Describes a certain part of a file.&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;Describes a certain part of a file.&quot;@en</td></tr><tr><td align='left'>skos:note</td><td align='left'>&quot;A Snippet describes a certain part of a file and can be used when the file is
known to have some content that has been included from another original source.

Snippets are useful for denoting when part of a file may have been originally
created under another license or copied from a place with a known
vulnerability.&quot;@en</td></tr></table> > ] 
# https://spdx.org/rdf/3/terms/Core/created node85
node85 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>created</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/created' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/created</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Identifies when the Element was originally created.&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;Identifies when the Element was originally created.&quot;@en</td></tr><tr><td align='left'>skos:note</td><td align='left'>&quot;Created is a date that identifies when the Element was originally created.

The time stamp can serve as an indication as to whether the analysis needs to
be updated.

This is often the date of last change (e.g., a git commit date), not the date
when the SPDX data was created, as doing so supports reproducible builds.&quot;@en</td></tr></table> > ] 
# https://spdx.org/rdf/3/terms/Security/justificationType node86
node86 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>justificationType</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Security/justificationType' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Security/justificationType</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Impact justification label to be used when linking a vulnerability to an element
representing a VEX product with a VexNotAffectedVulnAssessmentRelationship
relationship.&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;Impact justification label to be used when linking a vulnerability to an element
representing a VEX product with a VexNotAffectedVulnAssessmentRelationship
relationship.&quot;@en</td></tr><tr><td align='left'>skos:note</td><td align='left'>&quot;When stating that an element is not affected by a vulnerability, the
VexNotAffectedVulnAssessmentRelationship shall include a justification from the
machine-readable labels catalog informing the reason the element is not impacted.

impactStatement which is a string with English prose can be used instead or as
complementary to the justification label, but one of both shall be defined.&quot;@en</td></tr></table> > ] 
# https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/isil node87
node87 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>isil</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/isil' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/isil</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;International Standard Identifier for Libraries and Related Organizations (ISIL) &lt;https://slks.dk/english/work-areas/libraries-and-literature/library-standards/isil/&gt; is a unique alphanumeric code for identifying libraries, archives, museums, and related organizations standardized by ISO 15511 &lt;https://www.iso.org/standard/77849.html&gt;. It consists of a prefix—which may be an ISO 3166-1 alpha-2 country code or a non-country code assigned by the ISIL Registration Authority—followed by a unit identifier, totaling up to 16 characters (e.g., FI-Sipoo-Sö or ZDB-1-SBD). Valid symbols include any alphanumeric character, solidus (/), hyphen-minus (-), or colon.&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;International Standard Identifier for Libraries and Related Organizations (ISIL) &lt;https://slks.dk/english/work-areas/libraries-and-literature/library-standards/isil/&gt; is a unique alphanumeric code for identifying libraries, archives, museums, and related organizations standardized by ISO 15511 &lt;https://www.iso.org/standard/77849.html&gt;. It consists of a prefix—which may be an ISO 3166-1 alpha-2 country code or a non-country code assigned by the ISIL Registration Authority—followed by a unit identifier, totaling up to 16 characters (e.g., FI-Sipoo-Sö or ZDB-1-SBD). Valid symbols include any alphanumeric character, solidus (/), hyphen-minus (-), or colon.&quot;@en</td></tr></table> > ] 
# https://spdx.org/rdf/3/terms/Security/VexJustificationType/vulnerableCodeNotPresent node88
node88 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>vulnerableCodeNotPresent</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Security/VexJustificationType/vulnerableCodeNotPresent' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Security/VexJustificationType/vulnerableCodeNotPresent</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;The product is not affected because the code underlying the vulnerability is not present in the product.&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;The product is not affected because the code underlying the vulnerability is not present in the product.&quot;@en</td></tr></table> > ] 
