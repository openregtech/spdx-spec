# https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/isci node363
node363 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>isci</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/isci' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/isci</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;International Standard Collection Identifier (ISCI) is a variable-length identifier standardized by ISO 27730 &lt;https://www.iso.org/standard/44293.html&gt; for identifying collections held by libraries, archives, museums, and other memory institutions. It consists of two parts: the identifier for the assigning organization (an ISIL) enclosed in square brackets, followed by a local collection identifier string (e.g., [FR-751041001]Casadesus1).&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;International Standard Collection Identifier (ISCI) is a variable-length identifier standardized by ISO 27730 &lt;https://www.iso.org/standard/44293.html&gt; for identifying collections held by libraries, archives, museums, and other memory institutions. It consists of two parts: the identifier for the assigning organization (an ISIL) enclosed in square brackets, followed by a local collection identifier string (e.g., [FR-751041001]Casadesus1).&quot;@en</td></tr></table> > ] 
# https://spdx.org/rdf/3/terms/Software/Sbom node364
node364 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Sbom</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Software/Sbom' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Software/Sbom</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;A collection of SPDX Elements describing a single package.&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;A collection of SPDX Elements describing a single package.&quot;@en</td></tr><tr><td align='left'>skos:note</td><td align='left'>&quot;A Software Bill of Materials (SBOM) is a collection of SPDX Elements describing
a single package.

This could include details of the content and composition of the product,
provenance details of the product and/or its composition, licensing
information, known quality or security issues, etc.&quot;@en</td></tr></table> > ] 
