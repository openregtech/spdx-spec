# https://spdx.org/rdf/3/terms/Core/description node1004
node1004 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>description</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/description' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/description</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Provides a detailed description of the Element.&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;Provides a detailed description of the Element.&quot;@en</td></tr><tr><td align='left'>skos:note</td><td align='left'>&quot;This field is a detailed description of the Element. It may also be extracted
