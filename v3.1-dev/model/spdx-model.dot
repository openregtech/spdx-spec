# https://spdx.org/rdf/3/terms/Software/contentIdentifier node1200
node1200 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>contentIdentifier</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Software/contentIdentifier' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Software/contentIdentifier</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;A canonical, unique, immutable identifier of the artifact content, that may be
