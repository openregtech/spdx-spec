# https://spdx.org/rdf/3/terms/SimpleLicensing/licenseListVersion node676
node676 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>licenseListVersion</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/SimpleLicensing/licenseListVersion' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/SimpleLicensing/licenseListVersion</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;The version of the SPDX License List used in the license expression.&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;The version of the SPDX License List used in the license expression.&quot;@en</td></tr><tr><td align='left'>skos:note</td><td align='left'>&quot;Recognizing that licenses are added to the
SPDX License List &lt;https://spdx.org/licenses/&gt; with each
subsequent version, the intent is to provide consumers with the version of the
SPDX License List used.

This anticipates that in the future, license expression can used a
version of the SPDX License List that is older than the then current one.

The specified version of the SPDX License List shall include all listed licenses
and exceptions referenced in the expression.&quot;@en</td></tr></table> > ] 
# https://spdx.org/rdf/3/terms/Core/standardName node677
node677 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>standardName</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/standardName' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/standardName</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;The name of a relevant standard that may apply to an artifact.&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;The name of a relevant standard that may apply to an artifact.&quot;@en</td></tr><tr><td align='left'>skos:note</td><td align='left'>&quot;Various standards may be relevant or useful to capture for specific artifacts.

This does not imply that the artifact is compliant with the standard,
but rather that the standard is used as a reference or guideline for
the design, implementation, production, or evaluation of the artifact.

For compliance with a standard, use the standardCompliance property instead.&quot;@en</td></tr></table> > ] 
