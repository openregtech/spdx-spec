# https://spdx.org/rdf/3/terms/FunctionalSafety/VerificationType/inspection node1616
node1616 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>inspection</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/FunctionalSafety/VerificationType/inspection' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/FunctionalSafety/VerificationType/inspection</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;A thorough examination or checking of documentation, records, processes, or systems to confirm compliance or adherence. An inspection needs to have a defined set of acceptance criteria (e.g. a checklist), a documentation of roles involved in the inspection (e.g. to document the inspector&#x27;s independence) and a clear documentation of when and how it was performed.&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;A thorough examination or checking of documentation, records, processes, or systems to confirm compliance or adherence. An inspection needs to have a defined set of acceptance criteria (e.g. a checklist), a documentation of roles involved in the inspection (e.g. to document the inspector&#x27;s independence) and a clear documentation of when and how it was performed.&quot;@en</td></tr></table> > ] 
# https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/issn node1617
node1617 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>issn</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/issn' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/issn</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;International Standard Serial Number (ISSN) &lt;https://www.issn.org/understanding-the-issn/what-is-an-issn/&gt; is an eight-digit identifier for serial publications and other continuing resources standardized by ISO 3297 &lt;https://www.iso.org/standard/84536.html&gt;. It consists of two groups of four digits separated by a hyphen, where the final character is a check digit that may be an &quot;X&quot;. The hyphen is retained when the identifier is stored electronically to maintain the standard 9-character string format (e.g., 1464-3693). The ISSN is media-specific; the same journal title may be assigned different identifiers for its physical and digital versions.&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;International Standard Serial Number (ISSN) &lt;https://www.issn.org/understanding-the-issn/what-is-an-issn/&gt; is an eight-digit identifier for serial publications and other continuing resources standardized by ISO 3297 &lt;https://www.iso.org/standard/84536.html&gt;. It consists of two groups of four digits separated by a hyphen, where the final character is a check digit that may be an &quot;X&quot;. The hyphen is retained when the identifier is stored electronically to maintain the standard 9-character string format (e.g., 1464-3693). The ISSN is media-specific; the same journal title may be assigned different identifiers for its physical and digital versions.&quot;@en</td></tr></table> > ] 
