# https://spdx.org/rdf/3/terms/Core/SupportType/deployed node313
node313 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>deployed</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/SupportType/deployed' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/SupportType/deployed</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;In addition to being supported by the supplier, the software is known to have been deployed and is in use. For a software as a service provider, this implies the software is now available as a service.&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;In addition to being supported by the supplier, the software is known to have been deployed and is in use. For a software as a service provider, this implies the software is now available as a service.&quot;@en</td></tr></table> > ] 
