# https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/nli node46
node46 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>nli</B></td></tr><tr><td href='https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/nli' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/nli</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Natural Location Identifier (NLI) &lt;https://eccma.org/enli-eccma-natural-location-identifier/&gt; is a 14- or 15-character alphanumeric string standardized by ISO 8000-118 &lt;https://www.iso.org/standard/85428.html&gt; that uniquely identifies a three-dimensional geographic point location. The identifier is generated from geodetic coordinates and elevation data. For electronic storage, the ISO.NLI: prefix shall be retained (e.g., ISO.NLI:41TS8M-A8ELTQ-H2).&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;Natural Location Identifier (NLI) &lt;https://eccma.org/enli-eccma-natural-location-identifier/&gt; is a 14- or 15-character alphanumeric string standardized by ISO 8000-118 &lt;https://www.iso.org/standard/85428.html&gt; that uniquely identifies a three-dimensional geographic point location. The identifier is generated from geodetic coordinates and elevation data. For electronic storage, the ISO.NLI: prefix shall be retained (e.g., ISO.NLI:41TS8M-A8ELTQ-H2).&quot;@en</td></tr></table> > ] 
# https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/iscc node47
node47 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>iscc</B></td></tr><tr><td href='https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/iscc' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/iscc</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;International Standard Content Code (ISCC) &lt;https://iscc.io/&gt; is a content-derived identifier standardized by ISO 24138 &lt;https://www.iso.org/standard/77899.html&gt; for identifying digital assets. ISCC can be used in conjunction with other schemes, such as DOI, ISAN, ISBN, ISRC, ISSN and ISWC. A standard ISCC-CODE is build from multiple ISCC-UNITs. Each unit serve a different purpose. An ISCC-CODE typically look like ISCC:KACT4EBWK27737D2AYCJRAL5Z36G76RFRMO4554RU26HZ4ORJGIVHDI.&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;International Standard Content Code (ISCC) &lt;https://iscc.io/&gt; is a content-derived identifier standardized by ISO 24138 &lt;https://www.iso.org/standard/77899.html&gt; for identifying digital assets. ISCC can be used in conjunction with other schemes, such as DOI, ISAN, ISBN, ISRC, ISSN and ISWC. A standard ISCC-CODE is build from multiple ISCC-UNITs. Each unit serve a different purpose. An ISCC-CODE typically look like ISCC:KACT4EBWK27737D2AYCJRAL5Z36G76RFRMO4554RU26HZ4ORJGIVHDI.&quot;@en</td></tr></table> > ] 
