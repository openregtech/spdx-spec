# https://spdx.org/rdf/3/terms/Core/typeFromSource node277
node277 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>typeFromSource</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/typeFromSource' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/typeFromSource</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;typeFromSource is a value used to define an item within the definitionSource.&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;typeFromSource is a value used to define an item within the definitionSource.&quot;@en</td></tr><tr><td align='left'>skos:note</td><td align='left'>&quot;A typeFromSource is a specific term or label assigned within a definitionSource to define or identify an item, concept, or category.
