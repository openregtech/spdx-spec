# https://spdx.org/rdf/3/terms/Security/percentile node94
node94 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>percentile</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Security/percentile' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Security/percentile</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;The percentile of the current probability score.&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;The percentile of the current probability score.&quot;@en</td></tr><tr><td align='left'>skos:note</td><td align='left'>&quot;The percentile between 0 and 1 (0 and 100%) of the current probability score,
the proportion of all scored vulnerabilities with the same or a lower
