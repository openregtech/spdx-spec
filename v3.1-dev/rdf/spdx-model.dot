# https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/eli node850
node850 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>eli</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/eli' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/eli</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;European Legislation Identifier (ELI) &lt;https://eur-lex.europa.eu/content/help/eurlex-content/eli.html&gt; is a Uniform Resource Identifier (URI) that uniquely identifies a legal resource, typically consisting of a document type, adoption year, and document number (e.g., http://data.europa.eu/eli/reg/2024/2847/oj).&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;European Legislation Identifier (ELI) &lt;https://eur-lex.europa.eu/content/help/eurlex-content/eli.html&gt; is a Uniform Resource Identifier (URI) that uniquely identifies a legal resource, typically consisting of a document type, adoption year, and document number (e.g., http://data.europa.eu/eli/reg/2024/2847/oj).&quot;@en</td></tr></table> > ] 
# https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/iscc node851
node851 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>iscc</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/iscc' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/iscc</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;International Standard Content Code (ISCC) &lt;https://iscc.io/&gt; is a content-derived identifier standardized by ISO 24138 &lt;https://www.iso.org/standard/77899.html&gt; for identifying digital assets. ISCC can be used in conjunction with other schemes, such as DOI, ISAN, ISBN, ISRC, ISSN and ISWC. A standard ISCC-CODE is build from multiple ISCC-UNITs. Each unit serve a different purpose. An ISCC-CODE typically look like ISCC:KACT4EBWK27737D2AYCJRAL5Z36G76RFRMO4554RU26HZ4ORJGIVHDI.&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;International Standard Content Code (ISCC) &lt;https://iscc.io/&gt; is a content-derived identifier standardized by ISO 24138 &lt;https://www.iso.org/standard/77899.html&gt; for identifying digital assets. ISCC can be used in conjunction with other schemes, such as DOI, ISAN, ISBN, ISRC, ISSN and ISWC. A standard ISCC-CODE is build from multiple ISCC-UNITs. Each unit serve a different purpose. An ISCC-CODE typically look like ISCC:KACT4EBWK27737D2AYCJRAL5Z36G76RFRMO4554RU26HZ4ORJGIVHDI.&quot;@en</td></tr></table> > ] 
