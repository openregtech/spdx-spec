# https://spdx.org/rdf/3/terms/AI/informationAboutApplication node1085
node1085 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>informationAboutApplication</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/AI/informationAboutApplication' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/AI/informationAboutApplication</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Information about the AI software, not including the model description.&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;Information about the AI software, not including the model description.&quot;@en</td></tr><tr><td align='left'>skos:note</td><td align='left'>&quot;A free-form text description of how the AI model is used within the software.

It should include any relevant information, such as pre-processing steps,
third-party APIs, and other pertinent details.

It can also include:

- Functionality provided by the AI model within the software application,
  including: any specific tasks or decisions it is designed to perform;
  any pre-processing steps that are applied to the input data before it is
  fed into the AI model for inference, such as data cleaning, normalization,
  or feature extraction;
  and any third-party APIs or services that are used in conjunction with
  the AI model, such as data sources, cloud services, or other AI models.
- Description of any dependencies or requirements needed to run the AI model
  within the software application, including: specific hardware,
  software libraries, and operating systems.&quot;@en</td></tr></table> > ] 
# https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/nli node1086
node1086 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>nli</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/nli' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/nli</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Natural Location Identifier (NLI) &lt;https://eccma.org/enli-eccma-natural-location-identifier/&gt; is a 14- or 15-character alphanumeric string standardized by ISO 8000-118 &lt;https://www.iso.org/standard/85428.html&gt; that uniquely identifies a three-dimensional geographic point location. The identifier is generated from geodetic coordinates and elevation data. For electronic storage, the ISO.NLI: prefix shall be retained (e.g., ISO.NLI:41TS8M-A8ELTQ-H2).&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;Natural Location Identifier (NLI) &lt;https://eccma.org/enli-eccma-natural-location-identifier/&gt; is a 14- or 15-character alphanumeric string standardized by ISO 8000-118 &lt;https://www.iso.org/standard/85428.html&gt; that uniquely identifies a three-dimensional geographic point location. The identifier is generated from geodetic coordinates and elevation data. For electronic storage, the ISO.NLI: prefix shall be retained (e.g., ISO.NLI:41TS8M-A8ELTQ-H2).&quot;@en</td></tr></table> > ] 
