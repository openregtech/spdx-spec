# https://spdx.org/rdf/3.1/terms/Software/Snippet node1441
node1441 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Snippet</B></td></tr><tr><td href='https://spdx.org/rdf/3.1/terms/Software/Snippet' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3.1/terms/Software/Snippet</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Describes a certain part of a file.&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;Describes a certain part of a file.&quot;@en</td></tr><tr><td align='left'>skos:note</td><td align='left'>&quot;A Snippet describes a certain part of a file and can be used when the file is
known to have some content that has been included from another original source.

Snippets are useful for denoting when part of a file may have been originally
created under another license or copied from a place with a known
vulnerability.&quot;@en</td></tr></table> > ] 
