node652 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>adler32</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/HashAlgorithm/adler32' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/HashAlgorithm/adler32</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Adler-32 checksum is part of the widely used zlib compression library as defined in RFC 1950 &lt;https://datatracker.ietf.org/doc/rfc1950/&gt; Section 2.3.&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;Adler-32 checksum is part of the widely used zlib compression library as defined in RFC 1950 &lt;https://datatracker.ietf.org/doc/rfc1950/&gt; Section 2.3.&quot;@en</td></tr></table> > ] 
# https://spdx.org/rdf/3/terms/Core/RelationshipType/other node653
