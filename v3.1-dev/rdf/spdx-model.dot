# https://spdx.org/rdf/3.1/terms/ExpandedLicensing/standardAdditionTemplate node1598
node1598 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>standardAdditionTemplate</B></td></tr><tr><td href='https://spdx.org/rdf/3.1/terms/ExpandedLicensing/standardAdditionTemplate' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3.1/terms/ExpandedLicensing/standardAdditionTemplate</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Identifies the full text of a LicenseAddition, in SPDX templating format.&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;Identifies the full text of a LicenseAddition, in SPDX templating format.&quot;@en</td></tr><tr><td align='left'>skos:note</td><td align='left'>&quot;A standardAdditionTemplate contains a license addition template which describes
sections of the LicenseAddition text which can be varied.

See the Legacy Text Template format section of the
SPDX License List Matching Guidelines
for format information.

It is recommended to use licenseXml instead, as it can
capture all the text and metadata associated with a license.&quot;@en</td></tr></table> > ] 
# https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/ibid node1599
node1599 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>ibid</B></td></tr><tr><td href='https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/ibid' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/ibid</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;International Business Identifier (IBID) &lt;https://ekys.org/business_identifiers/&gt; is a verifiable unique identifier for legal entities as defined in the ISO/DIS 25500-3 &lt;https://www.iso.org/standard/87705.html&gt; draft standard. It is composed of three data elements: the International Business Registration Number (IBRN), the legal name, and the date of origin formatted as eight numeric characters (YYYYMMDD). Each element is separated by a pipe character (|) (e.g., US-DE.BER:3031657|Code Management Association|19990420).&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;International Business Identifier (IBID) &lt;https://ekys.org/business_identifiers/&gt; is a verifiable unique identifier for legal entities as defined in the ISO/DIS 25500-3 &lt;https://www.iso.org/standard/87705.html&gt; draft standard. It is composed of three data elements: the International Business Registration Number (IBRN), the legal name, and the date of origin formatted as eight numeric characters (YYYYMMDD). Each element is separated by a pipe character (|) (e.g., US-DE.BER:3031657|Code Management Association|19990420).&quot;@en</td></tr></table> > ] 
