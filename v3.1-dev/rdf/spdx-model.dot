# https://spdx.org/rdf/3/terms/FunctionalSafety/verificationPostcondition node359
node359 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>verificationPostcondition</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/FunctionalSafety/verificationPostcondition' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/FunctionalSafety/verificationPostcondition</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Verification postcondition that are true immediately after a verification method has been performed&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;Verification postcondition that are true immediately after a verification method has been performed&quot;@en</td></tr><tr><td align='left'>skos:note</td><td align='left'>&quot;Verification postcondition are explicit criteria, states, or conditions that are true immediately after a verification method (such as a test, inspection, or analysis) has been performed, confirming the successful execution and complete outcomes of the verification.&quot;@en</td></tr></table> > ] 
# https://spdx.org/rdf/3/terms/Core/Regulation node360
node360 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Regulation</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/Regulation' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/Regulation</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Regulation represents a rule or directive maintained by an authority.&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;Regulation represents a rule or directive maintained by an authority.&quot;@en</td></tr><tr><td align='left'>skos:note</td><td align='left'>&quot;The Regulation class represents any rules or directives enforced by an official authority.
Regulations within this class can be either mandatory or voluntary.

Examples of these regulations include the EU Radio Equipment Directive, EU Cyber Resilience Act,
the Japan Cyber STAR, or the U.S. Cyber Trust Mark.&quot;@en</td></tr></table> > ] 
