# https://spdx.org/rdf/3.1/terms/Build/configSourceUri node1371
node1371 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>configSourceUri</B></td></tr><tr><td href='https://spdx.org/rdf/3.1/terms/Build/configSourceUri' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3.1/terms/Build/configSourceUri</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Property that describes the URI of the build configuration source file.&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;Property that describes the URI of the build configuration source file.&quot;@en</td></tr><tr><td align='left'>skos:note</td><td align='left'>&quot;If a build configuration exists for the toolchain or platform performing the
build, the configSourceUri of a build is the URI of that build configuration,
according to the buildType.

For example, a build triggered by a GitHub Action is defined by a build
configuration YAML file. In this case, the configSourceUri is the URL of that
YAML file.&quot;@en</td></tr></table> > ] 
