# https://spdx.org/rdf/3.1/terms/Core/SupportType/deployed node1671
node1671 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>deployed</B></td></tr><tr><td href='https://spdx.org/rdf/3.1/terms/Core/SupportType/deployed' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3.1/terms/Core/SupportType/deployed</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;In addition to being supported by the supplier, the software is known to have been deployed and is in use. For a software as a service provider, this implies the software is now available as a service.&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;In addition to being supported by the supplier, the software is known to have been deployed and is in use. For a software as a service provider, this implies the software is now available as a service.&quot;@en</td></tr></table> > ] 
# https://spdx.org/rdf/3.1/terms/Software/lineRange node1672
node1672 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>lineRange</B></td></tr><tr><td href='https://spdx.org/rdf/3.1/terms/Software/lineRange' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3.1/terms/Software/lineRange</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Defines the line range in the original host file that the snippet information
applies to.&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;Defines the line range in the original host file that the snippet information
applies to.&quot;@en</td></tr><tr><td align='left'>skos:note</td><td align='left'>&quot;This field defines the line range in the original host file that the snippet
information applies to.

If there is a disagreement between the byte range and line range, the byte
range values will take precedence.

A range of lines is a convenient reference for those files where there is a
known line delimiter.
The choice was made to start the numbering of the lines at 1 to be consistent
with the W3C pointer method vocabulary.&quot;@en</td></tr></table> > ] 
