node1805 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B></B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Lite' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Lite</font></td></tr><tr><td align='left'>vann:preferredNamespacePrefix</td><td align='left'>&quot;spdx-lite&quot;</td></tr><tr><td align='left'>vann:preferredNamespaceUri</td><td align='left'>&quot;https://spdx.org/rdf/3/terms/Lite&quot;</td></tr></table> > ] 
