node627 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>demonstration</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/FunctionalSafety/VerificationType/demonstration' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/FunctionalSafety/VerificationType/demonstration</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Demonstrating and monitoring or recording that the item under verification to confirm that a requirement is met by the item under verification.&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;Demonstrating and monitoring or recording that the item under verification to confirm that a requirement is met by the item under verification.&quot;@en</td></tr></table> > ] 
