# https://spdx.org/rdf/3/terms/SupplyChain/plannedTransportRoutes node1481
node1481 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>plannedTransportRoutes</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/SupplyChain/plannedTransportRoutes' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/SupplyChain/plannedTransportRoutes</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;A transport route refers to the planned path or network used to move people, goods, data, or resources from one location to another.&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;A transport route refers to the planned path or network used to move people, goods, data, or resources from one location to another.&quot;@en</td></tr><tr><td align='left'>skos:note</td><td align='left'>&quot;A transport route is the planned path taken by people, products, goods, data or resources. Transport routes vary by product type, safety requirements, business constraints or other factors.&quot;@en</td></tr></table> > ] 
# https://spdx.org/rdf/3/terms/FunctionalSafety/verificationMethod node1482
