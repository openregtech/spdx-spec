node1252 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>doi</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/doi' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/doi</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Digital Object Identifier (DOI) &lt;https://www.doi.org/the-identifier/what-is-a-doi/&gt; is a unique, ISO 26324 &lt;https://www.iso.org/standard/88862.html&gt;-standardized identifier for physical, digital, or abstract objects, formatted as a prefix and suffix separated by a forward slash (e.g., 10.1000/182).&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;Digital Object Identifier (DOI) &lt;https://www.doi.org/the-identifier/what-is-a-doi/&gt; is a unique, ISO 26324 &lt;https://www.iso.org/standard/88862.html&gt;-standardized identifier for physical, digital, or abstract objects, formatted as a prefix and suffix separated by a forward slash (e.g., 10.1000/182).&quot;@en</td></tr></table> > ] 
