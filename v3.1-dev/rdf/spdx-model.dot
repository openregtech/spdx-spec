# https://spdx.org/rdf/3/terms/Core/SupportType/support node1320
node1320 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>support</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/SupportType/support' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/SupportType/support</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;The artifact has been released, and is supported from the supplier. There is a validUntilDate that can provide additional information about the duration of support.&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;The artifact has been released, and is supported from the supplier. There is a validUntilDate that can provide additional information about the duration of support.&quot;@en</td></tr></table> > ] 
