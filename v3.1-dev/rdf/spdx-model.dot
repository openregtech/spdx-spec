# https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/iswc node972
node972 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>iswc</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/iswc' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/iswc</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;International Standard Musical Work Code (ISWC) &lt;https://www.iswc.org/iswc&gt; is an 11-character unique identifier standardized by ISO 15707 &lt;https://www.iso.org/standard/83125.html&gt; for musical works (compositions) as distinct from specific recordings. While the &quot;ISWC&quot; label and grouping separators (dots and hyphens) are used for human readability, they shall be omitted when the identifier is stored electronically (e.g., T0017812031).&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;International Standard Musical Work Code (ISWC) &lt;https://www.iswc.org/iswc&gt; is an 11-character unique identifier standardized by ISO 15707 &lt;https://www.iso.org/standard/83125.html&gt; for musical works (compositions) as distinct from specific recordings. While the &quot;ISWC&quot; label and grouping separators (dots and hyphens) are used for human readability, they shall be omitted when the identifier is stored electronically (e.g., T0017812031).&quot;@en</td></tr></table> > ] 
# https://spdx.org/rdf/3/terms/Extension/cdxProperty node973
node973 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>cdxProperty</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Extension/cdxProperty' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Extension/cdxProperty</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Provides a map of a property name to a value.&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;Provides a map of a property name to a value.&quot;@en</td></tr><tr><td align='left'>skos:note</td><td align='left'>&quot;This field provides a mapping of a name to a value.

This is intended to be compatible with the CycloneDX property properties.

Unlike key-value stores, properties in CdxPropertiesExtension support duplicate
names, each potentially having different values.&quot;@en</td></tr></table> > ] 
# https://spdx.org/rdf/3/terms/Software/SoftwarePurpose/diskImage node974
node974 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>diskImage</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Software/SoftwarePurpose/diskImage' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Software/SoftwarePurpose/diskImage</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;The Element refers to a disk image that can be written to a disk, booted in a VM, etc. A disk image typically contains most or all of the components necessary to boot, such as bootloaders, kernels, firmware, userspace, etc.&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;The Element refers to a disk image that can be written to a disk, booted in a VM, etc. A disk image typically contains most or all of the components necessary to boot, such as bootloaders, kernels, firmware, userspace, etc.&quot;@en</td></tr></table> > ] 
