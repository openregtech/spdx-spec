# https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/ibid node375
node375 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>ibid</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/ibid' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/ibid</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;International Business Identifier (IBID) &lt;https://ekys.org/business_identifiers/&gt; is a verifiable unique identifier for legal entities as defined in the ISO/DIS 25500-3 &lt;https://www.iso.org/standard/87705.html&gt; draft standard. It is composed of three data elements: the International Business Registration Number (IBRN), the legal name, and the date of origin formatted as eight numeric characters (YYYYMMDD). Each element is separated by a pipe character (|) (e.g., US-DE.BER:3031657|Code Management Association|19990420).&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;International Business Identifier (IBID) &lt;https://ekys.org/business_identifiers/&gt; is a verifiable unique identifier for legal entities as defined in the ISO/DIS 25500-3 &lt;https://www.iso.org/standard/87705.html&gt; draft standard. It is composed of three data elements: the International Business Registration Number (IBRN), the legal name, and the date of origin formatted as eight numeric characters (YYYYMMDD). Each element is separated by a pipe character (|) (e.g., US-DE.BER:3031657|Code Management Association|19990420).&quot;@en</td></tr></table> > ] 
# https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/ismn node376
node376 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>ismn</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/ismn' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/ismn</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;International Standard Music Number (ISMN) &lt;https://ismn-international.org/ismn/the-ismn/&gt; is a unique numeric identifier for printed music (notated music) standardized by ISO 10957 &lt;https://www.iso.org/standard/83122.html&gt;. It consists of either 10 characters (starting with the letter &quot;M&quot; for assignments prior to January 1, 2008) or 13 digits. A 13-digit ISMN is composed of four parts: the GS1 prefix 979-0, a registrant element, an item element, and a check digit. While elements may be divided by spaces or hyphens for human readability, these separators shall be omitted when the identifier is stored electronically (e.g., 9790006538424).&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;International Standard Music Number (ISMN) &lt;https://ismn-international.org/ismn/the-ismn/&gt; is a unique numeric identifier for printed music (notated music) standardized by ISO 10957 &lt;https://www.iso.org/standard/83122.html&gt;. It consists of either 10 characters (starting with the letter &quot;M&quot; for assignments prior to January 1, 2008) or 13 digits. A 13-digit ISMN is composed of four parts: the GS1 prefix 979-0, a registrant element, an item element, and a check digit. While elements may be divided by spaces or hyphens for human readability, these separators shall be omitted when the identifier is stored electronically (e.g., 9790006538424).&quot;@en</td></tr></table> > ] 
# N1ce2789dd2f64e63b50dc26649822220 node377
node377 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N1ce2789dd2f64e63b50dc26649822220</B></td></tr><tr><td href='N1ce2789dd2f64e63b50dc26649822220' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N1ce2789dd2f64e63b50dc26649822220</font></td></tr></table> > ] 
# https://spdx.org/rdf/3/terms/ExpandedLicensing/OrLaterOperator node378
node378 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>OrLaterOperator</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/ExpandedLicensing/OrLaterOperator' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/ExpandedLicensing/OrLaterOperator</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Portion of an AnyLicenseInfo representing this version, or any later version,
of the indicated License.&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;Portion of an AnyLicenseInfo representing this version, or any later version,
of the indicated License.&quot;@en</td></tr><tr><td align='left'>skos:note</td><td align='left'>&quot;An OrLaterOperator indicates that this portion of the AnyLicenseInfo
represents either (1) the specified version of the corresponding License, or
(2) any later version of that License. It is represented in the SPDX License
Expression Syntax by the + operator.

It is context-dependent, and unspecified by SPDX, as to what constitutes a
&quot;later version&quot; of any particular License. Some Licenses may not be versioned,
or may not have clearly-defined ordering for versions. The consumer of SPDX
data will need to determine for themselves what meaning to attribute to a
&quot;later version&quot; operator for a particular License.&quot;@en</td></tr></table> > ] 
