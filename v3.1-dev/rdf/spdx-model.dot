node668 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>sha3_384</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/HashAlgorithm/sha3_384' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/HashAlgorithm/sha3_384</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;SHA-3 with a digest length of 384, as defined in FIPS 202 &lt;https://csrc.nist.gov/pubs/fips/202/final&gt;.&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;SHA-3 with a digest length of 384, as defined in FIPS 202 &lt;https://csrc.nist.gov/pubs/fips/202/final&gt;.&quot;@en</td></tr></table> > ] 
