# https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/isil node1285
node1285 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>isil</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/isil' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/isil</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;International Standard Identifier for Libraries and Related Organizations (ISIL) &lt;https://slks.dk/english/work-areas/libraries-and-literature/library-standards/isil/&gt; is a unique alphanumeric code for identifying libraries, archives, museums, and related organizations standardized by ISO 15511 &lt;https://www.iso.org/standard/77849.html&gt;. It consists of a prefix—which may be an ISO 3166-1 alpha-2 country code or a non-country code assigned by the ISIL Registration Authority—followed by a unit identifier, totaling up to 16 characters (e.g., FI-Sipoo-Sö or ZDB-1-SBD). Valid symbols include any alphanumeric character, solidus (/), hyphen-minus (-), or colon.&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;International Standard Identifier for Libraries and Related Organizations (ISIL) &lt;https://slks.dk/english/work-areas/libraries-and-literature/library-standards/isil/&gt; is a unique alphanumeric code for identifying libraries, archives, museums, and related organizations standardized by ISO 15511 &lt;https://www.iso.org/standard/77849.html&gt;. It consists of a prefix—which may be an ISO 3166-1 alpha-2 country code or a non-country code assigned by the ISIL Registration Authority—followed by a unit identifier, totaling up to 16 characters (e.g., FI-Sipoo-Sö or ZDB-1-SBD). Valid symbols include any alphanumeric character, solidus (/), hyphen-minus (-), or colon.&quot;@en</td></tr></table> > ] 
# Ncaa4d999fc414313abbe4625e58eab4d node1286
node1286 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Ncaa4d999fc414313abbe4625e58eab4d</B></td></tr><tr><td href='Ncaa4d999fc414313abbe4625e58eab4d' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Ncaa4d999fc414313abbe4625e58eab4d</font></td></tr><tr><td align='left'>sh:maxCount</td><td align='left'>&quot;1&quot;^^xsd:integer</td></tr><tr><td align='left'>sh:minCount</td><td align='left'>&quot;1&quot;^^xsd:integer</td></tr><tr><td align='left'>sh:pattern</td><td align='left'>&quot;^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(\.(0|[1-9][0-9]*))?$&quot;</td></tr></table> > ] 
