node654 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>cve</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/cve' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/cve</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Common Vulnerabilities and Exposures identifiers, an identifier for a specific software flaw defined within the official CVE Dictionary and that conforms to the CVE specification &lt;https://csrc.nist.gov/glossary/term/cve_id&gt;.&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;Common Vulnerabilities and Exposures identifiers, an identifier for a specific software flaw defined within the official CVE Dictionary and that conforms to the CVE specification &lt;https://csrc.nist.gov/glossary/term/cve_id&gt;.&quot;@en</td></tr></table> > ] 
