# https://spdx.org/rdf/3/terms/FunctionalSafety/EvidenceRelationship node685
node685 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>EvidenceRelationship</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/FunctionalSafety/EvidenceRelationship' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/FunctionalSafety/EvidenceRelationship</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;EvidenceRelationship defines the association between pieces of evidence and EvaluationResult.&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;EvidenceRelationship defines the association between pieces of evidence and EvaluationResult.&quot;@en</td></tr><tr><td align='left'>skos:note</td><td align='left'>&quot;EvidenceRelationship defines the association between pieces of evidence and EvaluationResult. This establishes traceability and contextual linkage between evidence items, supporting certification, verification, and audit activities.&quot;@en</td></tr></table> > ] 
