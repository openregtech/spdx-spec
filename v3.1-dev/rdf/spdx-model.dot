# https://spdx.org/rdf/3/terms/Core/headquartersLocation node514
node514 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>headquartersLocation</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/headquartersLocation' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/headquartersLocation</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;A location of the organization&#x27;s headquarters.&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;A location of the organization&#x27;s headquarters.&quot;@en</td></tr><tr><td align='left'>skos:note</td><td align='left'>&quot;Headquarters denotes the location where most or all of the important functions
of an organization are coordinated. In some jurisdictions, it represents the
central entity of a corporation that assumes full responsibility for managing
all business activities.

Accurate identification of an organization&#x27;s headquarters requires the
provision of relevant address data, including mailing, street, and geographic
point location.&quot;@en</td></tr></table> > ] 
