node1172 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>issn</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/issn' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/issn</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;International Standard Serial Number (ISSN) &lt;https://www.issn.org/understanding-the-issn/what-is-an-issn/&gt; is an eight-digit identifier for serial publications and other continuing resources standardized by ISO 3297 &lt;https://www.iso.org/standard/84536.html&gt;. It consists of two groups of four digits separated by a hyphen, where the final character is a check digit that may be an &quot;X&quot;. The hyphen is retained when the identifier is stored electronically to maintain the standard 9-character string format (e.g., 1464-3693). The ISSN is media-specific; the same journal title may be assigned different identifiers for its physical and digital versions.&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;International Standard Serial Number (ISSN) &lt;https://www.issn.org/understanding-the-issn/what-is-an-issn/&gt; is an eight-digit identifier for serial publications and other continuing resources standardized by ISO 3297 &lt;https://www.iso.org/standard/84536.html&gt;. It consists of two groups of four digits separated by a hyphen, where the final character is a check digit that may be an &quot;X&quot;. The hyphen is retained when the identifier is stored electronically to maintain the standard 9-character string format (e.g., 1464-3693). The ISSN is media-specific; the same journal title may be assigned different identifiers for its physical and digital versions.&quot;@en</td></tr></table> > ] 
# https://spdx.org/rdf/3/terms/Software/snippetFromFile node1173
node1173 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>snippetFromFile</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Software/snippetFromFile' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Software/snippetFromFile</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Defines the original host file that the snippet information applies to.&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;Defines the original host file that the snippet information applies to.&quot;@en</td></tr><tr><td align='left'>skos:note</td><td align='left'>&quot;The field identifies the file which contains the snippet.&quot;@en</td></tr></table> > ] 
# https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/bic node1174
node1174 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>bic</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/bic' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/bic</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Business Identifier Code (BIC), also known as SWIFT-BIC or SWIFT code, is a unique 8 or 11-character alphanumeric code standardized by ISO 9362 &lt;https://www.iso.org/standard/84108.html&gt; to identify financial and non-financial institutions (e.g., BBWCUS33).&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;Business Identifier Code (BIC), also known as SWIFT-BIC or SWIFT code, is a unique 8 or 11-character alphanumeric code standardized by ISO 9362 &lt;https://www.iso.org/standard/84108.html&gt; to identify financial and non-financial institutions (e.g., BBWCUS33).&quot;@en</td></tr></table> > ] 
