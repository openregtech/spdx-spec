# https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/isbn node762
node762 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>isbn</B></td></tr><tr><td href='https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/isbn' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/isbn</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;International Standard Book Number (ISBN) &lt;https://www.isbn-international.org/content/isbn-users-manual/29&gt; is a unique numeric identifier for monographic publications standardized by ISO 2108 &lt;https://www.iso.org/standard/65483.html&gt;. It consists of either 10 digits (for assignments prior to January 1, 2007) or 13 digits. A 13-digit ISBN is composed of five parts: a GS1 prefix, a registration group, a registrant, a publication element, and a check digit. While elements may be divided by spaces or hyphens for human readability, these separators shall be omitted when the identifier is stored electronically (e.g., 9780198836063).&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;International Standard Book Number (ISBN) &lt;https://www.isbn-international.org/content/isbn-users-manual/29&gt; is a unique numeric identifier for monographic publications standardized by ISO 2108 &lt;https://www.iso.org/standard/65483.html&gt;. It consists of either 10 digits (for assignments prior to January 1, 2007) or 13 digits. A 13-digit ISBN is composed of five parts: a GS1 prefix, a registration group, a registrant, a publication element, and a check digit. While elements may be divided by spaces or hyphens for human readability, these separators shall be omitted when the identifier is stored electronically (e.g., 9780198836063).&quot;@en</td></tr></table> > ] 
# https://spdx.org/rdf/3.1/terms/Build/buildStartTime node763
node763 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>buildStartTime</B></td></tr><tr><td href='https://spdx.org/rdf/3.1/terms/Build/buildStartTime' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3.1/terms/Build/buildStartTime</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;**DEPRECATED in SPDX 3.1.**
Use /Core/startTime instead.

Property describing the start time of a build.&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;**DEPRECATED in SPDX 3.1.**
Use /Core/startTime instead.

Property describing the start time of a build.&quot;@en</td></tr><tr><td align='left'>skos:note</td><td align='left'>&quot;**NOTE:**
This property is deprecated and only included for backward compatibility.
New documents should use
/Core/startTime
instead.

buildStartTime is the time at which a build is triggered.

The builder typically records this value.&quot;@en</td></tr></table> > ] 
