# https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/swid node1449
node1449 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>swid</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/swid' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/swid</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Concise Software Identification (CoSWID) tag, as defined in RFC 9393 &lt;https://datatracker.ietf.org/doc/rfc9393/&gt; Section 2.3.&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;Concise Software Identification (CoSWID) tag, as defined in RFC 9393 &lt;https://datatracker.ietf.org/doc/rfc9393/&gt; Section 2.3.&quot;@en</td></tr></table> > ] 
# https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/isil node1450
node1450 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>isil</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/isil' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/isil</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;International Standard Identifier for Libraries and Related Organizations (ISIL) &lt;https://slks.dk/english/work-areas/libraries-and-literature/library-standards/isil/&gt; is a unique alphanumeric code for identifying libraries, archives, museums, and related organizations standardized by ISO 15511 &lt;https://www.iso.org/standard/77849.html&gt;. It consists of a prefix—which may be an ISO 3166-1 alpha-2 country code or a non-country code assigned by the ISIL Registration Authority—followed by a unit identifier, totaling up to 16 characters (e.g., FI-Sipoo-Sö or ZDB-1-SBD). Valid symbols include any alphanumeric character, solidus (/), hyphen-minus (-), or colon.&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;International Standard Identifier for Libraries and Related Organizations (ISIL) &lt;https://slks.dk/english/work-areas/libraries-and-literature/library-standards/isil/&gt; is a unique alphanumeric code for identifying libraries, archives, museums, and related organizations standardized by ISO 15511 &lt;https://www.iso.org/standard/77849.html&gt;. It consists of a prefix—which may be an ISO 3166-1 alpha-2 country code or a non-country code assigned by the ISIL Registration Authority—followed by a unit identifier, totaling up to 16 characters (e.g., FI-Sipoo-Sö or ZDB-1-SBD). Valid symbols include any alphanumeric character, solidus (/), hyphen-minus (-), or colon.&quot;@en</td></tr></table> > ] 
# https://spdx.org/rdf/3/terms/Core/assignedBy node1451
node1451 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>assignedBy</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/assignedBy' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/assignedBy</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;assignedBy identifies the agent that grants or assigns the role to the target element.&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;assignedBy identifies the agent that grants or assigns the role to the target element.&quot;@en</td></tr><tr><td align='left'>skos:note</td><td align='left'>&quot;assignedBy is an property that specifies the agent responsible for assigning the givenRole to the target element. This property tracks who assigned the role, providing accountability and traceability for role assignments.&quot;@en</td></tr></table> > ] 
# https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/iscc node1452
node1452 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>iscc</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/iscc' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/iscc</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;International Standard Content Code (ISCC) &lt;https://iscc.io/&gt; is a content-derived identifier standardized by ISO 24138 &lt;https://www.iso.org/standard/77899.html&gt; for identifying digital assets. ISCC can be used in conjunction with other schemes, such as DOI, ISAN, ISBN, ISRC, ISSN and ISWC. A standard ISCC-CODE is build from multiple ISCC-UNITs. Each unit serve a different purpose. An ISCC-CODE typically look like ISCC:KACT4EBWK27737D2AYCJRAL5Z36G76RFRMO4554RU26HZ4ORJGIVHDI.&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;International Standard Content Code (ISCC) &lt;https://iscc.io/&gt; is a content-derived identifier standardized by ISO 24138 &lt;https://www.iso.org/standard/77899.html&gt; for identifying digital assets. ISCC can be used in conjunction with other schemes, such as DOI, ISAN, ISBN, ISRC, ISSN and ISWC. A standard ISCC-CODE is build from multiple ISCC-UNITs. Each unit serve a different purpose. An ISCC-CODE typically look like ISCC:KACT4EBWK27737D2AYCJRAL5Z36G76RFRMO4554RU26HZ4ORJGIVHDI.&quot;@en</td></tr></table> > ] 
