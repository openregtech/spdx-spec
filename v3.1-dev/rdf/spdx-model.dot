# https://spdx.org/rdf/3/terms/Core/Role node35
node35 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Role</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/Role' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/Role</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;A Role defines a specific position, function, or capacity that an entity may assume within any relevant context.&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;A Role defines a specific position, function, or capacity that an entity may assume within any relevant context.&quot;@en</td></tr><tr><td align='left'>skos:note</td><td align='left'>&quot;A Role defines a specific position, function, or capacity that an entity may assume within any relevant context. This context is intentionally broad and adaptable, capable of representing environments including, but not limited to, software builds, system architectures, project management structures, distribution channels, supply chain operations, lifecycle stages, or any other domain where entities perform specific functions. The Role class provides a structured mechanism to model these functional assignments independently of the entities themselves, allowing for reusable and standardized definitions of responsibilities and privileges across different SPDX documents and ecosystems.&quot;@en</td></tr></table> > ] 
