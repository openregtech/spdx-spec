node1207 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>buildSystem</B></td></tr><tr><td href='https://spdx.org/rdf/3.1/terms/Core/ExternalRefType/buildSystem' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3.1/terms/Core/ExternalRefType/buildSystem</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;A reference to a build system used to create or publish the package.&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;A reference to a build system used to create or publish the package.&quot;@en</td></tr></table> > ] 
