node985 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>syntactic</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Dataset/DatasetType/syntactic' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Dataset/DatasetType/syntactic</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Data describes the syntax or semantics of a language or text, such as a parse tree used for natural language processing.&quot;@en</td></tr><tr><td align='left'>skos:definition</td><td align='left'>&quot;Data describes the syntax or semantics of a language or text, such as a parse tree used for natural language processing.&quot;@en</td></tr></table> > ] 
