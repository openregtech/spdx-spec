["https://spdx.org/rdf/3.1/terms/Core/headquartersLocation", "http://www.w3.org/2000/01/rdf-schema#isDefinedBy", "https://spdx.org/rdf/3.1/terms/Core", "globalId", "", ""]
["https://spdx.org/rdf/3.1/terms/Hardware/ProductSpecification", "http://www.w3.org/2000/01/rdf-schema#label", "ProductSpecification", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:Nd07d18efab6544bba4ce53c4114da788", "http://www.w3.org/ns/shacl#path", "https://spdx.org/rdf/3.1/terms/SupplyChain/plannedStorageLocation", "globalId", "", ""]
["_:N628e934956ac46b39b99ebdbe0dc5a30", "http://www.w3.org/1999/02/22-rdf-syntax-ns#first", "https://spdx.org/rdf/3.1/terms/Core/LifecycleScopeType/decommission", "globalId", "", ""]
["https://spdx.org/rdf/3.1/terms/Core/Location", "http://www.w3.org/2004/02/skos/core#note", "Location is used to define the location, address or coordinates of a place.  Location data may include latitude and longitude (for geographical locations), IP addresses for network locations, MAC addresses for computer networks, or other identifiers that specify where something exists within a system. There is often a need to provide context about where each one is located in relation to other things around it (e.g., which city, country).", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:Na808eadca52b49db868bb76fa28fd3c2", "http://www.w3.org/1999/02/22-rdf-syntax-ns#rest", "_:Nfc4bdcccffff4f489d0d676e8d08a04e", "localId", "", ""]
["_:N05f919d7f74a465eb4cab1e8978b01ae", "http://www.w3.org/1999/02/22-rdf-syntax-ns#rest", "_:N13feddfb3b2a45e6a3cf652287923ade", "localId", "", ""]
["https://spdx.org/rdf/3.1/terms/Hardware/itemVersion", "http://www.w3.org/2000/01/rdf-schema#comment", "Version identifier for the item.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/Core/releaseTime", "http://www.w3.org/2000/01/rdf-schema#comment", "Specifies the time an artifact was released.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:Nf1b982ba673b45d0bf642e4cd976cfb9", "http://www.w3.org/ns/shacl#pattern", "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$", "http://www.w3.org/2001/XMLSchema#string", "", ""]
["https://spdx.org/rdf/3.1/terms/Core/SupportType/development", "http://www.w3.org/2004/02/skos/core#definition", "The artifact is in active development and is not considered ready for formal support from the supplier.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/Core/IsoAutomationLevel/autonomous", "http://www.w3.org/2000/01/rdf-schema#label", "autonomous", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
