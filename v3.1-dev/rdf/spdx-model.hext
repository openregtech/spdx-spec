["_:Nab94dd2d666b445f86a0fd521d5b91f6", "http://www.w3.org/1999/02/22-rdf-syntax-ns#rest", "_:Na2ff00db1caf4e84b876a755c14df4b8", "localId", "", ""]
["https://spdx.org/rdf/3/terms/SupplyChain/ReproduceProcess", "http://www.w3.org/2000/01/rdf-schema#label", "ReproduceProcess", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Software/SbomType/runtime", "http://www.w3.org/2000/01/rdf-schema#comment", "SBOM generated through instrumenting the system running the software, to capture only components present in the system, as well as external call-outs or dynamically loaded components. In some contexts, this may also be referred to as an \"Instrumented\" or \"Dynamic\" SBOM.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/FunctionalSafety/verificationPrecondition", "http://www.w3.org/2004/02/skos/core#note", "Verification preconditions are specific conditions, requirements, or initial states that are to be satisfied before a verification will be executed.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/other", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "http://www.w3.org/2002/07/owl#NamedIndividual", "globalId", "", ""]
