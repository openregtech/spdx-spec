["https://spdx.org/rdf/3.1/terms/Core/completeness", "http://www.w3.org/2004/02/skos/core#definition", "Provides information about the completeness of relationships.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
