["https://spdx.org/rdf/3.1/terms/Core/CreationInfo", "http://www.w3.org/2004/02/skos/core#note", "The CreationInfo provides information about who created the Element, and when\nand how it was created.\n\nThe dateTime created is often the date of last change\n(e.g., a git commit date), not the date when the SPDX data was created, as\ndoing so supports reproducible builds.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/Core/IsoAutomationLevel/fullAutomation", "http://www.w3.org/2000/01/rdf-schema#comment", "Level 5 - Full automation. The system is capable of performing its entire mission without external intervention.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/AI/informationAboutApplication", "http://www.w3.org/2000/01/rdf-schema#label", "informationAboutApplication", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
