["_:N868b748495cd4568bbf59fc7168441aa", "http://www.w3.org/1999/02/22-rdf-syntax-ns#first", "https://spdx.org/rdf/3/terms/Core/ExternalRefType/runtimeAnalysisReport", "globalId", "", ""]
["_:N45d095e4852e41919e8c062c0169991c", "http://www.w3.org/ns/shacl#path", "https://spdx.org/rdf/3/terms/AI/energyUnit", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/ExpandedLicensing/standardLicenseTemplate", "http://www.w3.org/2004/02/skos/core#note", "A standardLicenseTemplate contains a license template which describes sections\nof the License text which can be varied.\n\nSee the Legacy Text Template format section of the\nSPDX License List Matching Guidelines\nfor format information.\n\nIt is recommended to use licenseXml instead, as it can\ncapture all the text and metadata associated with a license.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/AI/informationAboutTraining", "http://www.w3.org/2004/02/skos/core#note", "A detailed explanation of the training process,\nincluding the specific techniques, algorithms, and methods employed.\n\nExamples include:\n\n- training data used to train the AI model, along with any relevant details\n  about its source, quality, and pre-processing steps;\n- specific training algorithms employed, including stochastic gradient descent,\n  backpropagation, and reinforcement learning;\n- specific training techniques used to improve the performance or accuracy\n  of the AI model, such as transfer learning, fine-tuning, or active learning;\n  and\n- any evaluation metrics used to assess the performance of the AI model\n  during the training process, including accuracy, precision, recall, and F1\n  score.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Operations/projectContract", "http://www.w3.org/2004/02/skos/core#note", "Link to the project contract.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/unitQUDT", "http://www.w3.org/2004/02/skos/core#definition", "QUDT unit is used for measurement criteria based on product type, region and use.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/ExpandedLicensing/CustomLicenseAddition", "http://www.w3.org/2000/01/rdf-schema#subClassOf", "https://spdx.org/rdf/3/terms/ExpandedLicensing/LicenseAddition", "globalId", "", ""]
