["https://spdx.org/rdf/3/terms/Software/SoftwarePurpose/specification", "http://www.w3.org/2000/01/rdf-schema#comment", "The Element is a plan, guideline or strategy how to create, perform or analyze an application.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/AnnotationType", "http://www.w3.org/2000/01/rdf-schema#comment", "Specifies the type of an annotation.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
