["https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/gln", "http://www.w3.org/2000/01/rdf-schema#label", "gln", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/FunctionalSafety/evidenceUUID", "http://www.w3.org/2004/02/skos/core#definition", "A evidenceUUID is a universally unique identifier (UUID) assigned to an entity, item, or requirement.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
