["https://spdx.org/rdf/3/terms/AI/safetyRiskAssessment", "http://www.w3.org/2000/01/rdf-schema#range", "https://spdx.org/rdf/3/terms/AI/SafetyRiskAssessmentType", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Core/HashAlgorithm", "http://www.w3.org/2000/01/rdf-schema#label", "HashAlgorithm", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:N4b175c33e8814555b28c90ff7406f42e", "http://www.w3.org/ns/shacl#message", "https://spdx.org/rdf/3/terms/ExpandedLicensing/LicenseAddition is abstract and must not be instantiated directly.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:N4b3f981a6b1e44f5948ab3972eeaa95b", "http://www.w3.org/ns/shacl#datatype", "http://www.w3.org/2001/XMLSchema#string", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Core/ExternalRefType/binaryArtifact", "http://www.w3.org/2000/01/rdf-schema#comment", "A reference to binary artifacts related to a package.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/FunctionalSafety/verificationPrecondition", "http://www.w3.org/2000/01/rdf-schema#range", "http://www.w3.org/2001/XMLSchema#string", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/SupplyChain/AssemblyProcess", "http://www.w3.org/2004/02/skos/core#note", "The AssemblyProcess refers to the systematic method of putting together different components to create a finished product. The process of assembly is part of the manufacturing process used in industries such as automotive, electronics, aerospace, and consumer goods. Assembled products may be designed to be disassembled into components.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:Nff30b397188e42a7a18177f16de6b694", "http://www.w3.org/ns/shacl#path", "https://spdx.org/rdf/3/terms/Software/lineRange", "globalId", "", ""]
