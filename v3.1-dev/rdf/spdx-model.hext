["https://spdx.org/rdf/3/terms/Core/SpecificationType", "http://www.w3.org/2000/01/rdf-schema#comment", "A specification type defines the nature of a specification.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:Ndcd5966c197e43a197f62bb0e13ad496", "http://www.w3.org/1999/02/22-rdf-syntax-ns#first", "https://spdx.org/rdf/3/terms/Software/SoftwarePurpose/container", "globalId", "", ""]
