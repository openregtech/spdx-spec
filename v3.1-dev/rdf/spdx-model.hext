["https://spdx.org/rdf/3.1/terms/Software/SoftwarePurpose/firmware", "http://www.w3.org/2000/01/rdf-schema#label", "firmware", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
