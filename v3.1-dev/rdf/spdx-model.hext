["https://spdx.org/rdf/3/terms/FunctionalSafety/assumptionUID", "http://www.w3.org/2000/01/rdf-schema#comment", "An assumptionUID is a unique identifier assigned to an Assumption item.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
