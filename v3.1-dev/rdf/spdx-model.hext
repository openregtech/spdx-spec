["https://spdx.org/rdf/3/terms/Core/HashAlgorithm/blake2b512", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "http://www.w3.org/2002/07/owl#NamedIndividual", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Core/to", "http://www.w3.org/2000/01/rdf-schema#isDefinedBy", "https://spdx.org/rdf/3/terms/Core", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/iscc", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType", "globalId", "", ""]
["_:Na77f0a78b7144ee483cdc956ccc8a49a", "http://www.w3.org/1999/02/22-rdf-syntax-ns#first", "https://spdx.org/rdf/3/terms/Dataset/DatasetType/other", "globalId", "", ""]
["_:N6f77fb42083b4f8f9707ad8d668f55f2", "http://www.w3.org/ns/shacl#property", "_:Nb18ae4fadd46404097727f2db87c96ae", "localId", "", ""]
["https://spdx.org/rdf/3/terms/Hardware/releaseDate", "http://www.w3.org/2004/02/skos/core#definition", "Date of product release.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/SupportType/limitedSupport", "http://www.w3.org/2000/01/rdf-schema#comment", "The artifact has been released, and there is limited support available from the supplier. There is a validUntilDate that can provide additional information about the duration of support.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/SimpleLicensing/SimpleLicensingText", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "http://www.w3.org/ns/shacl#NodeShape", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Core/rationale", "http://www.w3.org/2000/01/rdf-schema#comment", "A rationale is supporting information that provides the underlying\njustification or reasoning for an associated element, decision, or process.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/ElementCollection", "http://www.w3.org/2000/01/rdf-schema#comment", "A collection of Elements, not necessarily with unifying context.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:N05d17163b0e048fbbcc9b77954c24af2", "http://www.w3.org/1999/02/22-rdf-syntax-ns#rest", "_:Nee1382aa93ce4e86b979a290253b6d74", "localId", "", ""]
["https://spdx.org/rdf/3/terms/Hardware/batchNumber", "http://www.w3.org/2004/02/skos/core#note", "A group of products produced in a common process is called a batch. Batches are identified by batch numbers.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/releaseTime", "http://www.w3.org/2004/02/skos/core#definition", "Specifies the time an artifact was released.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Software/Snippet", "http://www.w3.org/2004/02/skos/core#note", "A Snippet describes a certain part of a file and can be used when the file is\nknown to have some content that has been included from another original source.\n\nSnippets are useful for denoting when part of a file may have been originally\ncreated under another license or copied from a place with a known\nvulnerability.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Software/SoftwarePurpose/data", "http://www.w3.org/2000/01/rdf-schema#isDefinedBy", "https://spdx.org/rdf/3/terms/Software", "globalId", "", ""]
["_:N1f30e063faa2429bb12a4392a06065cd", "http://www.w3.org/1999/02/22-rdf-syntax-ns#rest", "_:N791f9ef5573d4ba9a9f5cd37486858ba", "localId", "", ""]
