["_:Nab3b02245bf443169d7dd41d28abcfb8", "http://www.w3.org/ns/shacl#path", "https://spdx.org/rdf/3/terms/Software/sbomType", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Security/Vulnerability", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "http://www.w3.org/2002/07/owl#Class", "globalId", "", ""]
