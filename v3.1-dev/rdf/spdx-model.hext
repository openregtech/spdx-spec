["https://spdx.org/rdf/3/terms/Core/RelationshipType/performedBy", "http://www.w3.org/2000/01/rdf-schema#isDefinedBy", "https://spdx.org/rdf/3/terms/Core/", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Core/externalIdentifier", "http://www.w3.org/2004/02/skos/core#note", "ExternalIdentifier points to a resource outside the scope of SPDX 3 content\nthat uniquely identifies an Element.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/ExpandedLicensing/isFsfLibre", "http://www.w3.org/2000/01/rdf-schema#comment", "Specifies whether the License is listed as free by the\nFree Software Foundation (FSF).", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/isni", "http://www.w3.org/2000/01/rdf-schema#comment", "International Standard Name Identifier (ISNI) <https://isni.org/page/what-is-isni/> is a unique identifier used to distinguish the public identities of parties involved in the creation, production, and distribution of media content. Standardized by ISO 27729 <https://www.iso.org/standard/87177.html>, it consists of 16 characters\u201415 digits plus a final check character\u2014and is often represented as a URI, such as https://isni.org/isni/000000012146438X.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Hardware/category", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "http://www.w3.org/2002/07/owl#ObjectProperty", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Core/HashAlgorithm/sha3_384", "http://www.w3.org/2000/01/rdf-schema#label", "sha3_384", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/SupplyChain/AssemblyAction", "http://www.w3.org/2000/01/rdf-schema#comment", "AssemblyAction represents the event of creating a product by assembling individual components.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:N9eb1c004f07a4d2da2d2b8288126fce7", "http://www.w3.org/ns/shacl#path", "https://spdx.org/rdf/3/terms/Core/city", "globalId", "", ""]
["_:Nfd4f42ad90244c3a8b60c259b9c6b3bc", "http://www.w3.org/ns/shacl#class", "https://spdx.org/rdf/3/terms/SupplyChain/DefinedStateProcess", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/glue", "http://www.w3.org/2004/02/skos/core#definition", "GLobal Unique Enterprise (GLUE) Identifiers <https://datatracker.ietf.org/doc/draft-ietf-spice-glue-id/>, as defined by the IETF Internet-Draft, is expressed as a GLUE URI, a Uniform Resource Identifier that standardizes the representation of existing organizational entity identifiers.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/SupplyChain/ReproduceAction", "http://www.w3.org/2004/02/skos/core#note", "Reproduction involves the act of replicating or reproducing a product. This includes producing new products related to husbandry, agriculture, and fishing.\n\nRelationship:\n\nFor each ReproduceAction there is at least one /Core/Relationship class or subclass with the relationshipType of 'hasInput\u2019 on the from and a /Core/Element class or subclass on the to.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:N01960373883145e0ac3dabd360e7039f", "http://www.w3.org/ns/shacl#datatype", "http://www.w3.org/2001/XMLSchema#string", "globalId", "", ""]
["_:N3b7dbd10299f49a8aed84e8fbc6fb8bf", "http://www.w3.org/1999/02/22-rdf-syntax-ns#first", "https://spdx.org/rdf/3/terms/Core/ExternalRefType/securityAdvisory", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/isil", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "http://www.w3.org/2002/07/owl#NamedIndividual", "globalId", "", ""]
["_:N06788128a6c14d9d905b030007b82f48", "http://www.w3.org/ns/shacl#maxCount", "1", "http://www.w3.org/2001/XMLSchema#integer", "", ""]
["https://spdx.org/rdf/3/terms/Software/SoftwarePurpose/diskImage", "http://www.w3.org/2000/01/rdf-schema#comment", "The Element refers to a disk image that can be written to a disk, booted in a VM, etc. A disk image typically contains most or all of the components necessary to boot, such as bootloaders, kernels, firmware, userspace, etc.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/ExpandedLicensing/OrLaterOperator", "http://www.w3.org/2004/02/skos/core#definition", "Portion of an AnyLicenseInfo representing this version, or any later version,\nof the indicated License.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Operations/exportControlClassificationResult", "http://www.w3.org/2004/02/skos/core#definition", "Provides the result of an export control assessment.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Software/SoftwarePurpose/filesystemImage", "http://www.w3.org/2000/01/rdf-schema#label", "filesystemImage", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/Hash", "http://www.w3.org/2004/02/skos/core#note", "A hash is a grouping of characteristics unique to the result\nof applying a mathematical algorithm\nthat maps data of arbitrary size to a bit string (the hash)\nand is a one-way function, that is,\na function which is practically infeasible to invert.\n\nThis is commonly used for integrity checking of data.\n\nPlease note that different profiles may also provide additional methods for verifying the integrity of specific subclasses of Elements.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/AI/AIPackage", "http://www.w3.org/ns/shacl#nodeKind", "http://www.w3.org/ns/shacl#IRI", "globalId", "", ""]
["_:N15b9f3094bfb45459c93a1ddc854a641", "http://www.w3.org/ns/shacl#nodeKind", "http://www.w3.org/ns/shacl#IRI", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/SupplyChain/current", "http://www.w3.org/2004/02/skos/core#note", "This is the individual, business, or organization who currently manages goods, services, or assets.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/ExternalRefType/funding", "http://www.w3.org/2000/01/rdf-schema#comment", "A reference to funding information related to a package.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/ExternalRefType", "http://www.w3.org/2004/02/skos/core#definition", "The type of external reference.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
