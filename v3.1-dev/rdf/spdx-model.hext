["https://spdx.org/rdf/3/terms/SupplyChain/currentState", "http://www.w3.org/2000/01/rdf-schema#isDefinedBy", "https://spdx.org/rdf/3/terms/SupplyChain", "globalId", "", ""]
["_:Ndd32f26fadfe4bc2a1b34c4323097c6a", "http://www.w3.org/1999/02/22-rdf-syntax-ns#rest", "_:N5b4fa92ded344e42856743a4d654aef1", "localId", "", ""]
["https://spdx.org/rdf/3/terms/ExpandedLicensing/DisjunctiveLicenseSet", "http://www.w3.org/2004/02/skos/core#note", "A DisjunctiveLicenseSet indicates that _only one_ of its subsidiary\nAnyLicenseInfos is required to apply. In other words, a DisjunctiveLicenseSet\nof two or more licenses represents a licensing situation where _only one_ of\nthe specified licenses are to be complied with.\n\nA consumer of SPDX data would typically understand this to permit the recipient\nof the licensed content to choose which of the corresponding license they would\nprefer to use. It is represented in the SPDX License Expression Syntax by the\nOR operator.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:N9cc17907c58d4de6b9eac190afb5b2a0", "http://www.w3.org/1999/02/22-rdf-syntax-ns#first", "https://spdx.org/rdf/3/terms/Security/CvssV2VulnAssessmentRelationship", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Core/locationTime", "http://www.w3.org/2004/02/skos/core#definition", "A known location is specified at this time.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Hardware/VirtualHardwareModelType/cycle", "http://www.w3.org/2000/01/rdf-schema#isDefinedBy", "https://spdx.org/rdf/3/terms/Hardware", "globalId", "", ""]
["_:N586a159f4d6d4ee99ca7b48391aa4528", "http://www.w3.org/1999/02/22-rdf-syntax-ns#first", "_:N81d314adea904567a0ce4c7c95d44efb", "localId", "", ""]
["https://spdx.org/rdf/3/terms/ExpandedLicensing/LicenseAddition", "http://www.w3.org/ns/shacl#property", "_:Ncc87856dac584a569e0a948d922d8c90", "localId", "", ""]
["_:N3d4e8ca323ca48e9b84df9bf67be0868", "http://www.w3.org/1999/02/22-rdf-syntax-ns#first", "https://spdx.org/rdf/3/terms/Core/RelationshipType/hasDeclaredLicense", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/isan", "http://www.w3.org/2004/02/skos/core#definition", "International Standard Audiovisual Number (ISAN) <https://www.isan.org/about/#what_is_isan> is a unique 24-digit hexadecimal identifier for audiovisual works standardized by ISO 15706 <https://www.iso.org/standard/83124.html>. The ISAN remains persistent for a work regardless of its distribution format or its use. To facilitate human readability, the \"ISAN\" label, grouping hyphens, and two check characters are included (e.g., ISAN 0000-0000-3A8D-0000-Z-0000-0000-6); however, these elements shall be omitted when the identifier is stored electronically (e.g., 000000003A8D000000000000).", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Security/CvssV4VulnAssessmentRelationship", "http://www.w3.org/ns/shacl#nodeKind", "http://www.w3.org/ns/shacl#IRI", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/ExpandedLicensing/member", "http://www.w3.org/2000/01/rdf-schema#comment", "A license expression participating in a license set.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:Nba6a473ee1094dda8587df1023db84e5", "http://www.w3.org/1999/02/22-rdf-syntax-ns#first", "_:Na4ef3465ca9447209b7352822910b4a2", "localId", "", ""]
["https://spdx.org/rdf/3/terms/FunctionalSafety/VerificationType/assessment", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "http://www.w3.org/2002/07/owl#NamedIndividual", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Core/created", "http://www.w3.org/2004/02/skos/core#note", "Created is a date that identifies when the Element was originally created.\n\nThe time stamp can serve as an indication as to whether the analysis needs to\nbe updated.\n\nThis is often the date of last change (e.g., a git commit date), not the date\nwhen the SPDX data was created, as doing so supports reproducible builds.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:N3440bec93a4648c28d730669912f7cc4", "http://www.w3.org/1999/02/22-rdf-syntax-ns#first", "https://spdx.org/rdf/3/terms/Core/ExternalRefType/releaseNotes", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Core/RelationshipType/serializedInArtifact", "http://www.w3.org/2000/01/rdf-schema#comment", "The from SpdxDocument can be found in a serialized form in each to Artifact.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
