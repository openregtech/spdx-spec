["https://spdx.org/rdf/3/terms/FunctionalSafety/EvidenceType/observation", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "https://spdx.org/rdf/3/terms/FunctionalSafety/EvidenceType", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Core/IsoAutomationLevel/fullAutomation", "http://www.w3.org/2004/02/skos/core#definition", "Level 5 - Full automation. The system is capable of performing its entire mission without external intervention.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Hardware/hazard", "http://www.w3.org/2004/02/skos/core#definition", "Hazards are potential sources of harm, danger, or adverse effects to people, property, the environment, or systems within or related to a specific piece of hardware.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:N220f75999bfe45dc805b9c2f5bd2783c", "http://www.w3.org/ns/shacl#path", "https://spdx.org/rdf/3/terms/Core/extension", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/SupplyChain/ChangeProcess", "http://www.w3.org/2000/01/rdf-schema#comment", "A prescribed change to a product.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
