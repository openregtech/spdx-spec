["https://spdx.org/rdf/3.1/terms/ExpandedLicensing/License", "http://www.w3.org/2000/01/rdf-schema#isDefinedBy", "https://spdx.org/rdf/3.1/terms/ExpandedLicensing", "globalId", "", ""]
["https://spdx.org/rdf/3.1/terms/SimpleLicensing/LicenseExpression", "http://www.w3.org/2004/02/skos/core#note", "A LicenseExpression enables the representation, in a single string, of a\ncombination of one or more licenses, together with additions such as license\nexceptions.\n\nThe syntax for a licenseExpression string is set forth in the corresponding\nAnnex of this document\n(\"SPDX license expressions\").\nA licenseExpression string is not valid if it does not conform to the grammar\nset forth in that Annex.\n\nThe ExpandedLicensing profile can be used to represent the complete parsed\nlicense expression as a combination of license objects.\n\ncustomIdToUri is deprecated. Migrate to customIdToLicense. customIdToUri\nwill be removed in a future release.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:N9970571e844349b98f5491de8694b21b", "http://www.w3.org/1999/02/22-rdf-syntax-ns#first", "_:N2b2e6b076dda47679c462d0b051c2a6b", "localId", "", ""]
["https://spdx.org/rdf/3.1/terms/Core/requirementStatement", "http://www.w3.org/2000/01/rdf-schema#comment", "A text describing the actual need defined by the requirement.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:Nbbbd16607b03417b880c5fedf57ce1ee", "http://www.w3.org/1999/02/22-rdf-syntax-ns#first", "https://spdx.org/rdf/3.1/terms/Core/RelationshipType/hasProvidedDependency", "globalId", "", ""]
