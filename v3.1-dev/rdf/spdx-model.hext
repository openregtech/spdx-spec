["https://spdx.org/rdf/3/terms/SupplyChain/BoundaryDefinitionProcess", "http://www.w3.org/2004/02/skos/core#note", "This is the process of defining boundaries for the creation of a region.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/RelationshipType/contains", "http://www.w3.org/2004/02/skos/core#definition", "The from Element contains each to Element.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
