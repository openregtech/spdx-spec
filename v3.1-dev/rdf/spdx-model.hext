["https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/iswc", "http://www.w3.org/2004/02/skos/core#definition", "International Standard Musical Work Code (ISWC) <https://www.iswc.org/iswc> is an 11-character unique identifier standardized by ISO 15707 <https://www.iso.org/standard/83125.html> for musical works (compositions) as distinct from specific recordings. While the \"ISWC\" label and grouping separators (dots and hyphens) are used for human readability, they shall be omitted when the identifier is stored electronically (e.g., T0017812031).", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/Core/intendedUse", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "http://www.w3.org/2002/07/owl#DatatypeProperty", "globalId", "", ""]
["https://spdx.org/rdf/3.1/terms/Core/ExternalRefType/nuget", "http://www.w3.org/2004/02/skos/core#definition", "A reference to a NuGet package. The package locator format is defined in the NuGet documentation <https://docs.nuget.org> and looks like package/version.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
