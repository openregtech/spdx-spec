["https://spdx.org/rdf/3.1/terms/Service/serviceHostingCountry", "http://www.w3.org/2000/01/rdf-schema#comment", "Specifies a country code where a software service is hosted.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/Core/RelationshipType/exploitCreatedBy", "http://www.w3.org/2004/02/skos/core#definition", "The from Vulnerability has had an exploit created against it by each to Agent.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/SimpleLicensing/AnyLicenseInfo", "http://www.w3.org/2004/02/skos/core#note", "AnyLicenseInfo is\nan abstract class representing a license combination consisting of one or more\nlicenses (optionally including additional text), which may be combined\naccording to the\nSPDX license expression syntax.\n\nAn AnyLicenseInfo is used by licensing properties of software artifacts.\n\nIt can be:\n\n- a NoneLicense;\n- a NoAssertionLicense;\n- a single license (either on the\n  SPDX License List <https://spdx.org/licenses/> or\n  a custom-defined license);\n- a single license with an \"or later\" operator applied;\n- the foregoing with additional text applied; or\n- a set of licenses combined by applying \"AND\" and \"OR\" operators recursively.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:Nbb2ea1cd8ede441c8908c6e569fd47d6", "http://www.w3.org/ns/shacl#in", "_:N1c4c35ec79f047aab3697370497801ca", "localId", "", ""]
["https://spdx.org/rdf/3.1/terms/Core/RelationshipType/configures", "http://www.w3.org/2000/01/rdf-schema#comment", "The from Element is a configuration applied to each to Element, during a LifecycleScopeType period.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
