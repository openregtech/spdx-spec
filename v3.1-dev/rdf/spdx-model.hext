["https://spdx.org/rdf/3/terms/Service/serviceHostingCountry", "http://www.w3.org/2000/01/rdf-schema#comment", "Specifies a country code where a software service is hosted.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:N9659e4ee62e940a09e2b6d0329f1ec21", "http://www.w3.org/1999/02/22-rdf-syntax-ns#first", "https://spdx.org/rdf/3/terms/Software/SoftwarePurpose/executable", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/ibrn", "http://www.w3.org/2004/02/skos/core#definition", "International Business Registration Number (IBRN) <https://ekys.org/business_identifiers/> is a unique identifier for legal entities standardized by ISO 8000-116 <https://www.iso.org/standard/75117.html>. It is composed of two parts: a jurisdiction prefix and a local authoritative legal entity identifier (ALEI), separated by a colon. The prefix contains an ISO 3166 country code, an optional subdivision code, and a register code (e.g., US-DE.BER:3031657).", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:N85e76b66ded24206a548741636e566db", "http://www.w3.org/ns/shacl#hasValue", "https://spdx.org/rdf/3/terms/Core/RelationshipType/hasContactPoint", "globalId", "", ""]
