["https://spdx.org/rdf/3/terms/Core/intendedUse", "http://www.w3.org/2004/02/skos/core#definition", "A statement of how, or for what purpose, an item or artifact is intended\nto be used.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/ExpandedLicensing/ListedLicenseException", "http://www.w3.org/2004/02/skos/core#definition", "A license exception that is listed on the SPDX Exceptions list.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Dataset/DatasetAvailabilityType/query", "http://www.w3.org/2004/02/skos/core#definition", "Dataset is publicly available, but not all at once, and can only be accessed through queries which return parts of the dataset.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/Specification", "http://www.w3.org/2004/02/skos/core#note", "A specification (spec) is a detailed document that outlines the\ndesign, requirements, or features for a product, process, or system.\n\nRequirements, standards, specifications and processes\ncan be referenced in this class.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
