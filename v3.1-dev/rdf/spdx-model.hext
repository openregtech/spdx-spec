["https://spdx.org/rdf/3/terms/Core/HashAlgorithm/sha3_224", "http://www.w3.org/2000/01/rdf-schema#comment", "SHA-3 with a digest length of 224, as defined in FIPS 202 <https://csrc.nist.gov/pubs/fips/202/final>.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/RelationshipType/expandsTo", "http://www.w3.org/2004/02/skos/core#definition", "The from Element expands out as an artifact described by each to Element.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Extension/CdxPropertiesExtension", "http://www.w3.org/2000/01/rdf-schema#subClassOf", "https://spdx.org/rdf/3/terms/Extension/Extension", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Extension/Extension", "http://www.w3.org/2004/02/skos/core#definition", "A characterization of some aspect of an Element that is associated with the Element in a generalized fashion.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:Na7974e41e9b84b04a497af9802836d8d", "http://www.w3.org/ns/shacl#class", "https://spdx.org/rdf/3/terms/Core/IntegrityMethod", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/ExpandedLicensing/obsoletedBy", "http://www.w3.org/2000/01/rdf-schema#label", "obsoletedBy", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:N1918d4ef74a043439f2095d9c56d4a29", "http://www.w3.org/1999/02/22-rdf-syntax-ns#first", "https://spdx.org/rdf/3/terms/Core/RelationshipType/hasOptionalDependency", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Core/Action", "http://www.w3.org/2004/02/skos/core#note", "Action defines an event that has occurred. This is an Abstract Action.\n\nstartTime is the time at which an action starts or triggered.\nendTime is the time at which an action stops or finishes.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/ExpandedLicensing/DisjunctiveLicenseSet", "http://www.w3.org/2004/02/skos/core#note", "A DisjunctiveLicenseSet indicates that _only one_ of its subsidiary\nAnyLicenseInfos is required to apply. In other words, a DisjunctiveLicenseSet\nof two or more licenses represents a licensing situation where _only one_ of\nthe specified licenses are to be complied with.\n\nA consumer of SPDX data would typically understand this to permit the recipient\nof the licensed content to choose which of the corresponding license they would\nprefer to use. It is represented in the SPDX License Expression Syntax by the\nOR operator.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/creationInfo", "http://www.w3.org/2000/01/rdf-schema#isDefinedBy", "https://spdx.org/rdf/3/terms/Core/", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Core/ExternalRefType/releaseHistory", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "http://www.w3.org/2002/07/owl#NamedIndividual", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Core/issuingAuthority", "http://www.w3.org/2000/01/rdf-schema#label", "issuingAuthority", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
