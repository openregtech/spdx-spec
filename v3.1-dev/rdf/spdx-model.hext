["_:Nd3adb93cd38548c184f643eb2642cdb4", "http://www.w3.org/ns/shacl#pattern", "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$", "http://www.w3.org/2001/XMLSchema#string", "", ""]
["https://spdx.org/rdf/3/terms/Software/byteRange", "http://www.w3.org/2004/02/skos/core#note", "This field defines the byte range in the original host file that the snippet\ninformation applies to.\n\nA range of bytes is independent of various formatting concerns, and the most\naccurate way of referring to the differences. The choice was made to start the\nnumbering of the byte range at 1 to be consistent with the W3C pointer method\nvocabulary.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:Na405798f4814464b8e907d991659ce6e", "http://www.w3.org/ns/shacl#path", "https://spdx.org/rdf/3/terms/Core/contactType", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Core/rationale", "http://www.w3.org/2004/02/skos/core#note", "A rationale is a detailed explanation that documents the logic and intent\nbehind a specific element, decision, or process.\nIt provides the justification for why an item exists or why a particular\nconclusion was reached, often citing evidence, criteria, or analysis methods.\n\nThis context ensures transparency in the decision-making process by accounting\nfor the considerations, risks, or motivations that inform the primary\nstatement.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/ExpandedLicensing/isOsiApproved", "http://www.w3.org/2004/02/skos/core#note", "isOsiApproved specifies whether the\nOpen Source Initiative (OSI) <https://opensource.org>\nhas listed this License as \"approved\" in their list of OSI Approved Licenses,\nlocated at the time of this writing at\nOSI Approved Licenses <https://opensource.org/licenses>.\n\nA value of \"true\" indicates that the license is in the list of licenses that\nOSI publishes as approved.\n\nA value of \"false\" indicates that the license is explicitly not in the\ncorresponding list of OSI licenses (e.g., OSI has stated publicly that a\nlicense is not approved).\n\nIf the isOsiApproved field is not specified, the SPDX data creator makes no\nassertions about whether the License is approved by the OSI.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/ExpandedLicensing/ListedLicense", "http://www.w3.org/2004/02/skos/core#definition", "A license that is listed on the SPDX License List.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/created", "http://www.w3.org/2000/01/rdf-schema#range", "http://www.w3.org/2001/XMLSchema#dateTimeStamp", "globalId", "", ""]
