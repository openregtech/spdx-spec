["https://spdx.org/rdf/3/terms/Software/contentIdentifierType", "http://www.w3.org/2004/02/skos/core#note", "A contentIdentifierType specifies the type of the content identifier.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:N504c4d3f117146b6b9709161a03dfad9", "http://www.w3.org/1999/02/22-rdf-syntax-ns#rest", "_:N583820b3832d49a5a4848d999a026e45", "localId", "", ""]
