["https://spdx.org/rdf/3/terms/Core/RelationshipType/hasOptionalDependency", "http://www.w3.org/2000/01/rdf-schema#isDefinedBy", "https://spdx.org/rdf/3/terms/Core/", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Core/SpecificationType/specification", "http://www.w3.org/2000/01/rdf-schema#comment", "A specification is a detailed document (or set of documents) that describes the requirements, design, behavior, or other characteristics of a system, component, or process so that all stakeholders have a clear, unambiguous reference.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/RequirementStatusType/active", "http://www.w3.org/2004/02/skos/core#definition", "A requirement has been approved by stakeholder, and can be include in traceability.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
