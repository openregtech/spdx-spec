["https://spdx.org/rdf/3.1/terms/Core/IsoAutomationLevel", "http://www.w3.org/2004/02/skos/core#definition", "Defines the level of automation a system possesses.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/Core/locationTime", "http://www.w3.org/2004/02/skos/core#note", "The locationTime establishes the relationship between a specific time and location. For example, at 8:45 the company's headquarters is located at this location.\nAn action occurred at this location at this specific time.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
