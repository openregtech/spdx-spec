["https://spdx.org/rdf/3/terms/Core/MeasureOfLength", "http://www.w3.org/2004/02/skos/core#note", "The measure of length refers to the dimension of an object or space that describes how long it is, typically expressed in various units depending on the system of measurement being used.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/AI/EnergyUnitType/kilowattHour", "http://www.w3.org/2000/01/rdf-schema#isDefinedBy", "https://spdx.org/rdf/3/terms/AI", "globalId", "", ""]
