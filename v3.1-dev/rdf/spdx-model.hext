["https://spdx.org/rdf/3/terms/Core/Tool", "http://www.w3.org/2004/02/skos/core#note", "A Tool is an element of hardware and/or software utilized to carry out a particular function.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/eli", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType", "globalId", "", ""]
