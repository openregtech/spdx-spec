["https://spdx.org/rdf/3/terms/FunctionalSafety/EvidenceType/observation", "http://www.w3.org/2004/02/skos/core#definition", "Documentation of direct monitoring or witnessing of the demonstration of processes, tests, or any kind of system responses during a specified timeframe under specified environmental conditions.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Software/SoftwarePurpose/evidence", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "https://spdx.org/rdf/3/terms/Software/SoftwarePurpose", "globalId", "", ""]
