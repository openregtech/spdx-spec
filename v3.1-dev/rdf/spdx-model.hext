["_:N2842dbc8fe9c4dd1ae4bb58cded6b19e", "http://www.w3.org/ns/shacl#path", "https://spdx.org/rdf/3/terms/Core/relationshipType", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/SupplyChain/CreateAction", "http://www.w3.org/2000/01/rdf-schema#comment", "CreationAction represents an event of product creation.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/suppliedBy", "http://www.w3.org/2004/02/skos/core#note", "Identify the actual distribution source for the artifact (e.g., snippet, file,\npackage, vulnerability) or VulnAssessmentRelationship being referenced.\n\nThis may or may not be different from the originating distribution source\nfor the artifact (e.g., snippet, file, package, vulnerability) or\nVulnAssessmentRelationship.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
