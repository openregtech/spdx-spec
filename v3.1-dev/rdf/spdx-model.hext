["https://spdx.org/rdf/3.1/terms/Software/File", "http://www.w3.org/2004/02/skos/core#note", "Refers to any object that stores content on a computer.\nThe type of content can optionally be provided in the contentType property.\n\nThe fileKind property can be set to directory to indicate the file represents\na directory and all content stored in that directory.\n\nThe fileKind property can be set to symlink to indicate the file represents a link to another file or directory, it does not represent the file or directory referenced by the symlink.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/SupplyChain/InspectionAction", "http://www.w3.org/2000/01/rdf-schema#subClassOf", "https://spdx.org/rdf/3.1/terms/SupplyChain/UseAction", "globalId", "", ""]
["https://spdx.org/rdf/3.1/terms/Core/packageVerificationCodeExcludedFile", "http://www.w3.org/2004/02/skos/core#note", "A relative filename with the root of the package archive or directory\nreferencing a file to be excluded from the PackageVerificationCode.\n\nEvery filename is preceded with a ./.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/Core/Specification", "http://www.w3.org/2000/01/rdf-schema#label", "Specification", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
