["https://spdx.org/rdf/3/terms/Core/identifier", "http://www.w3.org/2004/02/skos/core#note", "An identifier uniquely identifies an external element.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
