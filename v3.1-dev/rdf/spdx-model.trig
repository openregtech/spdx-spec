    spdx-functionalsafety:SafetyContextRelationship a owl:Class,
            sh:NodeShape ;
        rdfs:label "SafetyContextRelationship"@en ;
        rdfs:comment "Provides functional safety context for an existing lifecycle-scoped relationship."@en ;
        rdfs:isDefinedBy spdx-functionalsafety: ;
        rdfs:subClassOf spdx-core:LifecycleScopedRelationship ;
        skos:definition "Provides functional safety context for an existing lifecycle-scoped relationship."@en ;
        skos:note """SafetyContextRelationship provides functional safety context for a relationship
between SPDX elements. It enables an existing relationship, such as a dependency
or requirement relationship, to carry a safety integrity level leveraging the existing
relationship types as needed for safety-related use case.

SafetyContextRelationship inherits lifecycle scope from
/Core/LifecycleScopedRelationship so the safety context can be interpreted for a
specific lifecycle phase, such as design, build, test, runtime, update, or
decommission."""@en ;
        sh:nodeKind sh:IRI ;
        sh:property _:Nbf52a7c883ff4b299fa90bb35e5a0417 .

