    ns2:CvssV2VulnAssessmentRelationship a owl:Class,
            sh:NodeShape ;
        rdfs:label "CvssV2VulnAssessmentRelationship"@en ;
        rdfs:comment "Provides a CVSS version 2.0 assessment for a vulnerability."@en ;
