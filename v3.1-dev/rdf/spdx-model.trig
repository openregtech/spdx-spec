    <https://spdx.org/rdf/3/terms/Security/CvssSeverityType/critical> a owl:NamedIndividual,
            spdx-security:CvssSeverityType ;
        rdfs:label "critical"@en ;
        rdfs:comment "When a CVSS score is between 9.0 - 10.0."@en ;
