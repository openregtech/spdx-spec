        rdfs:isDefinedBy spdx-hardware: ;
        rdfs:range xsd:dateTimeStamp ;
        skos:definition "Date of product release."@en ;
        skos:note "This is the first date associated to a specific product release."@en .

    spdx-hardware:serialNumber a owl:DatatypeProperty ;
        rdfs:label "serialNumber"@en ;
        rdfs:comment "Identifier for specific product is called a serial number."@en ;
        rdfs:isDefinedBy spdx-hardware: ;
        rdfs:range xsd:string ;
        skos:definition "Identifier for specific product is called a serial number."@en ;
        skos:note "This is a specific identifier assigned to a specific product."@en .

    spdx-hardware:virtualHardwareModel a owl:ObjectProperty ;
        rdfs:label "virtualHardwareModel"@en ;
        rdfs:comment "Information related to virtual hardware simulation."@en ;
        rdfs:isDefinedBy spdx-hardware: ;
        rdfs:range spdx-hardware:VirtualHardwareModelType ;
        skos:definition "Information related to virtual hardware simulation."@en ;
        skos:note "Information related to virtual hardware simulation modelling process."@en .

    spdx-hardware:xAxisLength a owl:ObjectProperty ;
        rdfs:label "xAxisLength"@en ;
        rdfs:comment "The length along the x-axis."@en ;
        rdfs:isDefinedBy spdx-hardware: ;
        rdfs:range spdx-core:UnitOfMeasure ;
        skos:definition "The length along the x-axis."@en ;
        skos:note "This property specifies the length along the x-axis of a hardware component. The value must be expressed using the /Core/UnitOfMeasure type which requires both a quantity, and a unitQUDT which must be a unit of length from the QUDT vocabulary, specifically constrained to the http://qudt.org/vocab/quantitykind/Length."@en .

    spdx-hardware:yAxisLength a owl:ObjectProperty ;
        rdfs:label "yAxisLength"@en ;
        rdfs:comment "The length along the y-axis."@en ;
        rdfs:isDefinedBy spdx-hardware: ;
        rdfs:range spdx-core:UnitOfMeasure ;
        skos:definition "The length along the y-axis."@en ;
        skos:note "This property specifies the length along the y-axis of a hardware component. The value must be expressed using the /Core/UnitOfMeasure type which requires both a quantity, and a unitQUDT which must be a unit of length from the QUDT vocabulary, specifically constrained to the http://qudt.org/vocab/quantitykind/Length."@en .

    spdx-hardware:zAxisLength a owl:ObjectProperty ;
        rdfs:label "zAxisLength"@en ;
        rdfs:comment "The length along the z-axis."@en ;
        rdfs:isDefinedBy spdx-hardware: ;
        rdfs:range spdx-core:UnitOfMeasure ;
        skos:definition "The length along the z-axis."@en ;
        skos:note """This property specifies the length along the z-axis of a hardware component. The value must be expressed using the /Core/UnitOfMeasure type which requires both a quantity, and a unitQUDT which must be a unit of length from the QUDT vocabulary, specifically constrained to the http://qudt.org/vocab/quantitykind/Length.

Z axis is the height of the object."""@en .

