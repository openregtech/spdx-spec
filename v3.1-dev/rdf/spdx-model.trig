    ns4:EvaluationResultType a owl:Class ;
        rdfs:label "EvaluationResultType"@en ;
        rdfs:comment "EvaluationResultType describes the outcome of an evaluation or verification process with."@en ;
        rdfs:isDefinedBy spdx-functionalsafety: ;
