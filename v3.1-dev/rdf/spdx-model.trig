    <https://spdx.org/rdf/3/terms/Security/CvssSeverityType/high> a owl:NamedIndividual,
            spdx-security:CvssSeverityType ;
        rdfs:label "high"@en ;
        rdfs:comment "When a CVSS score is between 7.0 - 8.9."@en ;
        rdfs:isDefinedBy spdx-security: ;
