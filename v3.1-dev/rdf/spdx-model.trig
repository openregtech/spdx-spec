        rdfs:range xsd:dateTimeStamp ;
        skos:definition "Specifies the time an artifact was built."@en ;
        skos:note "A builtTime specifies the time an artifact was built."@en .

    spdx-core:city a owl:DatatypeProperty ;
        rdfs:label "city"@en ;
