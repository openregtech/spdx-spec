    ns5:plannedTransportRoutes a owl:DatatypeProperty ;
        rdfs:label "plannedTransportRoutes"@en ;
        rdfs:comment "A transport route refers to the planned path or network used to move people, goods, data, or resources from one location to another."@en ;
        rdfs:isDefinedBy spdx-supplychain: ;
        rdfs:range xsd:string ;
        skos:definition "A transport route refers to the planned path or network used to move people, goods, data, or resources from one location to another."@en ;
        skos:note "A transport route is the planned path taken by people, products, goods, data or resources. Transport routes vary by product type, safety requirements, business constraints or other factors."@en .

