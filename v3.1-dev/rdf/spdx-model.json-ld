  {
    "@id": "https://spdx.org/rdf/3/terms/Security/VexFixedVulnAssessmentRelationship",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class",
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Links a vulnerability and elements representing products (in the VEX sense) where\na fix has been applied and are no longer affected."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://spdx.org/rdf/3/terms/Security/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "VexFixedVulnAssessmentRelationship"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://spdx.org/rdf/3/terms/Security/VexVulnAssessmentRelationship"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Links a vulnerability and elements representing products (in the VEX sense) where\na fix has been applied and are no longer affected."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "VexFixedVulnAssessmentRelationship links a vulnerability to a number of elements\nrepresenting VEX products where a vulnerability has been fixed and are no longer\naffected. It represents the VEX fixed status.\n\n*Constraints*\n\nWhen linking elements using a VexFixedVulnAssessmentRelationship, the following\nrequirements shall be observed:\n\n- Elements linked with a VulnVexFixedAssessmentRelationship are constrained to\n  using the fixedIn relationship type.\n\n*Example*\n\n{\n  \"type\": \"security_VexFixedVulnAssessmentRelationship\",\n  \"spdxId\": \"urn:spdx.dev:vex-fixed-in-1\",\n  \"relationshipType\": \"fixedIn\",\n  \"from\": \"urn:spdx.dev:vuln-cve-2020-28498\",\n  \"to\": [\"urn:product-acme-application-1.3\"],\n  \"security_assessedElement\": \"urn:npm-elliptic-6.5.4\",\n  \"suppliedBy\": \"urn:spdx.dev:agent-jane-doe\",\n  \"security_publishedTime\": \"2021-03-09T11:04:53Z\"\n}"
      }
    ],
    "http://www.w3.org/ns/shacl#nodeKind": [
      {
        "@id": "http://www.w3.org/ns/shacl#IRI"
      }
    ]
  },
