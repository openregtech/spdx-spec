      {
        "@language": "en",
        "@value": "The specVersion provides a reference number that can be used to understand how\nto parse and interpret an Element.\nIt will enable both future changes to the specification and to support backward\ncompatibility.\n\nThe major version number shall be incremented when incompatible changes between\nversions are made (one or more sections are created, modified or deleted).\nThe minor version number shall be incremented when backwards compatible changes\nare made.\nThe optional patch version number shall be incremented when backward compatible bug\nfixes are made.\nIf no patch version is present, the latest released patch version can be assumed.\n\nHere, parties exchanging information in accordance with the SPDX specification\nneed to provide 100% transparency as to which SPDX specification version such\ninformation is conforming to."
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Core/ExternalRefType/vulnerabilityDisclosureReport",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3/terms/Core/ExternalRefType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A reference to a Vulnerability Disclosure Report (VDR) which provides the software supplier's analysis and findings describing the impact (or lack of impact) that reported vulnerabilities have on packages or products in the supplier's SBOM as defined in NIST SP 800-161 Cybersecurity Supply Chain Risk Management Practices for Systems and Organizations <https://csrc.nist.gov/pubs/sp/800/161/r1/final>."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://spdx.org/rdf/3/terms/Core/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "vulnerabilityDisclosureReport"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A reference to a Vulnerability Disclosure Report (VDR) which provides the software supplier's analysis and findings describing the impact (or lack of impact) that reported vulnerabilities have on packages or products in the supplier's SBOM as defined in NIST SP 800-161 Cybersecurity Supply Chain Risk Management Practices for Systems and Organizations <https://csrc.nist.gov/pubs/sp/800/161/r1/final>."
      }
    ]
  },
