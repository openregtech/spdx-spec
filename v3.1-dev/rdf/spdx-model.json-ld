    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "QUDT (Quantity, Unit, Dimension and Type) specifies a standardized framework\nfor describing measurable quantities, units of measure, numerical values,\nand their underlying data structures and types.\n\nThe value is constrained to the QUDT ontology and specifications. The QUDT ontology and specifications are available at https://www.qudt.org/."
      }
