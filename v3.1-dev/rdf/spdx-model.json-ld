    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "This is the specific action of product use.\n\nRelationship:\n\nFor each UseAction there is at least one /Core/Relationship class or subclass with the relationshipType of 'performedBy’ on the from and a /Core/Agent class or subclass on the to.\n\nFor each UseAction there is at least one /Core/Relationship class or subclass with the relationshipType of 'affects’ on the from and a /Core/Element class or subclass on the to."
      }
    ],
