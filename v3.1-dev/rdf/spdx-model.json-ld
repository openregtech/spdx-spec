    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "ManufactureAction represents the act of creating a product by a manufacturing process."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "ManufactureAction refers to an event where goods are created using materials or ingredients, typically resulting in a product that cannot be easily disassembled."
