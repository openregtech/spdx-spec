    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "An assumption element is a distinct unit that defines a design constraint.\nThis constraint is imposed by the intended design, the requirement context, or the operational context.\nIt ensures the item operates correctly within a system context."
      }
    ],
