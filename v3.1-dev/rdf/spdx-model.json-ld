    "http://www.w3.org/ns/shacl#message": [
      {
        "@language": "en",
        "@value": "https://spdx.org/rdf/3/terms/SupplyChain/ModifyProcess is abstract and must not be instantiated directly."
      }
    ],
    "http://www.w3.org/ns/shacl#not": [
      {
