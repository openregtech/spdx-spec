  {
    "@id": "https://spdx.org/rdf/3/terms/FunctionalSafety/SafetyContextRelationship",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class",
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Provides functional safety context for an existing lifecycle-scoped relationship."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://spdx.org/rdf/3/terms/FunctionalSafety/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "SafetyContextRelationship"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://spdx.org/rdf/3/terms/Core/LifecycleScopedRelationship"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Provides functional safety context for an existing lifecycle-scoped relationship."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "SafetyContextRelationship provides functional safety context for a relationship\nbetween SPDX elements. It enables an existing relationship, such as a dependency\nor requirement relationship, to carry a safety integrity level leveraging the existing\nrelationship types as needed for safety-related use case.\n\nSafetyContextRelationship inherits lifecycle scope from\n/Core/LifecycleScopedRelationship so the safety context can be interpreted for a\nspecific lifecycle phase, such as design, build, test, runtime, update, or\ndecommission."
      }
    ],
