      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "If a build configuration exists for the toolchain or platform performing the\nbuild, the configSourceUri of a build is the URI of that build configuration,\naccording to the buildType.\n\nFor example, a build triggered by a GitHub Action is defined by a build\nconfiguration YAML file. In this case, the configSourceUri is the URL of that\nYAML file."
      }
    ]
