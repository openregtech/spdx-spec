  {
    "@id": "https://spdx.org/rdf/3/terms/SimpleLicensing/AnyLicenseInfo",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class",
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Abstract class representing a license combination consisting of one or more licenses."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://spdx.org/rdf/3/terms/SimpleLicensing/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "AnyLicenseInfo"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://spdx.org/rdf/3/terms/Core/Element"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Abstract class representing a license combination consisting of one or more licenses."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "AnyLicenseInfo is\nan abstract class representing a license combination consisting of one or more\nlicenses (optionally including additional text), which may be combined\naccording to the\nSPDX license expression syntax.\n\nAn AnyLicenseInfo is used by licensing properties of software artifacts.\n\nIt can be:\n\n- a NoneLicense;\n- a NoAssertionLicense;\n- a single license (either on the\n  SPDX License List <https://spdx.org/licenses/> or\n  a custom-defined license);\n- a single license with an \"or later\" operator applied;\n- the foregoing with additional text applied; or\n- a set of licenses combined by applying \"AND\" and \"OR\" operators recursively."
      }
    ],
    "http://www.w3.org/ns/shacl#nodeKind": [
      {
        "@id": "http://www.w3.org/ns/shacl#IRI"
      }
    ],
    "http://www.w3.org/ns/shacl#property": [
      {
        "@id": "_:Nbccd79bef2514225ab3d71450e9a4242"
      }
    ]
  },
  {
    "@id": "_:Nbccd79bef2514225ab3d71450e9a4242",
    "http://www.w3.org/ns/shacl#message": [
      {
        "@language": "en",
        "@value": "https://spdx.org/rdf/3/terms/SimpleLicensing/AnyLicenseInfo is abstract and must not be instantiated directly."
      }
    ],
    "http://www.w3.org/ns/shacl#not": [
      {
        "@id": "_:Na047345151674d5ab3315416d6764aa5"
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#type"
      }
    ]
  },
