  {
    "@id": "https://spdx.org/rdf/3/terms/AI/EnergyConsumptionDescription",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class",
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The class that helps note down the quantity of energy consumption and the unit\nused for measurement."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://spdx.org/rdf/3/terms/AI/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "EnergyConsumptionDescription"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The class that helps note down the quantity of energy consumption and the unit\nused for measurement."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "This class is designed to store energy consumption data, including the quantity\nand the unit of measurement.\n\nThe energyQuantity property stores the amount of energy consumed,\nand the energyUnit property stores the unit used for measurement.\n\nFor example, 0.042 kilowatt-hour of energy will have 0.042 as a value for\nproperty energyQuantity, and \"kilowattHour\" as a value for property\nenergyUnit.\n\n*Example*\n\n{\n  \"type\": \"ai_EnergyConsumptionDescription\",\n  \"ai_energyQuantity\": \"0.042\",\n  \"ai_energyUnit\": \"kilowattHour\"\n}"
      }
    ],
    "http://www.w3.org/ns/shacl#nodeKind": [
      {
        "@id": "http://www.w3.org/ns/shacl#BlankNodeOrIRI"
      }
    ],
