  {
    "@id": "https://spdx.org/rdf/3/terms/SupplyChain/State",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class",
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A state is an instance that describes what a system, component, subsystem, process, or project has achieved at any given time."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://spdx.org/rdf/3/terms/SupplyChain/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "State"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://spdx.org/rdf/3/terms/Core/Artifact"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A state is an instance that describes what a system, component, subsystem, process, or project has achieved at any given time."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "A state is an instance that describes what a system, component, subsystem, process, or project has achieved at any given time. States are used to describe different conditions within a system and provide information about its current status. They help us understand the behavior of systems or product by showing their progression through various states over time.\n\nStates describe what a project has achieved (or not) as opposed to describing actions taken by people involved with the project, or activities performed during development of that project."
      }
    ],
    "http://www.w3.org/ns/shacl#nodeKind": [
      {
        "@id": "http://www.w3.org/ns/shacl#IRI"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/ExpandedLicensing/LicenseAddition",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class",
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Abstract class for additional text intended to be added to a License, but\nwhich is not itself a standalone License."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://spdx.org/rdf/3/terms/ExpandedLicensing/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "LicenseAddition"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://spdx.org/rdf/3/terms/Core/Element"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Abstract class for additional text intended to be added to a License, but\nwhich is not itself a standalone License."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "A LicenseAddition represents text which is intended to be added to a License\nas additional text, but which is not itself intended to be a standalone\nLicense.\n\nIt may be an exception which is listed on the\nSPDX License Exceptions <https://spdx.org/licenses/exceptions-index.html>\n(ListedLicenseException), or may be any other additional text (as an exception\nor otherwise) which is defined by an SPDX data creator (CustomLicenseAddition)."
      }
    ],
    "http://www.w3.org/ns/shacl#nodeKind": [
      {
        "@id": "http://www.w3.org/ns/shacl#IRI"
      }
    ],
