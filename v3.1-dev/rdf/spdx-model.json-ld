      {
        "@id": "https://spdx.org/rdf/3/terms/Extension/CdxPropertyEntry"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Provides a map of a property name to a value."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "This field provides a mapping of a name to a value.\n\nThis is intended to be compatible with the CycloneDX property properties.\n\nUnlike key-value stores, properties in CdxPropertiesExtension support duplicate\nnames, each potentially having different values."
      }
    ]
  },
  {
