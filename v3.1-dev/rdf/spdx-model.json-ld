      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "A CustomLicenseAddition represents an addition to a License that is not listed\non the\nSPDX License Exceptions <https://spdx.org/licenses/exceptions-index.html>,\nand is therefore defined by an SPDX data creator.\n\nIt is intended to represent additional language which is meant to be added to\na License, but which is not itself a standalone License."
      }
