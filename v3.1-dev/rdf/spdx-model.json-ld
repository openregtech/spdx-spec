    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A place for the SPDX document creator to record a website that serves as the\npackage's home page."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "A homePage is a place for the SPDX document creator to record a website that\nserves as the package's home page.\n\nThis saves the recipient of the SPDX document who is looking for more info from\nhaving to search for and verify a match between the package and the associated\nproject home page.\n\nThis link can also be used to reference further information about the package\nreferenced by the SPDX document creator."
      }
    ]
  },
