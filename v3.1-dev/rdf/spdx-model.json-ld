  {
    "@id": "https://spdx.org/rdf/3/terms/Software/sbomType",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Provides information about the type of an SBOM."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://spdx.org/rdf/3/terms/Software/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "sbomType"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://spdx.org/rdf/3/terms/Software/SbomType"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Provides information about the type of an SBOM."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "This field is a reasonable estimation of the type of SBOM created from a\ncreator perspective.\n\nIt is intended to be used to give guidance on the elements that may be\ncontained within it.\n\nAligning with the guidance produced in\nTypes of Software Bill of Material (SBOM) Documents <https://www.cisa.gov/sites/default/files/2023-04/sbom-types-document-508c.pdf>."
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Core/Bom",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class",
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A container for a grouping of SPDX 3 content characterizing details\n(provenance, composition, licensing, etc.) about a product."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://spdx.org/rdf/3/terms/Core/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Bom"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://spdx.org/rdf/3/terms/Core/Bundle"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A container for a grouping of SPDX 3 content characterizing details\n(provenance, composition, licensing, etc.) about a product."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "A Bill of Materials (BOM) is a container for a grouping of SPDX 3 content\ncharacterizing details about a product.\n\nThis could include details of the content and composition of the product,\nprovenance details of the product and/or\nits composition, licensing information, known quality or security issues, etc."
      }
    ],
    "http://www.w3.org/ns/shacl#nodeKind": [
      {
        "@id": "http://www.w3.org/ns/shacl#IRI"
      }
    ]
  },
