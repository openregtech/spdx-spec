    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "The manufacturing process encompasses the series of steps required to transform materials into finished goods. It is a fundamental operation across various industries, including automotive, electronics, pharmaceuticals, textiles, and food production."
      }
    ],
