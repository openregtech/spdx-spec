  {
    "@id": "https://spdx.org/rdf/3/terms/Security/VexVulnAssessmentRelationship",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class",
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Abstract ancestor class for all VEX relationships."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://spdx.org/rdf/3/terms/Security/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "VexVulnAssessmentRelationship"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://spdx.org/rdf/3/terms/Security/VulnAssessmentRelationship"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Abstract ancestor class for all VEX relationships."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "VexVulnAssessmentRelationship is an abstract subclass that defined the common\nproperties shared by all the SPDX-VEX status relationships.\n\n*Constraints*\n\nWhen linking elements using a VexVulnAssessmentRelationship, the following\nrequirements shall be observed:\n\n- The to: end shall point to elements representing the VEX *products*.\n\nTo specify a different element where the vulnerability was detected, the VEX\nrelationship can optionally specify *subcomponents* using the assessedElement\nproperty.\n\nVEX inherits information from the document level down to its statements. When a\nstatement is missing information it can be completed by reading the equivalent\nfield from the containing document. For example, if a VEX relationship is\nmissing data in its createdBy property, tools shall consider the entity\nlisted in the CreationInfo section of the document as the VEX author.\nIn the same way, when a VEX relationship does not have a created property,\nthe document's date shall be considered as authoritative."
      }
    ],
    "http://www.w3.org/ns/shacl#nodeKind": [
      {
        "@id": "http://www.w3.org/ns/shacl#IRI"
      }
    ],
